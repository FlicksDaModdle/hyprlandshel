// Software: what's installed, what can be, and what's out of date — from
// the Arch repositories, the AUR and Flathub.

import { Theme, Icons, Win, KitWindow, TitleBar, Sidebar, NavItem, Card, Caption, Label, Dim, Heading,
         Button, IconButton, Field, Scroll, Empty, Toast, Rule, Icon, Spinner, Dialog, KeyValue } from "@kit";

export { Theme, Icons, Win }

export struct PkgRow {
    key: string,
    name: string,
    // "Arch · extra", "AUR", "Flathub"
    source: string,
    version: string,
    // For an update: what it goes to.
    to-version: string,
    desc: string,
    installed: bool,
}

export struct Fact {
    key: string,
    value: string,
}

export global Soft {
    // 0 search, 1 installed, 2 updates
    in-out property <int> page: 1;
    in-out property <string> query;
    in property <[PkgRow]> rows;
    in property <bool> loading;
    in property <string> note;
    in property <int> installed-count;
    in property <int> update-count;
    // The one picked, on the right.
    in property <string> selected;
    in property <PkgRow> detail;
    in property <[Fact]> facts;
    in property <bool> facts-loading;
    // A change running: what, and its last line.
    in property <bool> busy;
    in property <string> busy-title;
    in property <string> busy-line;
    in property <string> log;
    in-out property <bool> log-open;
    // Asked before removing.
    in-out property <bool> confirm-remove;
    in property <string> toast;

    callback set-page(int);
    callback search(string);
    callback pick(string);
    callback install(string);
    callback remove(string);
    callback update-all();
    callback refresh();
}

component Row inherits Rectangle {
    in property <PkgRow> pkg;
    in property <bool> selected;
    callback clicked();
    height: 58px;
    border-radius: Theme.r-sm;
    background: selected ? Theme.sel : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.t(160); easing: spring(0); }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 9px;
                background: Theme.hover;
                Icon { name: root.pkg.source == "Flathub" ? "pkg" : "package"; size: 20px; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                Text { text: root.pkg.name; font-size: Theme.fs(13); font-weight: 600; color: Theme.ink; overflow: elide; }
                Text {
                    text: root.pkg.to-version != "" ? root.pkg.version + "  →  " + root.pkg.to-version : root.pkg.version;
                    font-size: Theme.fs(11.5);
                    color: Theme.ink3;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            Text { text: root.pkg.desc; font-size: Theme.fs(11.5); color: Theme.ink2; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                if root.pkg.installed: Rectangle {
                    width: it.preferred-width + 14px;
                    height: 20px;
                    border-radius: 10px;
                    background: Theme.ok.transparentize(0.8);
                    it := Text { text: "Installed"; font-size: Theme.fs(10.5); color: Theme.ok; }
                }
                Rectangle {
                    width: st.preferred-width + 14px;
                    height: 20px;
                    border-radius: 10px;
                    background: Theme.hover;
                    st := Text { text: root.pkg.source; font-size: Theme.fs(10.5); color: Theme.ink2; }
                }
            }
        }
    }
}

export component AppWindow inherits KitWindow {
    title: "Software";
    preferred-width: 1120px;
    preferred-height: 760px;

    VerticalLayout {
        TitleBar {
            app-name: "Software";
            app-icon: "package";
            Field {
                width: 360px;
                icon: "search";
                placeholder: "Search the repositories, the AUR and Flathub";
                text <=> Soft.query;
                edited(t) => { Soft.search(t); }
                accepted(t) => { Soft.search(t); }
                escape => { Soft.query = ""; Soft.search(""); }
            }
        }
        Rule {}
        HorizontalLayout {
            Sidebar {
                NavItem { icon: "search"; text: "Search"; selected: Soft.page == 0; clicked => { Soft.set-page(0); } }
                NavItem { icon: "package"; text: "Installed"; badge: Soft.installed-count > 0 ? Soft.installed-count : ""; selected: Soft.page == 1; clicked => { Soft.set-page(1); } }
                NavItem { icon: "download"; text: "Updates"; badge: Soft.update-count > 0 ? Soft.update-count : ""; selected: Soft.page == 2; clicked => { Soft.set-page(2); } }
                Rectangle { vertical-stretch: 1; }
                if Soft.page == 2 && Soft.update-count > 0: Button {
                    kind: "primary";
                    icon: "download";
                    text: "Update everything";
                    enabled: !Soft.busy;
                    clicked => { Soft.update-all(); }
                }
                Button { icon: "refresh"; text: "Check again"; enabled: !Soft.busy && !Soft.loading; clicked => { Soft.refresh(); } }
            }

            // The list.
            Rectangle {
                horizontal-stretch: 3;
                if Soft.loading && Soft.rows.length == 0: VerticalLayout { alignment: center; HorizontalLayout { alignment: center; Spinner {} } }
                if !Soft.loading && Soft.rows.length == 0: Empty {
                    icon: Soft.page == 2 ? "check" : "package";
                    title: Soft.page == 0 ? (Soft.query == "" ? "Search for software" : "Nothing found")
                         : Soft.page == 1 ? "Nothing listed" : "Everything's up to date";
                    text: Soft.note;
                }
                if Soft.rows.length > 0: VerticalLayout {
                    if Soft.note != "": HorizontalLayout {
                        padding: 10px;
                        padding-left: 16px;
                        padding-bottom: 0px;
                        Dim { text: Soft.note; font-size: Theme.fs(11.5); wrap: word-wrap; }
                    }
                    Scroll {
                        VerticalLayout {
                            padding: 8px;
                            padding-right: 14px;
                            spacing: 1px;
                            for r in Soft.rows: Row { pkg: r; selected: r.key == Soft.selected; clicked => { Soft.pick(r.key); } }
                        }
                    }
                }
            }

            // The one picked.
            if Soft.selected != "": Rectangle {
                width: 340px;
                Rectangle { x: 0; width: 1px; background: Theme.rule; }
                Scroll {
                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 12px;
                            Rectangle {
                                width: 48px;
                                height: 48px;
                                border-radius: 12px;
                                background: Theme.hover;
                                Icon { name: Soft.detail.source == "Flathub" ? "pkg" : "package"; size: 28px; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text { text: Soft.detail.name; font-size: Theme.fs(17); font-weight: 600; color: Theme.ink; wrap: word-wrap; }
                                Text { text: Soft.detail.source + "  ·  " + Soft.detail.version; font-size: Theme.fs(11.5); color: Theme.ink3; }
                            }
                        }
                        Text { text: Soft.detail.desc; font-size: Theme.fs(12.5); color: Theme.ink2; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            if !Soft.detail.installed: Button {
                                kind: "primary";
                                icon: "download";
                                text: Soft.detail.source == "AUR" ? "Install in Terminal" : "Install";
                                enabled: !Soft.busy;
                                clicked => { Soft.install(Soft.detail.key); }
                            }
                            if Soft.detail.installed && Soft.detail.to-version != "": Button {
                                kind: "primary";
                                icon: "download";
                                text: "Update";
                                enabled: !Soft.busy;
                                clicked => { Soft.install(Soft.detail.key); }
                            }
                            if Soft.detail.installed: Button {
                                kind: "danger";
                                icon: "trash";
                                text: "Remove";
                                enabled: !Soft.busy;
                                clicked => { Soft.confirm-remove = true; }
                            }
                        }
                        if Soft.detail.source == "AUR": Dim {
                            text: "AUR packages are built from scripts anyone can publish. The terminal shows the PKGBUILD before anything runs; read it.";
                            wrap: word-wrap;
                            font-size: Theme.fs(11.5);
                        }
                        Rule {}
                        if Soft.facts-loading: HorizontalLayout { alignment: center; Spinner {} }
                        for f in Soft.facts: VerticalLayout {
                            spacing: 2px;
                            Text { text: f.key; font-size: Theme.fs(10.5); color: Theme.ink3; }
                            Text { text: f.value; font-size: Theme.fs(12); color: Theme.ink; wrap: word-wrap; }
                        }
                    }
                }
            }
        }

        // A change running.
        if Soft.busy || Soft.log != "": Rule {}
        if Soft.busy || Soft.log != "": VerticalLayout {
            HorizontalLayout {
                height: 40px;
                padding-left: 14px;
                padding-right: 10px;
                spacing: 10px;
                if Soft.busy: VerticalLayout { alignment: center; Spinner {} }
                Text { text: Soft.busy-title; vertical-alignment: center; font-size: Theme.fs(12.5); font-weight: 600; color: Theme.ink; }
                Text { text: Soft.busy-line; vertical-alignment: center; font-size: Theme.fs(11.5); color: Theme.ink3; overflow: elide; horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Button { small: true; kind: "ghost"; text: Soft.log-open ? "Hide output" : "Show output"; clicked => { Soft.log-open = !Soft.log-open; } }
                }
            }
            if Soft.log-open: Rectangle {
                height: 200px;
                background: Theme.ground.transparentize(0.4);
                Scroll {
                    VerticalLayout {
                        padding: 12px;
                        Text { text: Soft.log; font-family: "monospace"; font-size: Theme.fs(11.5); color: Theme.ink2; wrap: word-wrap; }
                    }
                }
            }
        }
    }

    Dialog {
        open: Soft.confirm-remove;
        title: "Remove " + Soft.detail.name + "?";
        text: Soft.detail.source == "Flathub" ? "Its app goes; its data in ~/.var/app stays." : "What only it needed goes with it (pacman -Rns). Your files in your home folder stay.";
        dismissed => { Soft.confirm-remove = false; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Cancel"; clicked => { Soft.confirm-remove = false; } }
            Button { kind: "danger"; text: "Remove"; clicked => { Soft.confirm-remove = false; Soft.remove(Soft.detail.key); } }
        }
    }

    Toast { text: Soft.toast; }
}
