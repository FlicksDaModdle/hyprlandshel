// Chats: your WhatsApp conversations in the shell's own window.
// On the left the chats, newest first; on the right the one you're in, with
// what you're writing at its foot. Linking, when there's nothing linked yet,
// fills the window.

import { Theme, Icons, Win, KitWindow, TitleBar, Field, Scroll, Empty, Toast, Icon, IconButton, Button,
         Spinner, Dialog, Menu, MenuEntry, Card } from "@kit";

export { Theme, Icons, Win }

export struct ChatItem {
    jid: string,
    name: string,
    initials: string,
    tint: color,
    avatar: image,
    has-avatar: bool,
    time: string,
    preview: string,
    preview-icon: string,
    preview-who: string,
    // -2: not yours; else the status of your last message
    ticks: int,
    unread: int,
    muted: bool,
    pinned: bool,
    group: bool,
    typing: string,
    archived: bool,
}

export struct ReactionChip {
    emoji: string,
    count: int,
}

export struct Bubble {
    id: string,
    mine: bool,
    // text image sticker video gif voice audio document location contact poll deleted waiting unsupported
    kind: string,
    text: string,
    time: string,
    status: int,
    sender: string,
    sender-tint: color,
    // First of a run from one person: the name above it (in groups), a gap before it.
    first: bool,
    day: string,
    picture: image,
    has-picture: bool,
    pic-w: float,
    pic-h: float,
    file-name: string,
    file-sub: string,
    file-icon: string,
    // "", "loading" or "failed"
    media-state: string,
    media-note: string,
    has-quote: bool,
    quote-name: string,
    quote-text: string,
    quote-tint: color,
    reactions: [ReactionChip],
    // Only a few emoji, and no words: shown large, without a bubble.
    big-emoji: bool,
    edited: bool,
    wave: [float],
    seconds: string,
    playing: bool,
    progress: float,
}

export global Chats {
    // starting, pairing, connecting, online, offline, error, nodaemon
    in property <string> state: "starting";
    in property <string> error;
    in property <bool> demo;
    in property <string> me;
    in property <int> unread-total;

    // Linking.
    in property <image> qr;
    in property <bool> has-qr;
    in property <string> pair-code;
    in property <string> pair-note;
    in-out property <bool> by-phone;

    // The list.
    in property <[ChatItem]> chats;
    in property <int> archived-count;
    in-out property <bool> show-archived;
    in-out property <string> filter;

    // The chat that's open.
    in property <string> current;
    in property <string> current-name;
    in property <string> current-sub;
    in property <string> current-initials;
    in property <color> current-tint;
    in property <image> current-avatar;
    in property <bool> current-has-avatar;
    in property <bool> current-group;
    in property <[Bubble]> messages;
    in property <bool> more-above;
    in-out property <bool> stick: true;
    // Older messages are going in above: keep what's in view where it is.
    in-out property <bool> prepending;
    // Bumped to put the cursor in the message field.
    in-out property <int> focus-request;
    // Bumped to go down to the newest message.
    in property <int> bottom-request;

    // Writing.
    in-out property <string> draft;
    in property <bool> replying;
    in property <string> reply-name;
    in property <string> reply-text;
    in property <color> reply-tint;
    in property <bool> recording;
    in property <string> rec-time;
    in property <[float]> rec-levels;
    in property <bool> sending-file;

    in property <string> toast;
    in property <bool> toast-bad;

    callback pair(string);
    callback retry();
    callback open(string);
    callback send();
    callback edited(string);
    callback attach();
    callback record();
    callback stop-recording(bool);
    callback reply(string);
    callback cancel-reply();
    callback react(string, string);
    callback open-media(string);
    callback save-media(string);
    callback play(string);
    callback copy(string);
    callback delete(string);
    callback older();
    callback new-chat(string);
    callback unlink();
}

// ── small pieces ─────────────────────────────────────────────────────────

component Avatar inherits Rectangle {
    in property <image> picture;
    in property <bool> has-picture;
    in property <string> initials;
    in property <color> tint;
    in property <bool> group;
    in property <length> size: 44px;
    width: size;
    height: size;
    border-radius: size / 2;
    clip: true;
    background: has-picture ? Theme.sel : tint.transparentize(0.72);
    if root.has-picture: Image {
        width: parent.width;
        height: parent.height;
        source: root.picture;
        image-fit: cover;
    }
    if !root.has-picture && root.initials != "": Text {
        text: root.initials;
        color: root.tint.mix(Theme.ink, 0.55);
        font-size: root.size * 0.36;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if !root.has-picture && root.initials == "": Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.group ? "users" : "user";
        size: root.size * 0.46;
        ink: root.tint.mix(Theme.ink, 0.55);
    }
}

// Sent, delivered, read: one tick, two, two in the accent.
component Ticks inherits Rectangle {
    in property <int> status;
    in property <color> ink: Theme.ink3;
    width: status >= 2 ? 18px : 13px;
    height: 13px;
    if root.status == -1: Icon { name: "alert"; size: 13px; ink: Theme.danger; }
    if root.status == 0: Icon { name: "clock"; size: 12px; y: 0.5px; ink: root.ink; }
    if root.status == 1: Icon { name: "check"; size: 13px; ink: root.ink; }
    if root.status >= 2: Icon { x: 0; name: "check"; size: 13px; ink: root.status >= 3 ? Theme.accent : root.ink; }
    if root.status >= 2: Icon { x: 5px; name: "check"; size: 13px; ink: root.status >= 3 ? Theme.accent : root.ink; }
}

component ChatRow inherits Rectangle {
    in property <ChatItem> item;
    in property <bool> selected;
    callback clicked();
    height: 66px;
    border-radius: Theme.r-sm;
    background: selected ? Theme.sel : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.t(160); easing: spring(0); }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Avatar {
                picture: root.item.avatar;
                has-picture: root.item.has-avatar;
                initials: root.item.initials;
                tint: root.item.tint;
                group: root.item.group;
                size: 44px;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.item.name;
                    horizontal-stretch: 1;
                    overflow: elide;
                    color: Theme.ink;
                    font-size: Theme.fs(13.5);
                    font-weight: root.item.unread > 0 ? 700 : 600;
                }
                Text {
                    text: root.item.time;
                    color: root.item.unread > 0 && !root.item.muted ? Theme.accent : Theme.ink3;
                    font-size: Theme.fs(11);
                    font-weight: root.item.unread > 0 ? 600 : 400;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 5px;
                if root.item.typing == "" && root.item.ticks > -2: VerticalLayout {
                    alignment: center;
                    Ticks { status: root.item.ticks; }
                }
                if root.item.typing == "" && root.item.preview-icon != "": VerticalLayout {
                    alignment: center;
                    Icon { name: root.item.preview-icon; size: 14px; ink: Theme.ink3; }
                }
                Text {
                    text: root.item.typing != "" ? root.item.typing
                        : root.item.preview-who != "" ? root.item.preview-who + ": " + root.item.preview
                        : root.item.preview;
                    horizontal-stretch: 1;
                    overflow: elide;
                    color: root.item.typing != "" ? Theme.accent : root.item.unread > 0 ? Theme.ink2 : Theme.ink3;
                    font-size: Theme.fs(12.5);
                    vertical-alignment: center;
                }
                if root.item.muted: VerticalLayout {
                    alignment: center;
                    Icon { name: "bellOff"; size: 14px; ink: Theme.ink3; }
                }
                if root.item.pinned && root.item.unread == 0: VerticalLayout {
                    alignment: center;
                    Icon { name: "pin"; size: 14px; ink: Theme.ink3; }
                }
                if root.item.unread > 0: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 19px;
                        width: max(19px, n.preferred-width + 11px);
                        border-radius: 9.5px;
                        background: root.item.muted ? Theme.ink3 : Theme.accent;
                        n := Text {
                            text: root.item.unread > 999 ? "999+" : root.item.unread;
                            color: Theme.ink-on-accent;
                            font-size: Theme.fs(11);
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The bars of a voice message, played part in the accent.
component Wave inherits Rectangle {
    in property <[float]> values;
    in property <float> progress;
    in property <color> ink: Theme.ink3;
    callback seek(float);
    height: 30px;
    property <length> pitch: values.length > 0 ? self.width / values.length : 4px;
    for v[i] in root.values: Rectangle {
        x: i * root.pitch + (root.pitch - self.width) / 2;
        width: max(2px, root.pitch * 0.55);
        height: max(3px, v * root.height);
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: (i + 0.5) / root.values.length <= root.progress ? Theme.accent : root.ink;
    }
}

component DayChip inherits HorizontalLayout {
    in property <string> text;
    alignment: center;
    padding-top: 10px;
    padding-bottom: 8px;
    Rectangle {
        height: 24px;
        width: t.preferred-width + 22px;
        border-radius: 12px;
        background: Theme.dark ? Theme.surface : #ffffff;
        border-width: 1px;
        border-color: Theme.rule;
        t := Text {
            text: root.text;
            color: Theme.ink2;
            font-size: Theme.fs(11.5);
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component BubbleView inherits VerticalLayout {
    in property <Bubble> b;
    in property <bool> group;
    in property <length> max-w;
    callback menu(string, length, length);
    callback open-media(string);
    callback play(string);

    property <color> mine-bg: Theme.dark ? Theme.accent.mix(Theme.ground, 0.30) : Theme.accent.mix(#ffffff, 0.15);
    property <color> theirs-bg: Theme.dark ? Theme.surface : #ffffff;
    property <bool> pictured: b.has-picture && (b.kind == "image" || b.kind == "sticker" || b.kind == "video" || b.kind == "gif");
    property <bool> sticker: b.kind == "sticker";
    property <bool> filed: b.kind == "document" || b.kind == "audio" || ((b.kind == "video" || b.kind == "gif") && !b.has-picture);
    property <bool> voiced: b.kind == "voice";
    property <bool> notice: b.kind == "deleted" || b.kind == "waiting" || b.kind == "unsupported";
    property <length> pic-w: min(b.pic-w * 1px, root.max-w - 8px);
    property <length> pic-h: b.pic-w > 0 ? self.pic-w * b.pic-h / b.pic-w : 0px;

    padding-top: b.first ? 6px : 1px;
    if b.day != "": DayChip { text: b.day; }
    HorizontalLayout {
        alignment: b.mine ? end : start;
        padding-left: b.mine ? 60px : 0px;
        padding-right: b.mine ? 0px : 60px;
        VerticalLayout {
            spacing: 0px;
            bubble := Rectangle {
                max-width: root.max-w;
                height: lay.preferred-height;
                background: root.sticker || b.big-emoji ? transparent : b.mine ? root.mine-bg : root.theirs-bg;
                border-radius: Theme.r-sm + 3px;
                drop-shadow-blur: root.sticker || b.big-emoji || Theme.dark ? 0px : 2px;
                drop-shadow-color: #0000001a;
                drop-shadow-offset-y: 1px;
                TouchArea {
                    // Right-click (or a double-click) for what can be done with it.
                    // Under the content, so the play button and pictures get
                    // their own clicks.
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                            root.menu(b.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                    double-clicked => {
                        root.menu(b.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
                lay := VerticalLayout {
                    padding: root.pictured && b.text == "" && !b.has-quote ? 4px : 8px;
                    padding-top: root.pictured && !b.has-quote && !(root.group && !b.mine && b.first) ? 4px : 7px;
                    padding-bottom: 6px;
                    spacing: 5px;
                    if root.group && !b.mine && b.first && !root.sticker: Text {
                        text: b.sender;
                        color: b.sender-tint;
                        font-size: Theme.fs(12);
                        font-weight: 700;
                        overflow: elide;
                    }
                    if b.has-quote: Rectangle {
                        background: Theme.dark ? #00000033 : #0000000d;
                        border-radius: Theme.r-sm - 2px;
                        clip: true;
                        min-width: 160px;
                        HorizontalLayout {
                            Rectangle { width: 3px; background: b.quote-tint; }
                            VerticalLayout {
                                padding: 7px;
                                padding-left: 9px;
                                spacing: 2px;
                                Text {
                                    text: b.quote-name;
                                    color: b.quote-tint;
                                    font-size: Theme.fs(12);
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: b.quote-text;
                                    color: Theme.ink2;
                                    font-size: Theme.fs(12.5);
                                    overflow: elide;
                                }
                            }
                        }
                    }
                    if root.pictured: Rectangle {
                        width: root.pic-w;
                        height: root.pic-h;
                        border-radius: Theme.r-sm;
                        clip: true;
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: b.picture;
                            image-fit: cover;
                        }
                        if b.kind == "video" || b.kind == "gif": Rectangle {
                            width: 50px;
                            height: 50px;
                            border-radius: 25px;
                            background: #00000088;
                            Icon { name: "play"; size: 22px; ink: #ffffff; acc: #ffffff; }
                        }
                        if b.media-state == "loading": Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 22px;
                            background: #00000088;
                            Spinner {}
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-media(b.id); }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                    root.menu(b.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                    }
                    if root.filed: Rectangle {
                        height: 54px;
                        min-width: 230px;
                        border-radius: Theme.r-sm - 2px;
                        background: Theme.dark ? #00000033 : #0000000d;
                        HorizontalLayout {
                            padding: 8px;
                            spacing: 10px;
                            Rectangle {
                                width: 38px;
                                border-radius: Theme.r-sm - 2px;
                                background: Theme.accent.transparentize(0.82);
                                Icon { name: b.file-icon; size: 19px; ink: Theme.accent; }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: b.file-name;
                                    color: Theme.ink;
                                    font-size: Theme.fs(12.5);
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: b.media-state == "failed" ? b.media-note : b.file-sub;
                                    color: b.media-state == "failed" ? Theme.danger : Theme.ink3;
                                    font-size: Theme.fs(11.5);
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                if b.media-state == "loading": Spinner {}
                                if b.media-state != "loading": Icon {
                                    name: b.file-icon == "play" ? "play" : "download";
                                    size: 17px;
                                    ink: Theme.ink2;
                                }
                            }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-media(b.id); }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                    root.menu(b.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                    }
                    if root.voiced: HorizontalLayout {
                        spacing: 10px;
                        min-width: 250px;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 18px;
                            background: Theme.accent;
                            if b.media-state == "loading": Spinner {}
                            if b.media-state != "loading": Icon {
                                x: (parent.width - self.width) / 2 + (b.playing ? 0px : 1px);
                                y: (parent.height - self.height) / 2;
                                name: b.playing ? "pause" : "play";
                                size: 16px;
                                ink: Theme.ink-on-accent;
                                acc: Theme.ink-on-accent;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.play(b.id); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Wave {
                                values: b.wave;
                                progress: b.progress;
                            }
                            Text {
                                text: b.media-state == "failed" ? b.media-note : b.seconds;
                                color: b.media-state == "failed" ? Theme.danger : Theme.ink3;
                                font-size: Theme.fs(11);
                            }
                        }
                    }
                    if root.notice: HorizontalLayout {
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: b.kind == "deleted" ? "x" : b.kind == "waiting" ? "clock" : "info";
                                size: 14px;
                                ink: Theme.ink3;
                            }
                        }
                        Text {
                            text: b.kind == "deleted" ? (b.mine ? "You deleted this message" : "This message was deleted")
                                : b.kind == "waiting" ? "Waiting for this message. It can take a while."
                                : "This kind of message isn't shown here yet. See it on your phone.";
                            color: Theme.ink3;
                            font-size: Theme.fs(13);
                            font-italic: true;
                            wrap: word-wrap;
                        }
                    }
                    if b.text != "" && !root.notice && !b.big-emoji: Text {
                        text: b.text;
                        color: Theme.ink;
                        font-size: Theme.fs(13.5);
                        wrap: word-wrap;
                    }
                    if b.big-emoji: Text {
                        text: b.text;
                        font-family: "Noto Color Emoji";
                        font-size: 40px;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 4px;
                        if b.edited: Text {
                            text: "edited";
                            color: Theme.ink3;
                            font-size: Theme.fs(10.5);
                            font-italic: true;
                        }
                        Text {
                            text: b.time;
                            color: Theme.ink3;
                            font-size: Theme.fs(10.5);
                        }
                        if b.mine && b.kind != "deleted": VerticalLayout {
                            alignment: center;
                            Ticks { status: b.status; }
                        }
                    }
                }
            }
            if b.reactions.length > 0: HorizontalLayout {
                alignment: b.mine ? end : start;
                padding-left: 8px;
                padding-right: 8px;
                Rectangle {
                    y: -4px;
                    height: 24px;
                    width: rl.preferred-width + 14px;
                    border-radius: 12px;
                    background: Theme.dark ? Theme.dialog : #ffffff;
                    border-width: 1px;
                    border-color: Theme.edge;
                    rl := HorizontalLayout {
                        x: 7px;
                        spacing: 6px;
                        for r in b.reactions: HorizontalLayout {
                            spacing: 2px;
                            Text {
                                text: r.emoji;
                                font-family: "Noto Color Emoji";
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                            if r.count > 1: Text {
                                text: r.count;
                                font-size: Theme.fs(11.5);
                                color: Theme.ink2;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

// Quick reactions and what else a message offers, by the pointer.
component MessageMenu inherits PopupWindow {
    in property <bool> mine;
    in property <bool> has-media;
    in property <bool> has-text;
    in property <bool> can-delete;
    callback react(string);
    callback reply();
    callback copy();
    callback open();
    callback save();
    callback delete();
    width: 236px;
    Rectangle {
        background: Theme.dialog;
        border-radius: Theme.r-sm + 3px;
        border-width: 1px;
        border-color: Theme.edge;
        drop-shadow-blur: 18px;
        drop-shadow-color: #00000059;
        drop-shadow-offset-y: 6px;
        VerticalLayout {
            padding: 5px;
            spacing: 1px;
            HorizontalLayout {
                padding: 2px;
                padding-bottom: 4px;
                spacing: 1px;
                for e in ["👍", "❤️", "😂", "😮", "😢", "🙏"]: Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: et.has-hover ? Theme.hover : transparent;
                    Text {
                        text: e;
                        font-family: "Noto Color Emoji";
                        font-size: 20px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    et := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.react(e); root.close(); }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.rule; }
            for e[i] in [
                { text: "Reply", icon: "reply", show: true, danger: false },
                { text: "Copy text", icon: "copy", show: root.has-text, danger: false },
                { text: "Open", icon: "image", show: root.has-media, danger: false },
                { text: "Save to Downloads", icon: "download", show: root.has-media, danger: false },
                { text: "Delete for everyone", icon: "trash", show: root.can-delete, danger: true },
            ]: Rectangle {
                visible: e.show;
                height: e.show ? 30px : 0px;
                border-radius: Theme.r-sm - 2px;
                background: mt.has-hover ? (e.danger ? Theme.danger.transparentize(0.82) : Theme.hover) : transparent;
                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 10px;
                    spacing: 9px;
                    VerticalLayout {
                        alignment: center;
                        Icon { name: e.icon; size: 15px; ink: e.danger ? Theme.danger : Theme.ink2; }
                    }
                    Text {
                        text: e.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        color: e.danger ? Theme.danger : Theme.ink;
                        font-size: Theme.fs(12.5);
                    }
                }
                mt := TouchArea {
                    clicked => {
                        if (i == 0) { root.reply(); }
                        if (i == 1) { root.copy(); }
                        if (i == 2) { root.open(); }
                        if (i == 3) { root.save(); }
                        if (i == 4) { root.delete(); }
                        root.close();
                    }
                }
            }
        }
    }
}

// ── linking ──────────────────────────────────────────────────────────────

component PairView inherits Rectangle {
    property <string> phone;
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            alignment: center;
            Card {
                max-width: 760px;
                preferred-width: 760px;
                horizontal-stretch: 1;
                background: Theme.dark ? Theme.surface.transparentize(0.3) : #ffffffcc;
                HorizontalLayout {
                    padding: 34px;
                    spacing: 36px;
                    VerticalLayout {
                        spacing: 16px;
                        horizontal-stretch: 1;
                        alignment: start;
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Rectangle { width: 3px; height: 20px; border-radius: 2px; background: Theme.accent; y: 4px; }
                            Text {
                                text: "Link Chats to your WhatsApp";
                                color: Theme.ink;
                                font-size: Theme.fs(20);
                                font-weight: 700;
                                wrap: word-wrap;
                            }
                        }
                        for s[i] in Chats.by-phone ? [
                            "Open WhatsApp on your phone.",
                            "Go to Settings → Linked devices → Link a device.",
                            "Tap \"Link with phone number instead\" and type the code shown here.",
                        ] : [
                            "Open WhatsApp on your phone.",
                            "Go to Settings → Linked devices → Link a device.",
                            "Point your phone at this code.",
                        ]: HorizontalLayout {
                            spacing: 12px;
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 12px;
                                background: Theme.accent.transparentize(0.82);
                                Text {
                                    text: i + 1;
                                    color: Theme.accent;
                                    font-size: Theme.fs(12);
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: s;
                                color: Theme.ink2;
                                font-size: Theme.fs(13.5);
                                wrap: word-wrap;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                        if Chats.error != "": Text {
                            text: Chats.error;
                            color: Theme.danger;
                            font-size: Theme.fs(12.5);
                            wrap: word-wrap;
                        }
                        Rectangle { height: 4px; }
                        if !Chats.by-phone: HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Link with a phone number instead";
                                icon: "keyboard";
                                kind: "ghost";
                                clicked => { Chats.by-phone = true; }
                            }
                        }
                        if Chats.by-phone: VerticalLayout {
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 8px;
                                f := Field {
                                    placeholder: "Your number, with the country code";
                                    icon: "hash";
                                    edited(t) => { root.phone = t; }
                                    accepted(t) => { Chats.pair(t); }
                                }
                                Button {
                                    text: "Get code";
                                    kind: "primary";
                                    enabled: root.phone != "";
                                    clicked => { Chats.pair(root.phone); }
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: "Use the QR code instead";
                                    kind: "ghost";
                                    small: true;
                                    clicked => { Chats.by-phone = false; Chats.retry(); }
                                }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                        Text {
                            text: Chats.demo ? "Demo: made-up chats, nothing is linked."
                                : "Chats is a linked device, like WhatsApp Web, and isn't made by WhatsApp. Your messages stay end-to-end encrypted.";
                            color: Theme.ink3;
                            font-size: Theme.fs(11.5);
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 272px;
                            height: 272px;
                            border-radius: Theme.r;
                            background: !Chats.by-phone && Chats.has-qr ? #ffffff : Theme.hover;
                            border-width: 1px;
                            border-color: Theme.rule;
                            if !Chats.by-phone && Chats.has-qr: Image {
                                width: 240px;
                                height: 240px;
                                source: Chats.qr;
                                image-rendering: pixelated;
                            }
                            if !Chats.by-phone && Chats.has-qr: Rectangle {
                                width: 46px;
                                height: 46px;
                                border-radius: 12px;
                                background: #ffffff;
                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    border-radius: 10px;
                                    background: Theme.accent;
                                    Icon { name: "chat"; size: 22px; ink: #ffffff; acc: #ffffff; }
                                }
                            }
                            if Chats.by-phone && Chats.pair-code != "": VerticalLayout {
                                alignment: center;
                                spacing: 10px;
                                Text {
                                    text: "Your code";
                                    color: Theme.ink3;
                                    font-size: Theme.fs(12);
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: Chats.pair-code;
                                    color: Theme.ink;
                                    font-size: Theme.fs(28);
                                    font-weight: 700;
                                    letter-spacing: 3px;
                                    font-family: "monospace";
                                    horizontal-alignment: center;
                                }
                            }
                            if Chats.by-phone && Chats.pair-code == "": Text {
                                text: Chats.pair-note != "" ? Chats.pair-note : "Your code shows here";
                                color: Theme.ink3;
                                font-size: Theme.fs(12.5);
                                horizontal-alignment: center;
                                wrap: word-wrap;
                                width: parent.width - 40px;
                            }
                            if !Chats.by-phone && !Chats.has-qr: VerticalLayout {
                                alignment: center;
                                spacing: 12px;
                                if Chats.error == "": HorizontalLayout { alignment: center; Spinner {} }
                                if Chats.error == "": Text {
                                    text: "Getting a code…";
                                    color: Theme.ink3;
                                    font-size: Theme.fs(12.5);
                                    horizontal-alignment: center;
                                }
                                if Chats.error != "": HorizontalLayout {
                                    alignment: center;
                                    Button { text: "Try again"; icon: "refresh"; kind: "primary"; clicked => { Chats.retry(); } }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// What you're writing: grows with it up to a few lines; Enter sends,
// Shift+Enter starts a new line.
component Composer inherits Rectangle {
    out property <bool> has-focus: input.has-focus;
    public function focus-input() { input.focus(); }
    property <int> req: Chats.focus-request;
    changed req => { input.focus(); }
    init => { input.focus(); }
    property <length> line: Theme.fs(13.5) * 1.35;
    preferred-height: max(36px, input.preferred-height + 16px);
    clip: true;
    f := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: max(self.height, input.preferred-height + 16px);
        input := TextInput {
            y: 8px;
            width: parent.width;
            height: max(self.preferred-height, f.height - 16px);
            text <=> Chats.draft;
            single-line: false;
            wrap: word-wrap;
            color: Theme.ink;
            selection-background-color: Theme.accent.transparentize(0.6);
            font-size: Theme.fs(13.5);
            vertical-alignment: center;
            edited => { Chats.edited(self.text); }
            key-pressed(e) => {
                if (e.text == Key.Return && !e.modifiers.shift) {
                    if (Chats.draft != "") { Chats.send(); }
                    return accept;
                }
                if (e.text == Key.Escape && Chats.replying) {
                    Chats.cancel-reply();
                    return accept;
                }
                reject
            }
            cursor-position-changed(c) => {
                if (c.y + 8px + f.content-y < 0px) {
                    f.content-y = -c.y;
                } else if (c.y + root.line + 8px + f.content-y > f.height) {
                    f.content-y = f.height - c.y - root.line - 8px;
                }
            }
        }
    }
    if Chats.draft == "": Text {
        x: 0;
        y: (parent.height - self.height) / 2;
        text: Chats.current-group ? "Message the group" : "Message " + Chats.current-name;
        color: Theme.ink3;
        font-size: Theme.fs(13.5);
        overflow: elide;
        width: parent.width;
    }
}

// ── the window ───────────────────────────────────────────────────────────

export component AppWindow inherits KitWindow {
    title: Chats.unread-total > 0 ? "Chats (" + Chats.unread-total + ")" : "Chats";
    preferred-width: 1120px;
    preferred-height: 760px;
    min-width: 700px;
    min-height: 480px;

    property <string> menu-id;
    property <length> menu-x;
    property <length> menu-y;
    property <bool> menu-mine;
    property <bool> menu-media;
    property <bool> menu-text;
    property <bool> menu-delete;
    property <string> new-phone;
    property <bool> new-open;
    property <bool> unlink-open;

    callback menu-for(string) -> [bool];
    callback focus-composer();
    focus-composer => { Chats.focus-request += 1; }


    VerticalLayout {
        TitleBar {
            app-name: "Chats";
            app-icon: "chat";
            subtitle: Chats.state == "connecting" ? "Connecting…"
                : Chats.state == "offline" ? "Offline — reconnecting"
                : Chats.state == "starting" ? "Starting…"
                : Chats.demo ? "Demo" : "";
        }
        if Chats.state == "pairing": PairView { vertical-stretch: 1; }
        if Chats.state == "nodaemon": Empty {
            vertical-stretch: 1;
            icon: "alert";
            title: "Chats' service isn't running";
            text: Chats.error != "" ? Chats.error : "hyprshell-chatsd couldn't be started. Run apps/install.sh --only chats again.";
        }
        if Chats.state != "pairing" && Chats.state != "nodaemon": HorizontalLayout {
            vertical-stretch: 1;
            // The chats.
            Rectangle {
                width: 340px;
                Rectangle { x: parent.width - 1px; width: 1px; background: Theme.rule; }
                VerticalLayout {
                    padding: 10px;
                    padding-top: 6px;
                    padding-right: 11px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 6px;
                        Field {
                            icon: "search";
                            placeholder: "Search chats";
                            text: Chats.filter;
                            edited(t) => { Chats.filter = t; }
                        }
                        IconButton { icon: "plus"; size: 34px; glyph: 17px; tip: "New chat"; clicked => { root.new-open = true; } }
                        more := IconButton { icon: "moreHorizontal"; size: 34px; glyph: 17px; clicked => { more-menu.show(); } }
                    }
                    if Chats.state == "error" && Chats.error != "": Rectangle {
                        border-radius: Theme.r-sm;
                        background: Theme.danger.transparentize(0.86);
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 8px;
                            Icon { name: "alert"; size: 16px; ink: Theme.danger; }
                            Text {
                                text: Chats.error;
                                color: Theme.ink;
                                font-size: Theme.fs(12);
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    if Chats.archived-count > 0 && Chats.filter == "": Rectangle {
                        height: 38px;
                        border-radius: Theme.r-sm;
                        background: at.has-hover ? Theme.hover : transparent;
                        HorizontalLayout {
                            padding-left: 22px;
                            padding-right: 12px;
                            spacing: 22px;
                            VerticalLayout {
                                alignment: center;
                                Icon { name: Chats.show-archived ? "chevronLeft" : "archive"; size: 17px; ink: Theme.ink2; }
                            }
                            Text {
                                text: Chats.show-archived ? "Back to chats" : "Archived";
                                color: Theme.ink;
                                font-size: Theme.fs(13);
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            if !Chats.show-archived: Text {
                                text: Chats.archived-count;
                                color: Theme.ink3;
                                font-size: Theme.fs(12);
                                vertical-alignment: center;
                            }
                        }
                        at := TouchArea { mouse-cursor: pointer; clicked => { Chats.show-archived = !Chats.show-archived; } }
                    }
                    Scroll {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 1px;
                            for c in Chats.chats: ChatRow {
                                item: c;
                                selected: c.jid == Chats.current;
                                clicked => { Chats.open(c.jid); }
                            }
                        }
                    }
                    if Chats.chats.length == 0: Text {
                        text: Chats.filter != "" ? "No chats match." : Chats.state == "connecting" ? "Your chats arrive from your phone in a moment…" : "No chats yet.";
                        color: Theme.ink3;
                        font-size: Theme.fs(12.5);
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
            // The conversation. Sized by the window, not by what's in it
            // (the bubbles are sized by it).
            Rectangle {
                horizontal-stretch: 1;
                min-width: 340px;
                preferred-width: 700px;
                max-width: 100000px;
                if Chats.current == "": Empty {
                    width: parent.width;
                    height: parent.height;
                    icon: "chat";
                    title: "Pick a chat";
                    text: "Your messages are end-to-end encrypted.";
                }
                if Chats.current != "": VerticalLayout {
                    // Who.
                    Rectangle {
                        height: 58px;
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.rule; }
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Avatar {
                                    picture: Chats.current-avatar;
                                    has-picture: Chats.current-has-avatar;
                                    initials: Chats.current-initials;
                                    tint: Chats.current-tint;
                                    group: Chats.current-group;
                                    size: 38px;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                horizontal-stretch: 1;
                                Text {
                                    text: Chats.current-name;
                                    color: Theme.ink;
                                    font-size: Theme.fs(14.5);
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                if Chats.current-sub != "": Text {
                                    text: Chats.current-sub;
                                    color: Chats.current-sub == "typing…" || Chats.current-sub == "recording audio…" ? Theme.accent : Theme.ink3;
                                    font-size: Theme.fs(12);
                                    overflow: elide;
                                }
                            }
                        }
                    }
                    // What was said.
                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        scroller := Scroll {
                            width: parent.width;
                            height: parent.height;
                            property <length> last-h;
                            property <int> bottom: Chats.bottom-request;
                            changed bottom => {
                                Chats.stick = true;
                                self.viewport-y = min(0px, self.height - self.viewport-height);
                            }
                            msgs := VerticalLayout {
                                // A short conversation sits at the foot, by the field
                                // (the layout fills the scroll area, which is at
                                // least as tall as the view).
                                alignment: end;
                                padding-left: 22px;
                                padding-right: 22px;
                                padding-top: 10px;
                                padding-bottom: 14px;
                                spacing: 1px;
                                if Chats.more-above: HorizontalLayout {
                                    alignment: center;
                                    padding-bottom: 6px;
                                    Button {
                                        text: "Earlier messages";
                                        icon: "chevronUp";
                                        kind: "ghost";
                                        small: true;
                                        clicked => { Chats.older(); }
                                    }
                                }
                                for b in Chats.messages: BubbleView {
                                    b: b;
                                    group: Chats.current-group;
                                    max-w: min(560px, (scroller.width - 44px) * 0.74);
                                    menu(id, x, y) => {
                                        let flags = root.menu-for(id);
                                        root.menu-id = id;
                                        root.menu-mine = flags[0];
                                        root.menu-media = flags[1];
                                        root.menu-text = flags[2];
                                        root.menu-delete = flags[3];
                                        root.menu-x = min(x, root.width - 246px);
                                        root.menu-y = min(y, root.height - 260px);
                                        msg-menu.show();
                                    }
                                    open-media(id) => { Chats.open-media(id); }
                                    play(id) => { Chats.play(id); }
                                }
                            }
                            changed viewport-height => {
                                if (Chats.stick) {
                                    self.viewport-y = min(0px, self.height - self.viewport-height);
                                } else if (Chats.prepending) {
                                    self.viewport-y = self.viewport-y - (self.viewport-height - self.last-h);
                                    Chats.prepending = false;
                                }
                                self.last-h = self.viewport-height;
                            }
                            changed viewport-y => {
                                Chats.stick = self.viewport-y <= self.height - self.viewport-height + 60px;
                            }
                            changed height => {
                                if (Chats.stick) { self.viewport-y = min(0px, self.height - self.viewport-height); }
                            }
                        }
                        // Down to the newest, when you've scrolled up.
                        if !Chats.stick: Rectangle {
                            x: parent.width - 58px;
                            y: parent.height - 58px;
                            width: 40px;
                            height: 40px;
                            border-radius: 20px;
                            background: Theme.dialog;
                            border-width: 1px;
                            border-color: Theme.edge;
                            drop-shadow-blur: 10px;
                            drop-shadow-color: #00000040;
                            Icon { name: "chevronDown"; size: 18px; ink: Theme.ink2; }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    Chats.stick = true;
                                    scroller.viewport-y = min(0px, scroller.height - scroller.viewport-height);
                                }
                            }
                        }
                    }
                    // Replying to.
                    if Chats.replying: Rectangle {
                        height: 52px;
                        background: Theme.hover;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 10px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            spacing: 10px;
                            Rectangle { width: 3px; border-radius: 2px; background: Chats.reply-tint; }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 1px;
                                Text {
                                    text: Chats.reply-name;
                                    color: Chats.reply-tint;
                                    font-size: Theme.fs(12);
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: Chats.reply-text;
                                    color: Theme.ink2;
                                    font-size: Theme.fs(12.5);
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton { icon: "x"; size: 28px; glyph: 15px; clicked => { Chats.cancel-reply(); } }
                            }
                        }
                    }
                    // Writing.
                    Rectangle {
                        height: Chats.recording ? 60px : max(60px, min(160px, composer.preferred-height + 26px));
                        Rectangle { height: 1px; y: 0; background: Theme.rule; }
                        HorizontalLayout {
                            visible: !Chats.recording;
                            padding: 10px;
                            padding-left: 12px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: end;
                                IconButton {
                                    icon: "paperclip";
                                    size: 38px;
                                    glyph: 18px;
                                    enabled: !Chats.sending-file;
                                    clicked => { Chats.attach(); }
                                }
                            }
                            Rectangle {
                                border-radius: 19px;
                                background: Theme.hover;
                                border-width: 1px;
                                border-color: composer.has-focus ? Theme.accent.transparentize(0.4) : Theme.rule;
                                composer := Composer {
                                    x: 14px;
                                    y: 0;
                                    width: parent.width - 28px;
                                    height: parent.height;
                                }
                            }
                            VerticalLayout {
                                alignment: end;
                                Rectangle {
                                    width: 38px;
                                    height: 38px;
                                    border-radius: 19px;
                                    background: Chats.draft != "" ? Theme.accent : sa.has-hover ? Theme.sel : Theme.hover;
                                    animate background { duration: Theme.t(160); easing: spring(0); }
                                    Icon {
                                        x: (parent.width - self.width) / 2 + (Chats.draft != "" ? 1px : 0px);
                                        y: (parent.height - self.height) / 2;
                                        name: Chats.draft != "" ? "send" : "mic";
                                        size: 18px;
                                        ink: Chats.draft != "" ? Theme.ink-on-accent : Theme.ink2;
                                        acc: Chats.draft != "" ? Theme.ink-on-accent : Theme.accent;
                                    }
                                    sa := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (Chats.draft != "") { Chats.send(); } else { Chats.record(); }
                                        }
                                    }
                                }
                            }
                        }
                        if Chats.recording: HorizontalLayout {
                            padding: 10px;
                            padding-left: 12px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                IconButton { icon: "trash"; size: 38px; glyph: 18px; danger: true; clicked => { Chats.stop-recording(false); } }
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: Theme.danger;
                                    opacity: mod(animation-tick() / 1s, 1) < 0.6 ? 1 : 0.35;
                                }
                            }
                            Text {
                                text: Chats.rec-time;
                                color: Theme.ink;
                                font-size: Theme.fs(14);
                                font-weight: 600;
                                vertical-alignment: center;
                                min-width: 46px;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                Wave { width: parent.width; y: (parent.height - self.height) / 2; values: Chats.rec-levels; progress: 1; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 38px;
                                    height: 38px;
                                    border-radius: 19px;
                                    background: Theme.accent;
                                    Icon { x: (parent.width - self.width) / 2 + 1px; y: (parent.height - self.height) / 2; name: "send"; size: 18px; ink: Theme.ink-on-accent; acc: Theme.ink-on-accent; }
                                    TouchArea { mouse-cursor: pointer; clicked => { Chats.stop-recording(true); } }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    msg-menu := MessageMenu {
        x: root.menu-x;
        y: root.menu-y;
        mine: root.menu-mine;
        has-media: root.menu-media;
        has-text: root.menu-text;
        can-delete: root.menu-delete;
        react(e) => { Chats.react(root.menu-id, e); }
        reply() => { Chats.reply(root.menu-id); root.focus-composer(); }
        copy() => { Chats.copy(root.menu-id); }
        open() => { Chats.open-media(root.menu-id); }
        save() => { Chats.save-media(root.menu-id); }
        delete() => { Chats.delete(root.menu-id); }
    }

    more-menu := Menu {
        x: root.width - 340px + 120px;
        y: 96px;
        entries: [
            { text: "New chat", icon: "plus" },
            { text: Chats.show-archived ? "Back to chats" : "Archived chats", icon: "archive", disabled: Chats.archived-count == 0 && !Chats.show-archived },
            { text: "Unlink this computer", icon: "logOut", danger: true, rule: true },
        ];
        chosen(i) => {
            if (i == 0) { root.new-open = true; }
            if (i == 1) { Chats.show-archived = !Chats.show-archived; }
            if (i == 2) { root.unlink-open = true; }
        }
    }

    Dialog {
        open: root.new-open;
        title: "New chat";
        text: "Their phone number, with the country code.";
        dismissed => { root.new-open = false; }
        Field {
            placeholder: "+44 7700 900123";
            icon: "hash";
            text: root.new-phone;
            edited(t) => { root.new-phone = t; }
            accepted(t) => { Chats.new-chat(t); root.new-open = false; root.new-phone = ""; }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Cancel"; kind: "ghost"; clicked => { root.new-open = false; } }
            Button {
                text: "Start chat";
                kind: "primary";
                enabled: root.new-phone != "";
                clicked => { Chats.new-chat(root.new-phone); root.new-open = false; root.new-phone = ""; }
            }
        }
    }

    Dialog {
        open: root.unlink-open;
        title: "Unlink this computer?";
        text: "Chats signs out of WhatsApp and deletes its copy of your messages and media from this computer. Your phone keeps everything.";
        dismissed => { root.unlink-open = false; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Cancel"; kind: "ghost"; clicked => { root.unlink-open = false; } }
            Button { text: "Unlink"; kind: "danger"; clicked => { Chats.unlink(); root.unlink-open = false; } }
        }
    }

    Toast { text: Chats.toast; bad: Chats.toast-bad; }
}

