// The Settings window: Quickshell's SettingsFrame.qml (title bar, search,
// the categories down the side, the pane) and SettingsRow.qml (one row,
// its control chosen by its kind), drawn the same. What each pane holds
// comes from src/rows.rs, Settings.qml's rows ported row for row.

import { Theme, Icons, Win, KitWindow, Icon, Switch, Slider, Scroll } from "@kit";
import { Segmented } from "common.slint";
import { WifiPanel, Wifi, WifiNet, KV, SavedNet } from "wifi.slint";
import { BluetoothPanel, Blue, BtDev } from "bluetooth.slint";

export { Theme, Icons, Win, Wifi, WifiNet, KV, SavedNet, Blue, BtDev }

export struct Btn { label: string, quiet: bool, enabled: bool }

// One row (Settings.qml's row objects). `kind` is its type there:
// header seg toggle slider menu swatch meter action buttons info nav text
// color keybind themes panel. `card` is where it falls in its card
// (Settings.cardPositions): h, only, first, middle, last or free.
export struct Row {
    kind: string,
    n: string,
    s: string,
    value: string,
    on: bool,
    num: float,
    min: float,
    max: float,
    step: float,
    unit: string,
    options: [string],
    pick: int,
    buttons: [Btn],
    label: string,
    icon: string,
    colour: color,
    colours: [color],
    placeholder: string,
    panel: string,
    card: string,
    flash: bool,
}

export struct Category { id: string, icon: string, active: bool }
export struct Hit { n: string, sub: string, icon: string }

export global Prefs {
    in property <[Category]> categories;
    in property <[Row]> rows;
    in property <[string]> shorts;
    in property <string> title;
    in property <string> note;
    // The category to go back to from one of its panes ("" for none).
    in property <string> crumb;
    in property <[Hit]> hits;
    in property <string> query;
    in property <string> toast;
    in property <string> subtitle: "hyprshell · live";
    callback open-category(string);
    callback back();
    callback search(string);
    callback pick-hit(int);
    callback set-bool(int, bool);
    callback set-num(int, float);
    callback set-text(int, string);
    callback set-index(int, int);
    callback press(int, int);
    callback accent(int);
    // A key pressed while a shortcut row listens: its text and modifiers
    // (control, alt, shift, meta).
    callback captured(int, string, bool, bool, bool, bool);
    callback scroll-to(length);
}

// ── controls ─────────────────────────────────────────────────────────────

component AccentButton inherits Rectangle {
    in property <string> text;
    in property <bool> quiet;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    width: l.preferred-width + 24px;
    border-radius: Theme.r-sm;
    background: root.quiet ? (ta.has-hover ? Theme.sel : Theme.hover) : Theme.accent;
    border-width: root.quiet ? 1px : 0px;
    border-color: Theme.rule;
    opacity: !root.enabled ? 0.45 : (ta.has-hover && !root.quiet ? 0.9 : 1);
    l := Text {
        text: root.text;
        font-size: Theme.fs(12);
        font-weight: 600;
        color: root.quiet ? Theme.ink : Theme.ink-on-accent;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// The colour, typed as hex (the shell's picker comes later).
component HexBox inherits Rectangle {
    in property <string> value;
    callback picked(string);
    width: 220px;
    height: 104px;
    Rectangle {
        border-radius: Theme.r-sm;
        background: Theme.dialog;
        border-width: 1px;
        border-color: Theme.edge;
        VerticalLayout {
            padding: 12px;
            spacing: 10px;
            Rectangle {
                height: 32px;
                border-radius: Theme.r-sm;
                background: Theme.ground;
                border-width: hexin.has-focus ? 2px : 1px;
                border-color: hexin.has-focus ? Theme.accent : Theme.rule;
                hexin := TextInput {
                    x: 10px;
                    width: parent.width - 20px;
                    vertical-alignment: center;
                    text: root.value;
                    font-family: "JetBrains Mono";
                    font-size: Theme.fs(12);
                    color: Theme.ink;
                    single-line: true;
                    accepted => { root.picked(self.text); }
                    init => { self.focus(); self.select-all(); }
                }
            }
            Text {
                text: "A colour such as #3b6ef5; Enter to use it";
                font-size: Theme.fs(11);
                color: Theme.ink3;
                wrap: word-wrap;
            }
        }
    }
}

component ThemeHalf inherits Rectangle {
    in property <bool> dk;
    clip: true;
    background: dk ? #201e1d : #f3f2f2;
    Rectangle {
        x: 12px - root.x;
        y: 12px;
        width: 104px;
        height: 70px;
        border-radius: 5px;
        background: root.dk ? #2b2928 : #fbfafa;
        border-width: 1px;
        border-color: root.dk ? #3a3837 : #e2e0e0;
        Rectangle { x: 7px; y: 7px; width: 3px; height: 7px; border-radius: 1.5px; background: Theme.accent; }
        Rectangle { x: 14px; y: 9px; width: 32px; height: 3px; border-radius: 1.5px; background: root.dk ? #f8f4f4 : #201e1d; }
        Rectangle { x: 8px; y: 22px; width: 64.5px; height: 3px; border-radius: 1.5px; background: root.dk ? #77736f : #9a9696; }
        Rectangle { x: 8px; y: 30px; width: 43px; height: 3px; border-radius: 1.5px; background: root.dk ? #77736f : #9a9696; }
        Rectangle { x: 8px; y: 38px; width: 53.3px; height: 3px; border-radius: 1.5px; background: root.dk ? #77736f : #9a9696; }
        Rectangle { x: 8px; y: 46px; width: 26px; height: 9px; border-radius: 3px; background: Theme.accent; }
    }
}

// ThemeTiles.qml: Light, Dark and Auto, each a picture of the shell.
component ThemeTile inherits VerticalLayout {
    in property <string> label;
    in property <string> mode;
    in property <bool> chosen;
    callback picked();
    spacing: 7px;
    Rectangle {
        width: 132px;
        height: 82px;
        border-radius: Theme.r-sm + 2px;
        border-width: root.chosen ? 2px : 1px;
        border-color: root.chosen ? Theme.accent : Theme.rule;
        Rectangle {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            border-radius: Theme.r-sm - 1px;
            clip: true;
            if root.mode != "auto": ThemeHalf { dk: root.mode == "dark"; }
            if root.mode == "auto": ThemeHalf { x: 0; width: parent.width / 2; dk: false; }
            if root.mode == "auto": ThemeHalf { x: parent.width / 2; width: parent.width / 2; dk: true; }
        }
        TouchArea { mouse-cursor: pointer; clicked => { root.picked(); } }
    }
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                border-width: root.chosen ? 4px : 1px;
                border-color: root.chosen ? Theme.accent : Theme.ink3;
            }
        }
        Text { text: root.label; font-size: Theme.fs(12.5); font-weight: root.chosen ? 600 : 500; color: Theme.ink; vertical-alignment: center; }
        if root.mode == "auto": Text { text: "Dark after sunset"; font-size: Theme.fs(11); color: Theme.ink3; vertical-alignment: center; }
    }
}

// A full-width panel of the Quickshell Settings (WifiPanel.qml and the
// rest) that the Rust one hasn't drawn yet: what it is, and the way there.
component PanelCard inherits Rectangle {
    in property <string> panel;
    callback press(int);
    property <string> title:
        panel == "wifi" ? "Wi-Fi networks" : panel == "bluetooth" ? "Bluetooth devices" : panel == "sound" ? "Sound"
        : panel == "preview" ? "Preview" : panel == "focus" ? "Focus schedules" : panel == "notifApps" ? "Apps that notify"
        : panel == "shellUpdates" ? "Shell updates" : panel == "face" ? "Face unlock" : panel == "laptop" ? "ROG Control Center"
        : panel == "animated" ? "Animated wallpapers" : panel;
    property <string> text:
        panel == "wifi" ? "Join, disconnect and forget networks from the control center's Wi-Fi list."
        : panel == "bluetooth" ? "Pair, connect and disconnect devices from the control center's Bluetooth list."
        : panel == "sound" ? "Volume and the microphone are in the control center for now."
        : panel == "laptop" ? "Performance, fans, charge limit, keyboard light and graphics are in ROG Control Center."
        : panel == "preview" ? "Every change below shows on the shell itself as you make it."
        : panel == "animated" ? "The Rust shell draws the gradient in their place for now."
        : "Not in the Rust Settings yet.";
    property <string> button: panel == "wifi" ? "Show networks" : panel == "bluetooth" ? "Show devices" : panel == "laptop" ? "Open" : "";
    border-radius: Theme.r;
    background: Theme.hover;
    min-height: lay.preferred-height;
    lay := HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text { text: root.title; font-size: Theme.fs(13); font-weight: 500; color: Theme.ink; }
            Text { text: root.text; font-size: Theme.fs(12); color: Theme.ink3; wrap: word-wrap; }
        }
        if root.button != "": VerticalLayout {
            alignment: center;
            AccentButton { text: root.button; clicked => { root.press(0); } }
        }
    }
}

// ── one row (SettingsRow.qml) ────────────────────────────────────────────

component SettingsRow inherits Rectangle {
    in property <Row> item;
    in property <int> index;
    in property <string> short-s;
    property <bool> header: item.kind == "header";
    property <bool> wide: item.kind == "panel" || item.kind == "themes";
    property <bool> carded: item.card != "" && item.card != "h" && item.card != "free" && !self.header;
    property <length> inset: self.carded ? 16px : 0px;
    property <bool> card-top: item.card == "only" || item.card == "first";
    property <bool> card-bottom: item.card == "only" || item.card == "last";
    property <bool> nav: item.kind == "nav";
    // A long description shows its first sentence; More the rest.
    property <bool> more-open;
    property <bool> trimmed: !self.header && root.short-s != item.s;
    property <float> live: item.num;
    property <bool> listening;
    property <length> control-w: root.wide ? self.width - root.inset * 2 : control.preferred-width;
    property <length> labels-w: root.header || root.wide ? self.width - root.inset * 2 : self.width - root.inset * 2 - root.control-w - 24px - (root.nav && item.icon != "" ? 40px : 0px);

    // The card: its corners only where the card has them.
    background: root.carded ? Theme.hover : transparent;
    border-top-left-radius: root.carded && root.card-top ? Theme.r : 0px;
    border-top-right-radius: root.carded && root.card-top ? Theme.r : 0px;
    border-bottom-left-radius: root.carded && root.card-bottom ? Theme.r : 0px;
    border-bottom-right-radius: root.carded && root.card-bottom ? Theme.r : 0px;

    height: root.header ? labels.preferred-height + (item.card != "" ? 36px : 34px)
        : root.wide ? (item.n != "" || item.s != "" ? labels.preferred-height + 10px : 0px) + control.preferred-height + (root.carded ? 32px : 26px)
        : max(labels.preferred-height, control.preferred-height) + (root.carded ? 28px : 26px);

    // Found by the search: a wash of the accent, let go slowly.
    Rectangle {
        x: -10px;
        width: parent.width + 20px;
        border-radius: Theme.r-sm;
        background: Theme.accent;
        opacity: item.flash ? 0.22 : 0;
        animate opacity { duration: 600ms; easing: ease-out; }
    }
    // A link item lights up under the pointer.
    if root.nav && navta.has-hover: Rectangle {
        background: Theme.hover;
        opacity: 0.9;
        border-top-left-radius: root.card-top || !root.carded ? Theme.r : 0px;
        border-top-right-radius: root.card-top || !root.carded ? Theme.r : 0px;
        border-bottom-left-radius: root.card-bottom || !root.carded ? Theme.r : 0px;
        border-bottom-right-radius: root.card-bottom || !root.carded ? Theme.r : 0px;
    }
    // A hairline between a card's rows, inset from its edges.
    if root.carded && !root.card-top: Rectangle {
        x: root.inset;
        y: 0;
        width: parent.width - root.inset * 2;
        height: 1px;
        background: Theme.rule;
    }

    if root.nav && item.icon != "": Icon {
        x: root.inset + 4px;
        y: (parent.height - self.height) / 2;
        name: item.icon;
        size: 22px;
    }
    navta := TouchArea {
        enabled: root.nav;
        mouse-cursor: root.nav ? pointer : default;
        clicked => { Prefs.press(root.index, 0); }
    }

    labels := VerticalLayout {
        x: root.inset + (root.header && item.card != "" ? 4px : 0px) + (root.nav && item.icon != "" ? 40px : 0px);
        width: root.labels-w;
        y: root.wide ? (root.carded ? 15px : 13px)
            : root.header ? parent.height - self.preferred-height - 8px
            : (parent.height - self.preferred-height) / 2;
        height: self.preferred-height;
        spacing: 3px;
        if item.n != "": Text {
            text: root.header ? item.n.to-uppercase() : item.n;
            overflow: elide;
            font-size: root.header ? 12px : Theme.fs(13);
            font-weight: root.header ? 600 : 500;
            letter-spacing: root.header ? 0.6px : 0px;
            color: root.header ? Theme.ink3 : Theme.ink;
        }
        if item.s != "": Text {
            text: root.more-open || !root.trimmed ? item.s : root.short-s;
            wrap: word-wrap;
            font-size: Theme.fs(12);
            color: Theme.ink3;
        }
        if root.trimmed: Text {
            text: root.more-open ? "Less" : "More";
            font-size: Theme.fs(11.5);
            font-weight: 600;
            color: mta.has-hover ? Theme.accent : Theme.ink2;
            mta := TouchArea { mouse-cursor: pointer; clicked => { root.more-open = !root.more-open; } }
        }
    }

    control := HorizontalLayout {
        alignment: root.wide ? LayoutAlignment.stretch : LayoutAlignment.end;
        x: root.wide ? root.inset : parent.width - root.inset - root.control-w;
        width: root.control-w;
        y: root.wide ? parent.height - self.preferred-height - (root.carded ? 16px : 13px) : (parent.height - self.preferred-height) / 2;
        height: self.preferred-height;

        if item.kind == "seg": Segmented {
            options: item.options;
            current: item.pick;
            picked(i) => { Prefs.set-index(root.index, i); }
        }
        if item.kind == "toggle": VerticalLayout {
            alignment: center;
            Switch { on: item.on; toggled(v) => { Prefs.set-bool(root.index, v); } }
        }
        if item.kind == "slider": HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Slider {
                    width: 216px;
                    minimum: item.min;
                    maximum: item.max;
                    step: item.step;
                    value: item.num;
                    moved(v) => { root.live = v; }
                    released(v) => { root.live = v; Prefs.set-num(root.index, v); }
                }
            }
            // The number, typed into directly.
            Rectangle {
                width: 74px;
                height: 26px;
                border-radius: Theme.r-sm;
                background: Theme.hover;
                border-width: 1px;
                border-color: num.has-focus ? Theme.accent : Theme.rule;
                HorizontalLayout {
                    alignment: center;
                    spacing: 3px;
                    num := TextInput {
                        width: 34px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        text: round(root.live / max(item.step, 0.0001)) * item.step;
                        color: Theme.ink;
                        font-size: Theme.fs(12);
                        font-weight: 600;
                        single-line: true;
                        accepted => {
                            Prefs.set-num(root.index, clamp(self.text.to-float(), item.min, item.max));
                            self.clear-focus();
                        }
                    }
                    Text { vertical-alignment: center; text: item.unit; font-size: Theme.fs(11); color: Theme.ink3; }
                }
            }
        }
        if item.kind == "menu": Rectangle {
            width: clamp(sizer.preferred-width + 46px, 168px, 320px);
            height: 32px;
            border-radius: Theme.r-sm;
            background: mh.has-hover ? Theme.sel : Theme.hover;
            border-width: 1px;
            border-color: Theme.rule;
            sizer := VerticalLayout {
                visible: false;
                for o in item.options: Text { text: o; font-size: Theme.fs(12); font-weight: 600; }
            }
            Text {
                x: 10px;
                width: parent.width - 43px;
                vertical-alignment: center;
                overflow: elide;
                text: item.value;
                font-size: Theme.fs(12);
                font-weight: 600;
                color: Theme.ink;
            }
            Icon { x: parent.width - 27px; y: (parent.height - self.height) / 2; name: "chevronDown"; size: 17px; ink: Theme.ink3; }
            mh := TouchArea { mouse-cursor: pointer; clicked => { pop.show(); } }
            pop := PopupWindow {
                x: 0;
                y: parent.height + 4px;
                width: parent.width;
                Rectangle {
                    height: opts.preferred-height;
                    border-radius: Theme.r-sm;
                    background: Theme.dialog;
                    border-width: 1px;
                    border-color: Theme.edge;
                    opts := VerticalLayout {
                        padding: 4px;
                        spacing: 1px;
                        for o[i] in item.options: Rectangle {
                            height: 29px;
                            border-radius: Theme.r-sm;
                            background: oh.has-hover ? Theme.hover : transparent;
                            Text {
                                x: 9px;
                                width: parent.width - 38px;
                                vertical-alignment: center;
                                overflow: elide;
                                text: o;
                                font-size: Theme.fs(12);
                                color: Theme.ink;
                            }
                            if i == item.pick: Icon { x: parent.width - 25px; y: (parent.height - self.height) / 2; name: "check"; size: 16px; ink: Theme.accent; }
                            oh := TouchArea { mouse-cursor: pointer; clicked => { Prefs.set-index(root.index, i); } }
                        }
                    }
                }
            }
        }
        // The presets, and the custom colour last (SettingsRow's swatch).
        if item.kind == "swatch": HorizontalLayout {
            spacing: 8px;
            for c[i] in item.colours: VerticalLayout {
                alignment: center;
                Rectangle {
                    property <bool> custom: i == item.colours.length - 1;
                    property <bool> chosen: self.custom ? item.pick == -1 : i == item.pick;
                    width: 28px;
                    height: 28px;
                    border-radius: Theme.r-sm;
                    background: c;
                    border-width: 1px;
                    border-color: Theme.rule;
                    // The ring, outside the swatch.
                    Rectangle {
                        x: -3px;
                        y: -3px;
                        width: parent.width + 6px;
                        height: parent.height + 6px;
                        border-radius: Theme.r-sm + 3px;
                        border-width: parent.chosen ? 2px : 0px;
                        border-color: Theme.ink;
                    }
                    if (self.chosen && !item.on) || self.custom: Icon {
                        x: 5px;
                        y: 5px;
                        name: parent.custom && !parent.chosen ? "plus" : "check";
                        size: 18px;
                        ink: parent.custom ? Theme.ink-on-accent : (Theme.dark ? #201e1d : #fff2ef);
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Prefs.accent(parent.custom ? -1 : i);
                            if (parent.custom) { hexpop.show(); }
                        }
                    }
                }
            }
            Rectangle {
                width: 0;
                hexpop := PopupWindow {
                    x: -220px;
                    y: 40px;
                    close-policy: close-on-click-outside;
                    HexBox {
                        value: item.value;
                        picked(t) => { Prefs.set-text(root.index, t); hexpop.close(); }
                    }
                }
            }
        }
        if item.kind == "meter": HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 160px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.sel;
                    clip: true;
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(item.num, 0, 1);
                        border-radius: 4px;
                        background: item.on ? Theme.ink2 : Theme.accent;
                    }
                }
            }
            Text {
                width: 44px;
                horizontal-alignment: right;
                vertical-alignment: center;
                text: item.label;
                font-size: Theme.fs(13);
                font-weight: 600;
                color: Theme.ink2;
            }
        }
        if item.kind == "action": AccentButton { text: item.label; clicked => { Prefs.press(root.index, 0); } }
        if item.kind == "buttons": HorizontalLayout {
            spacing: 8px;
            for b[i] in item.buttons: VerticalLayout {
                alignment: center;
                AccentButton { text: b.label; quiet: b.quiet; enabled: b.enabled; clicked => { Prefs.press(root.index, i); } }
            }
        }
        if item.kind == "info": Text {
            vertical-alignment: center;
            text: item.value;
            font-size: Theme.fs(13);
            font-weight: 600;
            color: Theme.ink2;
        }
        if item.kind == "nav": HorizontalLayout {
            spacing: 6px;
            if item.value != "": Text { vertical-alignment: center; text: item.value; font-size: Theme.fs(12); color: Theme.ink3; }
            VerticalLayout { alignment: center; Icon { name: "chevronRight"; size: 16px; ink: Theme.ink3; } }
        }
        if item.kind == "text": HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 190px;
                height: 32px;
                border-radius: Theme.r-sm;
                background: Theme.ground;
                border-width: tin.has-focus ? 2px : 1px;
                border-color: tin.has-focus ? Theme.accent : Theme.rule;
                tin := TextInput {
                    x: 10px;
                    width: parent.width - 20px;
                    vertical-alignment: center;
                    text: item.value;
                    font-size: Theme.fs(12);
                    color: Theme.ink;
                    single-line: true;
                    accepted => { Prefs.set-text(root.index, self.text); }
                }
                if tin.text == "" && !tin.has-focus: Text {
                    x: 10px;
                    vertical-alignment: center;
                    text: item.placeholder;
                    font-size: Theme.fs(12);
                    color: Theme.ink3;
                }
            }
            AccentButton { text: item.label != "" ? item.label : "Go"; clicked => { Prefs.set-text(root.index, tin.text); } }
        }
        if item.kind == "color": Rectangle {
            width: 44px;
            height: 28px;
            border-radius: Theme.r-sm;
            background: item.colour;
            border-width: 1px;
            border-color: Theme.rule;
            TouchArea { mouse-cursor: pointer; clicked => { cpop.show(); } }
            cpop := PopupWindow {
                x: -176px;
                y: 36px;
                close-policy: close-on-click-outside;
                HexBox {
                    value: item.value;
                    picked(t) => { Prefs.set-text(root.index, t); cpop.close(); }
                }
            }
        }
        // Records the next chord pressed (SettingsRow's keybindComponent).
        if item.kind == "keybind": Rectangle {
            width: 196px;
            height: 30px;
            border-radius: Theme.r-sm;
            background: root.listening ? Theme.accent : (kh.has-hover ? Theme.sel : Theme.hover);
            border-width: 1px;
            border-color: root.listening ? Theme.accent : Theme.rule;
            Text {
                x: 8px;
                width: parent.width - 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                text: root.listening ? "Press a shortcut…" : (item.value != "" ? item.value : "unset");
                font-size: Theme.fs(12);
                font-weight: 600;
                font-family: root.listening ? Theme.font-family : "JetBrains Mono";
                color: root.listening ? Theme.ink-on-accent : Theme.ink;
            }
            kh := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.listening = !root.listening;
                    if (root.listening) { cap.focus(); }
                }
            }
            cap := FocusScope {
                focus-changed-event => { if (!self.has-focus) { root.listening = false; } }
                key-pressed(e) => {
                    if (!root.listening) { return reject; }
                    if (e.text == Key.Escape) { root.listening = false; return accept; }
                    // A modifier on its own waits for the real key, except
                    // for the probe, where which modifier it is is the answer.
                    if (e.text == Key.Shift || e.text == Key.Control || e.text == Key.Alt || e.text == Key.Meta || e.text == Key.AltGr) {
                        if (!item.on) { return accept; }
                    }
                    root.listening = false;
                    Prefs.captured(root.index, e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
                    accept
                }
            }
        }
        if item.kind == "themes": HorizontalLayout {
            horizontal-stretch: 1;
            alignment: start;
            spacing: 12px;
            ThemeTile { label: "Light"; mode: "light"; chosen: item.value == "light"; picked => { Prefs.set-text(root.index, "light"); } }
            ThemeTile { label: "Dark"; mode: "dark"; chosen: item.value == "dark"; picked => { Prefs.set-text(root.index, "dark"); } }
            ThemeTile { label: "Auto"; mode: "auto"; chosen: item.value == "auto"; picked => { Prefs.set-text(root.index, "auto"); } }
        }
        if item.kind == "panel" && item.panel == "wifi": WifiPanel { horizontal-stretch: 1; }
        if item.kind == "panel" && item.panel == "bluetooth": BluetoothPanel { horizontal-stretch: 1; }
        if item.kind == "panel" && item.panel != "wifi" && item.panel != "bluetooth": PanelCard {
            horizontal-stretch: 1;
            panel: item.panel;
            press(i) => { Prefs.press(root.index, i); }
        }
    }

    changed item => {
        if (item.flash) { Prefs.scroll-to(self.y); }
    }
}

// ── the window (SettingsFrame.qml) ───────────────────────────────────────

component WinButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> danger;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: Theme.r-sm;
    background: !ta.has-hover ? transparent : (root.danger ? Theme.accent : Theme.hover);
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.glyph;
        size: 17px;
        ink: ta.has-hover && root.danger ? Theme.ink-on-accent : Theme.ink2;
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component AppWindow inherits KitWindow {
    title: "Settings";
    preferred-width: 900px;
    preferred-height: 620px;
    min-width: 640px;
    min-height: 420px;
    in-out property <length> pane-y <=> pane.viewport-y;
    in-out property <string> query-text <=> q.text;

    // ── title bar ───────────────────────────────────────────────────────
    Rectangle {
        y: 0;
        height: 40px;
        TouchArea {
            mouse-cursor: grab;
            pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { Win.move(); } }
            double-clicked => { Win.toggle-maximize(); }
        }
        HorizontalLayout {
            x: 14px;
            spacing: 11px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Rectangle { width: 3px; height: 16px; border-radius: 2px; background: Theme.accent; }
            }
            VerticalLayout { alignment: center; Icon { name: "settings"; size: 23px; } }
            Text { vertical-alignment: center; text: "Settings"; font-size: Theme.fs(13); font-weight: 600; letter-spacing: 0.13px; color: Theme.ink; }
            Text { vertical-alignment: center; text: Prefs.subtitle; font-size: Theme.fs(12); color: Theme.ink3; }
        }
        HorizontalLayout {
            x: parent.width - self.preferred-width - 8px;
            width: self.preferred-width;
            spacing: 2px;
            VerticalLayout { alignment: center; WinButton { glyph: "minus"; clicked => { Win.minimize(); } } }
            VerticalLayout { alignment: center; WinButton { glyph: "square"; clicked => { Win.toggle-maximize(); } } }
            VerticalLayout { alignment: center; WinButton { glyph: "x"; danger: true; clicked => { Win.close(); } } }
        }
        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.rule; }
    }

    // ── sidebar ─────────────────────────────────────────────────────────
    Rectangle {
        x: 0;
        y: 40px;
        width: 212px;
        height: parent.height - 40px;
        Rectangle { x: parent.width - 1px; width: 1px; background: Theme.rule; }

        // Search: every pane's rows, by name and description.
        Rectangle {
            x: 8px;
            y: 8px;
            width: parent.width - 17px;
            height: 34px;
            border-radius: Theme.r-sm;
            background: Theme.hover;
            border-width: 1px;
            border-color: q.has-focus ? Theme.accent : Theme.rule;
            Icon { x: 10px; y: (parent.height - self.height) / 2; name: "search"; size: 15px; ink: Theme.ink3; }
            q := TextInput {
                x: 33px;
                width: parent.width - 33px - (Prefs.query != "" ? 32px : 8px);
                vertical-alignment: center;
                font-size: Theme.fs(13);
                color: Theme.ink;
                single-line: true;
                edited => { Prefs.search(self.text); }
                accepted => { if (Prefs.hits.length > 0) { Prefs.pick-hit(0); } }
                key-pressed(e) => {
                    if (e.text == Key.Escape && self.text != "") {
                        self.text = "";
                        Prefs.search("");
                        return accept;
                    }
                    reject
                }
            }
            if q.text == "": Text {
                x: 33px;
                vertical-alignment: center;
                text: "Search settings";
                font-size: Theme.fs(13);
                color: Theme.ink3;
            }
            if Prefs.query != "": Rectangle {
                x: parent.width - 28px;
                y: 6px;
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: ch.has-hover ? Theme.sel : transparent;
                Icon { x: 5px; y: 5px; name: "x"; size: 12px; ink: Theme.ink2; }
                ch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        q.text = "";
                        Prefs.search("");
                        q.focus();
                    }
                }
            }
        }

        // The matches, while something is typed.
        if Prefs.query != "": Scroll {
            y: 48px;
            width: parent.width - 1px;
            height: parent.height - 48px;
            VerticalLayout {
                alignment: start;
                padding-left: 8px;
                padding-right: 8px;
                padding-bottom: 16px;
                spacing: 1px;
                if Prefs.hits.length == 0: Text {
                    wrap: word-wrap;
                    text: "Nothing in Settings matches “" + Prefs.query + "”";
                    font-size: Theme.fs(12);
                    color: Theme.ink3;
                }
                for h[i] in Prefs.hits: Rectangle {
                    height: 46px;
                    border-radius: Theme.r-sm;
                    background: hh.has-hover || (i == 0 && q.has-focus) ? Theme.hover : transparent;
                    Icon { x: 10px; y: (parent.height - self.height) / 2; name: h.icon; size: 17px; ink: Theme.ink2; }
                    VerticalLayout {
                        x: 37px;
                        width: parent.width - 45px;
                        alignment: center;
                        spacing: 1px;
                        Text { text: h.n; overflow: elide; font-size: Theme.fs(12.5); color: Theme.ink; }
                        Text { text: h.sub; overflow: elide; font-size: Theme.fs(11); color: Theme.ink3; }
                    }
                    hh := TouchArea { mouse-cursor: pointer; clicked => { Prefs.pick-hit(i); } }
                }
            }
        }

        // The categories; one is lit while you're on its page or a pane of it.
        if Prefs.query == "": Scroll {
            y: 44px;
            width: parent.width - 1px;
            height: parent.height - 44px;
            VerticalLayout {
                alignment: start;
                padding: 8px;
                for c in Prefs.categories: Rectangle {
                    height: 38px;
                    border-radius: Theme.r-sm;
                    background: c.active ? Theme.sel : (ca.has-hover ? Theme.hover : transparent);
                    animate background { duration: 150ms; easing: ease-out; }
                    if c.active: Rectangle {
                        x: 10px;
                        y: parent.height - 5px;
                        width: parent.width - 20px;
                        height: 2px;
                        border-radius: 1px;
                        background: Theme.accent;
                    }
                    HorizontalLayout {
                        x: 10px;
                        y: -1px;
                        spacing: 10px;
                        alignment: start;
                        VerticalLayout { alignment: center; Icon { name: c.icon; size: 20px; ink: c.active ? Theme.accent : Theme.ink2; } }
                        Text { vertical-alignment: center; text: c.id; font-size: Theme.fs(13); font-weight: c.active ? 600 : 400; color: Theme.ink; }
                    }
                    ca := TouchArea { mouse-cursor: pointer; clicked => { Prefs.open-category(c.id); } }
                }
            }
        }
    }

    // ── pane ────────────────────────────────────────────────────────────
    pane := Scroll {
        x: 212px;
        y: 40px;
        width: parent.width - 212px;
        height: parent.height - 40px;
        VerticalLayout {
            alignment: start;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 20px;
            padding-bottom: 40px;
            // Back to the category's page, from one of its panes.
            if Prefs.crumb != "": HorizontalLayout {
                height: 24px;
                alignment: start;
                spacing: 4px;
                VerticalLayout { alignment: center; Icon { name: "chevronLeft"; size: 14px; ink: cr.has-hover ? Theme.accent : Theme.ink3; } }
                Text {
                    vertical-alignment: center;
                    text: Prefs.crumb;
                    font-size: Theme.fs(12);
                    font-weight: 600;
                    color: cr.has-hover ? Theme.accent : Theme.ink3;
                    cr := TouchArea { mouse-cursor: pointer; clicked => { Prefs.back(); } }
                }
            }
            Text { text: Prefs.title; font-size: Theme.fs(17); font-weight: 700; color: Theme.ink; }
            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 12px;
                Text { text: Prefs.note; wrap: word-wrap; font-size: Theme.fs(13); color: Theme.ink3; }
            }
            for r[i] in Prefs.rows: SettingsRow {
                item: r;
                index: i;
                short-s: i < Prefs.shorts.length ? Prefs.shorts[i] : r.s;
            }
        }
    }

    if Prefs.toast != "": Rectangle {
        x: 212px + (parent.width - 212px - self.width) / 2;
        y: parent.height - self.height - 18px;
        width: tl.preferred-width + 32px;
        height: 36px;
        border-radius: 18px;
        background: Theme.dialog;
        border-width: 1px;
        border-color: Theme.edge;
        tl := Text { x: 16px; y: (parent.height - self.height) / 2; text: Prefs.toast; color: Theme.ink; font-size: Theme.fs(12.5); }
    }
}
