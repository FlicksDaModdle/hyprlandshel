// Pieces the panels share: Segmented.qml, NetButton.qml, NetField.qml,
// SignalBars.qml, and the panels' captions, cards and lines.

import { Theme, Icon } from "@kit";

// Menus that frost what is behind them (Appearance → "Frosted menus"): the
// window is looked at when a menu opens, the part under it blurred, and that
// drawn behind a tint of the menu's colour (menuTranslucency makes the tint
// thinner). Slint has no backdrop blur of its own; src/frost.rs makes the image.
export global Frost {
    in property <image> image;
    in property <bool> blurred;
    // How opaque the menu's own colour is: 1 - menuTranslucency.
    in property <float> alpha: 0.92;
    callback request(length, length, length, length);
}

export component FrostSurface inherits Rectangle {
    border-radius: Theme.r-sm;
    border-width: 1px;
    border-color: Theme.edge;
    clip: true;
    if Frost.blurred: Image { x: 0; y: 0; width: root.width; height: root.height; source: Frost.image; image-fit: fill; }
    Rectangle { background: Theme.dialog.with-alpha(Frost.alpha); }
    @children
}

export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    callback picked(int);
    height: 30px;
    min-width: lay.min-width;
    border-radius: Theme.r-sm;
    background: Theme.hover;
    // Every cell as wide as the widest label, so the pill fits each.
    sizer := VerticalLayout {
        visible: false;
        for o in root.options: Text { text: o; font-size: Theme.fs(12); font-weight: 600; }
    }
    if root.current >= 0 && root.options.length > 0: Rectangle {
        y: 3px;
        height: parent.height - 6px;
        border-radius: Theme.r-sm - 3px;
        background: Theme.accent;
        width: (root.width - 6px) / root.options.length;
        x: 3px + root.current * self.width;
        animate x { duration: Theme.t(320); easing: spring(0.25); }
    }
    lay := HorizontalLayout {
        padding: 3px;
        for o[i] in root.options: Rectangle {
            min-width: sizer.preferred-width + 24px;
            horizontal-stretch: 1;
            Text {
                text: o;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: Theme.fs(12);
                font-weight: 600;
                color: i == root.current ? Theme.ink-on-accent : Theme.ink2;
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
        }
    }
}

// NetButton.qml: quiet, primary (accent) or danger (accent text).
export component NetButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> active: true;
    callback clicked();
    width: t.preferred-width + 26px;
    height: 30px;
    border-radius: Theme.r-sm;
    opacity: root.active ? 1 : 0.45;
    background: root.primary ? Theme.accent : (ta.has-hover && root.active ? Theme.sel : Theme.hover);
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.rule;
    t := Text {
        text: root.label;
        font-size: Theme.fs(12);
        font-weight: 600;
        color: root.primary ? Theme.ink-on-accent : root.danger ? Theme.accent : Theme.ink;
    }
    ta := TouchArea {
        enabled: root.active;
        mouse-cursor: root.active ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// NetField.qml: a label, the field (a secret one with Show / Hide), a hint.
// At most `cap` wide, at the start of the space it is given; the cap is
// inside, so it doesn't narrow the layout around it.
export component NetField inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> secret;
    in property <length> cap: 360px;
    property <bool> reveal;
    callback edited(string);
    callback accepted();
    VerticalLayout {
        max-width: root.cap;
        horizontal-stretch: 1;
        spacing: 5px;
        if root.label != "": Text { text: root.label; font-size: Theme.fs(12); font-weight: 500; color: Theme.ink2; }
        Rectangle {
            height: 34px;
            border-radius: Theme.r-sm;
            background: Theme.ground;
            border-width: f.has-focus ? 2px : 1px;
            border-color: f.has-focus ? Theme.accent : Theme.rule;
            f := TextInput {
                x: 11px;
                width: parent.width - 11px - (root.secret ? 40px : 11px);
                vertical-alignment: center;
                text <=> root.text;
                font-size: Theme.fs(13);
                color: Theme.ink;
                single-line: true;
                input-type: root.secret && !root.reveal ? InputType.password : InputType.text;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(); }
            }
            if f.text == "": Text {
                x: 11px;
                vertical-alignment: center;
                text: root.placeholder;
                font-size: Theme.fs(13);
                color: Theme.ink3;
            }
            if root.secret: Text {
                x: parent.width - self.width - 10px;
                vertical-alignment: center;
                text: root.reveal ? "Hide" : "Show";
                font-size: Theme.fs(11);
                font-weight: 600;
                color: eye.has-hover ? Theme.ink : Theme.ink3;
                eye := TouchArea { mouse-cursor: pointer; clicked => { root.reveal = !root.reveal; } }
            }
        }
        if root.hint != "": Text { text: root.hint; wrap: word-wrap; font-size: Theme.fs(11); color: Theme.ink3; }
    }
    Rectangle { horizontal-stretch: 0.001; }
}

// SignalBars.qml: four bars, `lit` of them lit.
export component SignalBars inherits HorizontalLayout {
    in property <int> lit;
    in property <color> on: Theme.ink;
    spacing: 2px;
    height: 14px;
    for i in 4: VerticalLayout {
        alignment: end;
        Rectangle {
            width: 3px;
            height: 4px + i * 3.3px;
            border-radius: 1px;
            background: i < root.lit ? root.on : Theme.rule.with-alpha(0.6);
        }
    }
}

// The panels' section title.
export component Caption inherits Text {
    font-size: Theme.fs(12);
    font-weight: 600;
    letter-spacing: 0.6px;
    color: Theme.ink3;
}

// A line of explanation.
export component Line inherits Text {
    wrap: word-wrap;
    font-size: Theme.fs(12);
    color: Theme.ink3;
}

// A panel's card.
export component Card inherits Rectangle {
    border-radius: Theme.r;
    background: Theme.hover;
    border-width: 1px;
    border-color: Theme.rule;
}

// A link-like word (Look again, Show all, More options).
export component Link inherits Text {
    callback clicked();
    font-size: Theme.fs(12);
    font-weight: 600;
    color: lta.has-hover ? Theme.ink : Theme.accent;
    lta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A drop-down: the choice shown, the list on a click (KDE's combo boxes).
export component Choice inherits Rectangle {
    in property <[string]> labels;
    in property <int> current;
    in property <length> cap: 320px;
    callback picked(int);
    width: root.cap;
    height: 34px;
    border-radius: Theme.r-sm;
    background: Theme.ground;
    border-width: 1px;
    border-color: cta.has-hover ? Theme.ink3 : Theme.rule;
    Text {
        x: 11px;
        width: parent.width - 40px;
        vertical-alignment: center;
        overflow: elide;
        text: root.current >= 0 && root.current < root.labels.length ? root.labels[root.current] : "";
        font-size: Theme.fs(13);
        color: Theme.ink;
    }
    Icon { x: parent.width - 26px; y: 10px; name: "chevronDown"; size: 14px; ink: Theme.ink3; }
    cta := TouchArea { mouse-cursor: pointer; clicked => { Frost.request(root.absolute-position.x, root.absolute-position.y + root.height + 4px, root.width, root.labels.length * 31px + 8px); pop.show(); } }
    pop := PopupWindow {
        y: root.height + 4px;
        width: root.width;
        FrostSurface {
            height: list.preferred-height;
            list := VerticalLayout {
                padding: 4px;
                spacing: 1px;
                for l[i] in root.labels: Rectangle {
                    height: 30px;
                    border-radius: Theme.r-sm;
                    background: oh.has-hover ? Theme.hover : transparent;
                    Text { x: 9px; width: parent.width - 36px; vertical-alignment: center; overflow: elide; text: l; font-size: Theme.fs(12.5); color: Theme.ink; }
                    if i == root.current: Icon { x: parent.width - 25px; y: 7px; name: "check"; size: 16px; ink: Theme.accent; }
                    oh := TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
                }
            }
        }
    }
}

// A label over a control, as NetField lays its own out.
export component Labeled inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 5px;
    Text { text: root.label; font-size: Theme.fs(12); font-weight: 500; color: Theme.ink2; }
    HorizontalLayout { alignment: start; @children }
    if root.hint != "": Text { text: root.hint; wrap: word-wrap; font-size: Theme.fs(11); color: Theme.ink3; }
}

// SettingsPillButton.qml: a rounded button for the panels, quiet or in the
// accent, with an icon if it has one.
export component PillButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> active: true;
    callback clicked();
    width: prow.preferred-width + 24px;
    height: 32px;
    border-radius: self.height / 2;
    opacity: root.active ? 1 : 0.5;
    background: root.primary ? (pta.has-hover ? Theme.accent.brighter(0.08) : Theme.accent) : (pta.has-hover ? Theme.sel : Theme.hover);
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.rule;
    prow := HorizontalLayout {
        x: 12px;
        width: self.preferred-width;
        spacing: 6px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon { name: root.icon; size: 14px; ink: root.primary ? Theme.ink-on-accent : Theme.ink; acc: root.primary ? Theme.ink-on-accent : Theme.accent; }
        }
        Text { vertical-alignment: center; text: root.label; font-size: Theme.fs(12); font-weight: 600; color: root.primary ? Theme.ink-on-accent : Theme.ink; }
    }
    pta := TouchArea { enabled: root.active; mouse-cursor: root.active ? pointer : default; clicked => { root.clicked(); } }
}

// FillSlider.qml: a trough filled from the left, 0–1. `mark` draws a tick
// (100 % on a scale that goes past it).
export component FillBar inherits Rectangle {
    in property <float> value;
    in property <length> trough: 14px;
    in property <color> fill: Theme.accent;
    in property <float> mark: -1;
    callback moved(float);
    callback released(float);
    height: 22px;
    property <float> v: max(0, min(1, root.value));
    Rectangle {
        y: (parent.height - root.trough) / 2;
        height: root.trough;
        border-radius: Theme.r-sm;
        background: Theme.ground;
        border-width: 1px;
        border-color: Theme.rule;
        clip: true;
        Rectangle { x: 0; width: root.v * parent.width; height: parent.height; background: root.fill; }
    }
    if root.mark > 0 && root.mark < 1: Rectangle {
        x: root.width * root.mark - 1px;
        y: (parent.height - root.trough) / 2 - 3px;
        width: 2px;
        height: root.trough + 6px;
        background: Theme.ink3;
        opacity: 0.6;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.moved(max(0, min(1, self.mouse-x / root.width))); }
            if (e.kind == PointerEventKind.up) { root.released(max(0, min(1, self.mouse-x / root.width))); }
        }
        moved => { if (self.pressed) { root.moved(max(0, min(1, self.mouse-x / root.width))); } }
    }
}

// SoundCenterSlider.qml: rest point in the middle (balance, fade); -1 to
// 1, the fill growing out from the centre. A double-click centres it.
export component CenterBar inherits Rectangle {
    in property <float> value;
    callback moved(float);
    height: 22px;
    property <float> v: max(-1, min(1, root.value));
    Rectangle {
        y: (parent.height - 14px) / 2;
        height: 14px;
        border-radius: Theme.r-sm;
        background: Theme.ground;
        clip: true;
        Rectangle {
            x: root.v < 0 ? parent.width / 2 + root.v * parent.width / 2 : parent.width / 2;
            width: abs(root.v) * parent.width / 2;
            height: parent.height;
            background: Theme.accent;
        }
    }
    Rectangle {
        y: (parent.height - 14px) / 2;
        height: 14px;
        border-radius: Theme.r-sm;
        border-width: 1px;
        border-color: Theme.rule;
    }
    Rectangle { x: parent.width / 2 - 1px; y: (parent.height - 14px) / 2; width: 2px; height: 14px; background: Theme.ink3; }
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.moved(max(-1, min(1, self.mouse-x / root.width * 2 - 1))); }
        }
        moved => { if (self.pressed) { root.moved(max(-1, min(1, self.mouse-x / root.width * 2 - 1))); } }
        double-clicked => { root.moved(0); }
    }
}
