#!/bin/sh
# Drive the shell from a terminal, over the same channel its keybinds use.
#
# hyprland.lua's shortcuts append a line to $XDG_RUNTIME_DIR/hyprshell.cmd;
# the shell reads that file (quickshell/services/Commands.qml). This writes
# the same line, so `hyprshellctl lock` and SUPER+L are the same thing, and
# a shortcut that misbehaves can be reproduced by hand.
#
#   hyprshellctl doctor              check the whole chain
#   hyprshellctl list                list the commands
#   hyprshellctl trace               what the keybinds have tried lately
#   hyprshellctl ipc <command>       send over Quickshell's IPC instead
#   hyprshellctl <command> [arg]     run one
set -u

CONFIG=hyprshell
TARGET=shell

RT="${XDG_RUNTIME_DIR:-/tmp}"
CMD_FILE="$RT/hyprshell.cmd"
STATUS_FILE="$CMD_FILE.status"
BIND_LOG="$RT/hyprshell-bind.log"
QS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/$CONFIG"

# Every command in Commands.qml's table. `:arg` marks one that takes a
# value; doctor skips those rather than guessing what to pass.
COMMANDS='toggleLauncher toggleOverview toggleControlCenter toggleNotifications
toggleCalendar togglePower closePanels openSettings:arg toggleTheme cycleTheme
setTheme:arg setWallpaper:arg setAccent:arg lock reloadShell toggleDnd
syncTheming showDesktop volumeUp volumeDown volumeMute micMute
brightnessUp brightnessDown'

red()  { printf '\033[31m%s\033[0m\n' "$*"; }
grn()  { printf '\033[32m%s\033[0m\n' "$*"; }
dim()  { printf '\033[2m%s\033[0m\n' "$*"; }

# The pid of the shell's reader, if one is running.
watcher_pid() {
    [ -f "$STATUS_FILE" ] || return 1
    _w=$(sed -n 's/^watcher //p' "$STATUS_FILE" 2>/dev/null)
    [ -n "$_w" ] || return 1
    kill -0 "$_w" 2>/dev/null || return 1
    printf '%s' "$_w"
}

# Send one command the way the keybinds do.
send() {
    _line=$*
    if ! echo "$_line" >> "$CMD_FILE" 2>/dev/null; then
        red "could not write to $CMD_FILE"
        return 1
    fi
    if watcher_pid >/dev/null; then
        return 0
    fi
    red "queued, but nothing is reading $CMD_FILE"
    if [ -f "$STATUS_FILE" ]; then
        dim "  last watcher: $(cat "$STATUS_FILE" | tr '\n' ' ')"
    else
        dim "  no shell has started a watcher since boot"
    fi
    dim "  start the shell: $QS_DIR/run.sh"
    return 1
}

# The old route, kept for comparison: Quickshell's own IPC. It has to find
# the running instance first, which is the part that fails on some setups —
# which is why it is no longer what the keybinds use.
ipc_send() {
    _fn=$1; shift
    _pid=$(pgrep -x qs 2>/dev/null | head -n1)
    for _form in 1 2 3 4; do
        case $_form in
            1) [ -n "$_pid" ] || continue
               out=$(qs --pid "$_pid" ipc call "$TARGET" "$_fn" ${1+"$@"} 2>&1) ;;
            2) out=$(qs -c "$CONFIG" ipc call "$TARGET" "$_fn" ${1+"$@"} 2>&1) ;;
            3) out=$(qs ipc -c "$CONFIG" call "$TARGET" "$_fn" ${1+"$@"} 2>&1) ;;
            4) out=$(qs ipc call "$TARGET" "$_fn" ${1+"$@"} 2>&1) ;;
        esac
        # shellcheck disable=SC2181
        if [ $? -eq 0 ]; then
            grn "answered on route $_form"
            [ -n "$out" ] && printf '%s\n' "$out"
            return 0
        fi
        dim "route $_form: $out"
    done
    red "no IPC route reached the shell"
    return 1
}

known_command() {
    for c in $COMMANDS; do
        [ "${c%:arg}" = "$1" ] && return 0
    done
    return 1
}

# What the keybinds have been doing. They write a line per press, because
# Hyprland sends a spawned command's output to /dev/null and a shortcut that
# fails is otherwise completely silent.
#
#   a line ending "-> 0"   the command was written and the shell was reading
#   a line ending "-> 1"   nothing was reading it; the lines under it say
#                          what was there instead
#   no line at all         the bind never fired: the key or the modifier,
#                          not the shell
trace() {
    if [ ! -s "$BIND_LOG" ]; then
        red "nothing logged at $BIND_LOG"
        dim "  Either no shell shortcut has been pressed since this boot, or"
        dim "  none of them is firing at all. Press one and look again; if it"
        dim "  stays empty the key never reached the bind, which is a"
        dim "  compositor-side problem: check 'hyprctl binds'."
        return 1
    fi
    dim "$BIND_LOG"
    tail -n 25 "$BIND_LOG"
}

# What the shell registered with the compositor. Nothing uses these now —
# the keybinds go through the command file — but other clients can, and an
# empty list is the clearest sign this Quickshell was built without the
# global shortcuts protocol.
shortcuts() {
    command -v hyprctl >/dev/null 2>&1 || { red "hyprctl is not on PATH"; return 1; }
    out=$(hyprctl globalshortcuts 2>&1) || { red "$out"; return 1; }
    if printf '%s' "$out" | grep -q hyprshell; then
        printf '%s\n' "$out" | grep hyprshell
        return 0
    fi
    red "the shell has registered no global shortcuts"
    dim "  This build of Quickshell has no HYPRLAND_GLOBAL_SHORTCUTS."
    dim "  Nothing depends on them: the keybinds use $CMD_FILE."
    return 1
}

usage() {
    echo "usage: hyprshellctl doctor | list | trace | shortcuts"
    echo "       hyprshellctl <command> [arg]"
    echo "       hyprshellctl ipc <command> [arg]"
    echo
    echo "commands:"
    for c in $COMMANDS; do
        case $c in
            *:arg) printf '  %s <value>\n' "${c%:arg}" ;;
            *)     printf '  %s\n' "$c" ;;
        esac
    done
}

doctor() {
    fail=0

    echo "1. the shell is running"
    if pgrep -x qs >/dev/null 2>&1; then
        grn "   ok  pid $(pgrep -x qs | tr '\n' ' ')"
    else
        red "   no  nothing is running"
        dim "       start it: $QS_DIR/run.sh"
        # A config that fails to load leaves no process and no message on
        # screen — the reason is only in the log it wrote on the way down.
        newest=""
        for f in "$RT"/quickshell/by-id/*/log.qslog; do
            [ -f "$f" ] || continue
            [ -z "$newest" ] || [ "$f" -nt "$newest" ] && newest=$f
        done
        if [ -n "$newest" ]; then
            echo
            dim "       last run's log ($newest):"
            qs log "$newest" 2>/dev/null | tail -n 12 | sed 's/^/       /'
        fi
        return 1
    fi

    echo
    echo "2. it is reading commands"
    if w=$(watcher_pid); then
        grn "   ok  watcher pid $w, reading $CMD_FILE"
    else
        red "   no  nothing is reading $CMD_FILE"
        if [ -f "$STATUS_FILE" ]; then
            sed 's/^/       /' "$STATUS_FILE"
            dim "       That watcher is gone. Restart the shell:"
        else
            dim "       The shell is running but never started a watcher, so"
            dim "       it predates this mechanism. Reinstall and restart:"
        fi
        dim "         ./shell/install.sh && $QS_DIR/run.sh --restart"
        fail=1
    fi

    echo
    echo "3. a round trip"
    if send closePanels >/dev/null 2>&1; then
        grn "   ok  closePanels went through"
        dim "       every shortcut takes exactly this path"
    else
        red "   no  could not deliver a command"
        fail=1
    fi

    echo
    echo "4. what the keybinds have tried"
    if [ -s "$BIND_LOG" ]; then
        if tail -n 40 "$BIND_LOG" | grep -q -- "-> 0"; then
            grn "   ok  shortcuts are reaching the shell"
            dim "       $(tail -n 1 "$BIND_LOG")"
        else
            red "   no  every logged shortcut failed"
            tail -n 6 "$BIND_LOG" | sed 's/^/       /'
            fail=1
        fi
    else
        dim "   --  nothing logged yet at $BIND_LOG"
        dim "       Press a shell shortcut and run this again. Still empty"
        dim "       means the bind never fired — the key or the modifier,"
        dim "       not the shell."
    fi

    echo
    echo "5. the tap-to-open bind"
    if ! command -v hyprctl >/dev/null 2>&1; then
        dim "   --  hyprctl is not on PATH, so this cannot be checked"
    else
        # Print what Hyprland actually took, rather than a yes or a no. Two
        # rounds have now been spent guessing at this from the outside; the
        # registered bind is the evidence, so show it.
        taps=$(hyprctl binds 2>/dev/null \
               | grep -B4 -A6 -iE 'Super_L|Super_R|keycode: 13[34]')
        if [ -n "$taps" ]; then
            grn "   ok  Hyprland registered a bind on the Super key:"
            printf '%s\n' "$taps" | sed 's/^/       /'
            dim "       If tapping Super still does nothing, the bind is there"
            dim "       and is not matching, which is the compositor's side."
        else
            red "   no  Hyprland registered no bind on the Super key"
            dim "       The config asks for four (Super_L, Super_R, code:133,"
            dim "       code:134). None took, so this build rejected them all."
            errs=$(hyprctl configerrors 2>/dev/null | grep -v '^no errors' | head -n 6)
            [ -n "$errs" ] && printf '%s\n' "$errs" | sed 's/^/       /'
            fail=1
        fi
    fi

    echo
    echo "6. Quickshell IPC (optional)"
    if [ ! -f "$STATUS_FILE" ]; then
        dim "   --  unknown; no watcher has reported in"
    elif grep -q '^socket missing' "$STATUS_FILE"; then
        dim "   --  no socket at $(sed -n 's/^socket missing //p' "$STATUS_FILE")"
        dim "       so this build cannot be reached by pid at all"
    else
        grn "   ok  $(sed -n 's/^socket //p' "$STATUS_FILE")"
    fi
    dim "       Only used by 'hyprshellctl ipc'. The keybinds do not"
    dim "       need it, which is the point of the command file."

    echo
    if [ "$fail" -eq 0 ]; then
        grn "The chain is intact: a shortcut failing now is the bind itself."
        dim "Check it fired at all:  hyprctl binds | grep -A3 <your key>"
    else
        red "Something above is broken — that is why the shortcuts do nothing."
    fi
    return "$fail"
}

case "${1:-}" in
    ""|-h|--help|help) usage ;;
    doctor)            doctor ;;
    trace)             trace ;;
    shortcuts)         shortcuts ;;
    list)              usage ;;
    ipc)
        shift
        [ $# -ge 1 ] || { red "usage: hyprshellctl ipc <command> [arg]"; exit 2; }
        known_command "$1" || { red "no such command: $1"; exit 2; }
        ipc_send "$@"
        ;;
    *)
        known_command "$1" || { red "no such command: $1"; echo; usage; exit 2; }
        send "$@"
        ;;
esac
