// The shell's palette, dark, as config/Appearance.qml has it. (Following
// theme.json live comes with the settings port.)
export global Theme {
    out property <color> panel: #1d1b1aeb;
    out property <color> ink: #f8f4f4;
    out property <color> ink2: #bab6b6;
    out property <color> ink3: #8a8686;
    out property <color> accent: #ff563c;
    out property <color> ink-on-accent: #ffffff;
    out property <color> hover: #f8f4f417;
    out property <color> sel: #f8f4f424;
    out property <color> edge: #f8f4f429;
    out property <length> r-cap: 9px;
    out property <string> font: "Inter";
}
