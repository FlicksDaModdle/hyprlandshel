// Settings → Appearance → Screen corners (modules/corners): black, rounded
// corners over a panel's square ones, one small surface in each corner.
// `turn` says which: 0 top left, 1 top right, 2 bottom right, 3 bottom left.
export component Corner inherits Window {
    in property <int> turn;
    background: transparent;
    // The square, less the quarter circle that curves into the screen.
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: black;
        commands: root.turn == 0 ? "M 0 0 L 100 0 A 100 100 0 0 0 0 100 Z"
            : root.turn == 1 ? "M 100 0 L 100 100 A 100 100 0 0 0 0 0 Z"
            : root.turn == 2 ? "M 100 100 L 0 100 A 100 100 0 0 0 100 0 Z"
            : "M 0 100 L 0 0 A 100 100 0 0 0 100 100 Z";
    }
}
