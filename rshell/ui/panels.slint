// The dropdowns that hang under the bar (modules/panels/*.qml), on one
// full-screen overlay surface that is only there while one is open: a
// click anywhere off a panel closes it, as PanelLayer.qml's catcher does.
import { Icons, GlyphData } from "icons.slint";
import { Theme } from "theme.slint";
import { Glyph } from "glyph.slint";
import { IconButton, PanelSurface, Caps, Toggle, FillSlider, MenuRow, Rule } from "widgets.slint";
import { MediaInfo, MenuEntry, Note, NoteAction, DriveRow, TimerRow, Tile, PrivacyRow, DayCell, WifiRow, BtRow } from "types.slint";

export struct MixRow { index: int, title: string, sub: string, vol: float, muted: bool, pct: string, has-out: bool, out-label: string, has-eq: bool, eq-on: bool }
export struct HistEntry { id: int, day: string, show-day: bool, head: string, summary: string, body: string, urgent: bool }


// Where each panel sits, and how it arrives: Entrance.qml's springs, run
// in Rust (app.rs) and handed in here. The software renderer can't scale,
// so where Quickshell scales the panel out of its button this grows its
// frame out of the button instead (overshoot included) and the content,
// at its full size, is revealed inside it as it fades in.
component Drop inherits Rectangle {
    in property <bool> shown;
    in property <length> anchor;
    in property <length> top;
    in property <length> screen-width;
    in property <length> panel-width;
    in property <bool> seam: true;
    // Rising from the dock rather than hanging from the bar: placed by its
    // bottom edge, `bottom` above the screen's.
    in property <bool> from-bottom;
    in property <length> bottom;
    in property <length> screen-height;
    // Beside a dock on the left: the panel's left edge, and the height it points at.
    in property <length> left-edge: -1px;
    in property <length> point-y: -1px;
    // The springs: frame width and height as fractions, the lift, the
    // sheet's opacity and the content's.
    in property <float> sx: 1;
    in property <float> sy: 1;
    in property <length> lift;
    in property <float> glass: 1;
    in property <float> inner: 1;
    property <length> h: l.preferred-height;
    // Grown from under the button.
    property <length> origin: clamp(anchor - self.x, 0px, panel-width);
    x: left-edge >= 0px ? left-edge : max(12px, min(anchor - panel-width / 2, screen-width - panel-width - 12px));
    y: (point-y >= 0px ? max(top, min(point-y - h / 2, screen-height - h - 12px)) : from-bottom ? screen-height - bottom - h : top) + lift;
    width: panel-width;
    height: h;
    visible: shown && glass > 0.004;
    opacity: clamp(glass, 0, 1);
    frame := Rectangle {
        x: root.origin * (1 - root.sx);
        width: root.panel-width * root.sx;
        y: root.from-bottom ? root.h * (1 - root.sy) : 0;
        height: root.h * root.sy;
        border-radius: min(Theme.r-cap, self.height / 2, self.width / 2);
        background: Theme.panel;
        clip: true;
        Rectangle {
            x: -frame.x;
            y: -frame.y;
            width: root.panel-width;
            height: root.h;
            opacity: clamp(root.inner, 0, 1);
            l := VerticalLayout { @children }
        }
    }
    Rectangle {
        x: frame.x;
        y: frame.y;
        width: frame.width;
        height: frame.height;
        border-radius: frame.border-radius;
        border-width: 1px;
        border-color: Theme.edge;
    }
    // Between the corners: the software renderer doesn't clip to them.
    if root.seam: HorizontalLayout {
        x: frame.x + frame.border-radius;
        width: max(0px, frame.width - 2 * frame.border-radius);
        y: frame.y;
        height: 2px;
        Rectangle { width: min(40px, parent.width); background: Theme.accent; }
        Rectangle { background: Theme.seam; }
    }
}

// ── power (PowerMenu.qml) ────────────────────────────────────────────────
component PowerEntry inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <GlyphData> icon;
    callback activated();
    height: 42px;
    border-radius: Theme.r-sm;
    background: t.has-hover ? Theme.hover : transparent;
    animate background { duration: 140ms; }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 10px;
        Rectangle {
            y: (root.height - self.height) / 2;
            width: 26px;
            height: 26px;
            border-radius: Theme.r-sm;
            background: Theme.hover;
            border-width: 1px;
            border-color: Theme.rule;
            Glyph {
                x: 6px; y: 6px;
                data: root.icon;
                size: 14px;
                monochrome: true;
                ink: t.has-hover ? Theme.accent : Theme.ink2;
            }
        }
        Text { horizontal-stretch: 1; vertical-alignment: center; text: root.label; font-size: Theme.fs(13); color: Theme.ink; }
        Text {
            horizontal-stretch: 0;
            vertical-alignment: center;
            text: root.hint;
            font-size: Theme.fs(11);
            font-weight: 400;
            color: Theme.ink3;
        }
    }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
}

component PowerMenu inherits PanelSurface {
    in property <string> user;
    in property <string> uptime;
    in property <string> hyprland;
    callback act(string);
    VerticalLayout {
        padding-top: 12px;
        HorizontalLayout {
            height: 24px;
            padding-left: 14px;
            padding-right: 14px;
            Caps { vertical-alignment: center; text: "SESSION"; }
            Text {
                vertical-alignment: center;
                horizontal-alignment: right;
                text: root.user;
                font-size: Theme.fs(11);
                font-weight: 400;
                color: Theme.ink3;
            }
        }
        VerticalLayout {
            padding-left: 6px;
            padding-right: 6px;
            padding-bottom: 8px;
            spacing: 1px;
            PowerEntry { label: "Lock"; hint: "super L"; icon: Icons.lock; activated => { root.act("lock"); } }
            PowerEntry { label: "Suspend"; icon: Icons.moon; activated => { root.act("suspend"); } }
            PowerEntry { label: "Log out"; hint: "super ⇧ E"; icon: Icons.log-out; activated => { root.act("logout"); } }
            PowerEntry { label: "Restart"; icon: Icons.reboot; activated => { root.act("reboot"); } }
            PowerEntry { label: "Shut down"; icon: Icons.power; activated => { root.act("poweroff"); } }
        }
        Rule {}
        HorizontalLayout {
            height: 29px;
            padding-left: 14px;
            padding-right: 14px;
            Text { vertical-alignment: center; text: "Uptime " + root.uptime; font-size: Theme.fs(11); font-weight: 400; color: Theme.ink3; }
            Text {
                vertical-alignment: center;
                horizontal-alignment: right;
                text: root.hyprland;
                font-size: Theme.fs(11);
                font-weight: 400;
                color: Theme.ink3;
            }
        }
    }
}

// ── the focused window (WindowMenuPanel.qml) ─────────────────────────────
component SnapTile inherits Rectangle {
    in property <float> fx;
    in property <float> fy;
    in property <float> fw;
    in property <float> fh;
    callback activated();
    width: 76px;
    height: 48px;
    border-radius: Theme.r-sm;
    background: Theme.hover;
    border-width: 1px;
    border-color: t.has-hover ? Theme.accent : transparent;
    Rectangle {
        x: 4px + (root.width - 8px) * root.fx;
        y: 4px + (root.height - 8px) * root.fy;
        width: (root.width - 8px) * root.fw;
        height: (root.height - 8px) * root.fh;
        border-radius: 3px;
        background: Theme.accent;
        opacity: 0.5;
    }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
}

component WindowMenu inherits PanelSurface {
    seam: false;
    callback act(string);
    callback snap(int);
    VerticalLayout {
        padding: 6px;
        MenuRow { label: "Fullscreen"; hint: "super F"; activated => { root.act("fullscreen"); } }
        MenuRow { label: "Maximize"; hint: "super ⇧ F"; activated => { root.act("maximize"); } }
        MenuRow { label: "Float"; hint: "super V"; activated => { root.act("float"); } }
        MenuRow { label: "Pin"; hint: "super ⇧ P"; activated => { root.act("pin"); } }
        Rectangle { height: 5px; Rule { y: 2px; } }
        MenuRow { label: "Center"; activated => { root.act("center"); } }
        MenuRow { label: "Toggle split"; hint: "super J"; activated => { root.act("togglesplit"); } }
        Rectangle { height: 5px; Rule { y: 2px; } }
        MenuRow { label: "Move to next workspace"; activated => { root.act("next"); } }
        MenuRow { label: "Move to previous workspace"; activated => { root.act("prev"); } }
        Rectangle { height: 5px; Rule { y: 2px; } }
        MenuRow { label: "Close window"; hint: "super Q"; activated => { root.act("close"); } }
        Rectangle { height: 8px; }
        Rule {}
        Text {
            text: "Snap layout";
            font-size: Theme.fs(11);
            font-weight: 600;
            color: Theme.ink3;
            height: self.preferred-height + 18px;
            vertical-alignment: center;
            x: 5px;
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            SnapTile { fx: 0; fy: 0; fw: 0.5; fh: 1; activated => { root.snap(0); } }
            SnapTile { fx: 0.5; fy: 0; fw: 0.5; fh: 1; activated => { root.snap(1); } }
            SnapTile { fx: 0; fy: 0; fw: 1; fh: 0.5; activated => { root.snap(2); } }
        }
        Rectangle { height: 6px; }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            SnapTile { fx: 0; fy: 0.5; fw: 1; fh: 0.5; activated => { root.snap(3); } }
            SnapTile { fx: 0; fy: 0; fw: 1; fh: 1; activated => { root.snap(4); } }
            SnapTile { fx: 0.15; fy: 0.12; fw: 0.7; fh: 0.76; activated => { root.snap(5); } }
        }
        Rectangle { height: 4px; }
    }
}

// ── the calendar (CalendarPanel.qml) ─────────────────────────────────────
component CalendarPanel inherits PanelSurface {
    in property <string> month;
    in property <[DayCell]> cells;
    in property <bool> away;
    callback step(int);
    callback reset();
    property <length> cell-w: (root.width - 28px - 2px * 6) / 7;
    VerticalLayout {
        padding-top: 12px;
        padding-bottom: 14px;
        HorizontalLayout {
            height: 34px;
            padding-left: 14px;
            padding-right: 12px;
            spacing: 2px;
            Text {
                vertical-alignment: center;
                text: root.month;
                font-size: Theme.fs(13);
                font-weight: 600;
                color: Theme.ink;
                TouchArea { enabled: root.away; clicked => { root.reset(); } }
            }
            IconButton { y: 4px; size: 26px; icon-size: 14px; icon: Icons.chevron-left; ink: Theme.ink2; activated => { root.step(-1); } }
            IconButton { y: 4px; size: 26px; icon-size: 14px; icon: Icons.chevron-right; ink: Theme.ink2; activated => { root.step(1); } }
        }
        Rectangle { height: 10px; }
        Rectangle {
            height: 24px;
            for d[i] in ["S", "M", "T", "W", "T", "F", "S"]: Text {
                x: 14px + i * (root.cell-w + 2px) + (root.cell-w - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: d;
                font-size: Theme.fs(11);
                font-weight: 600;
                color: i == 0 || i == 6 ? Theme.div : Theme.ink3;
            }
        }
        Rectangle {
            height: ceil(root.cells.length / 7) * 36px;
            for c[i] in root.cells: Rectangle {
                x: 14px + mod(i, 7) * (root.cell-w + 2px);
                y: floor(i / 7) * 36px;
                width: root.cell-w;
                height: 34px;
                border-radius: 9px;
                background: c.today ? Theme.accent : (c.day > 0 && h.has-hover ? Theme.hover : transparent);
                if c.day > 0: Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: c.day;
                    font-size: Theme.fs(12);
                    color: c.today ? Theme.ink-on-accent : Theme.ink2;
                }
                h := TouchArea {}
            }
        }
    }
}

// ── control center (ControlCenter.qml, the main view) ─────────────────────
component CcTile inherits Rectangle {
    in property <Tile> tile;
    callback activated();
    // Wi-Fi and Bluetooth open their list from the chevron.
    callback more();
    property <bool> has-more: tile.kind == "wifi" || tile.kind == "wifi-off" || tile.kind == "bluetooth";
    pure function glyph(kind: string) -> GlyphData {
        if (kind == "wifi") { return Icons.wifi; }
        if (kind == "wifi-off") { return Icons.wifi-off; }
        if (kind == "bluetooth") { return Icons.bluetooth; }
        if (kind == "airplane") { return Icons.plane; }
        if (kind == "performance") { return Icons.zap; }
        if (kind == "keyboard") { return Icons.keyboard; }
        if (kind == "dnd") { return Icons.bell-off; }
        if (kind == "night") { return Icons.moon; }
        if (kind == "nightlight") { return Icons.moon; }
        if (kind == "capture") { return Icons.camera; }
        if (kind == "gamemode") { return Icons.gamepad; }
        if (kind == "keepawake") { return Icons.sun; }
        return Icons.dot;
    }
    height: 88px;
    border-radius: Theme.r-cap;
    background: tile.on ? Theme.accent : (t.has-hover ? Theme.sel : Theme.hover);
    animate background { duration: 160ms; }
    Glyph {
        x: 12px; y: 12px;
        data: root.glyph(root.tile.kind);
        size: 18px;
        monochrome: true;
        ink: root.tile.on ? Theme.ink-on-accent : Theme.ink;
    }
    VerticalLayout {
        x: 12px;
        width: root.width - 24px;
        y: root.height - self.preferred-height - 11px;
        height: self.preferred-height;
        spacing: 2px;
        Text {
            text: root.tile.name;
            font-size: Theme.fs(12);
            font-weight: 600;
            color: root.tile.on ? Theme.ink-on-accent : Theme.ink;
        }
        Text {
            text: root.tile.sub;
            overflow: elide;
            font-size: Theme.fs(11);
            font-weight: 400;
            opacity: root.tile.on ? 0.75 : 1;
            color: root.tile.on ? Theme.ink-on-accent : Theme.ink3;
        }
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 8px;
        width: min(28px, parent.width * 0.25);
        height: 3px;
        border-radius: 1.5px;
        background: root.tile.on ? Theme.ink-on-accent : Theme.div;
        opacity: root.tile.on ? 0.55 : 1;
    }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
    if root.has-more: Rectangle {
        x: parent.width - self.width - 8px;
        y: 8px;
        width: 22px;
        height: 22px;
        border-radius: Theme.r-sm;
        background: mt.has-hover ? (root.tile.on ? #00000029 : Theme.sel) : transparent;
        Glyph {
            x: 4px; y: 4px;
            data: Icons.chevron-right;
            size: 13px;
            monochrome: true;
            ink: root.tile.on ? Theme.ink-on-accent : Theme.ink2;
        }
        mt := TouchArea {
            x: -6px; y: -6px; width: parent.width + 12px; height: parent.height + 12px;
            mouse-cursor: pointer;
            clicked => { root.more(); }
        }
    }
}

// The Wi-Fi / Bluetooth list (ControlCenter.qml's expanded view): a header
// with the way back and the radio's switch, then the list.
component RadioPane inherits VerticalLayout {
    in property <string> heading;
    in property <string> sub;
    in property <bool> on;
    callback back();
    callback toggled(bool);
    callback more();
    HorizontalLayout {
        height: 50px;
        padding-left: 10px;
        padding-right: 14px;
        spacing: 10px;
        Rectangle {
            y: 10px;
            width: 30px;
            height: 30px;
            border-radius: Theme.r-sm;
            background: bk.has-hover ? Theme.hover : transparent;
            Glyph { x: 7px; y: 7px; data: Icons.chevron-left; size: 15px; monochrome: true; ink: Theme.ink2; }
            bk := TouchArea { mouse-cursor: pointer; clicked => { root.back(); } }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text { text: root.heading; font-size: Theme.fs(13); font-weight: 600; color: Theme.ink; }
            Text { text: root.sub; overflow: elide; font-size: Theme.fs(11); font-weight: 400; color: Theme.ink3; }
        }
        Toggle { y: 15px; checked: root.on; toggled(v) => { root.toggled(v); } }
    }
    Rule {}
    @children
    Rule {}
    // The way on to the full page in Settings.
    Rectangle {
        height: 40px;
        Rectangle {
            x: parent.width - self.width - 12px;
            y: 7px;
            width: ml.preferred-width + 20px;
            height: 26px;
            border-radius: Theme.r-sm;
            background: mt.has-hover ? Theme.sel : transparent;
            ml := Text { x: 10px; y: (parent.height - self.height) / 2; text: "More settings"; font-size: Theme.fs(11); font-weight: 600; color: mt.has-hover ? Theme.ink : Theme.ink3; }
            mt := TouchArea { mouse-cursor: pointer; clicked => { root.more(); } }
        }
    }
}

// Signal as bars: 1–4.
component Bars inherits Rectangle {
    in property <int> bars;
    in property <color> ink;
    width: 16px;
    height: 14px;
    for i in 4: Rectangle {
        x: i * 4px;
        width: 3px;
        y: parent.height - self.height;
        height: (i + 1) * 3.5px;
        border-radius: 1px;
        background: root.ink;
        opacity: i < root.bars ? 1 : 0.25;
    }
}

component CcSlider inherits VerticalLayout {
    in property <GlyphData> icon;
    in property <string> label;
    in property <string> value-text;
    in property <float> value;
    in property <string> chip;
    callback moved(float);
    callback icon-clicked();
    callback chip-clicked();
    spacing: 7px;
    HorizontalLayout {
        height: 15px;
        spacing: 8px;
        Glyph {
            data: root.icon;
            size: 15px;
            monochrome: true;
            ink: Theme.ink2;
            TouchArea { mouse-cursor: pointer; clicked => { root.icon-clicked(); } }
        }
        Text { horizontal-stretch: 0; vertical-alignment: center; text: root.label; font-size: Theme.fs(12); color: Theme.ink2; }
        if root.chip != "": Rectangle {
            horizontal-stretch: 0;
            y: -3px;
            height: 20px;
            width: cht.preferred-width + 3px + 11px + 14px;
            border-radius: 10px;
            background: cha.has-hover ? Theme.sel : Theme.hover;
            cht := Text { x: 7px; y: (parent.height - self.height) / 2; text: root.chip; font-size: Theme.fs(10.5); font-weight: 600; color: cha.has-hover ? Theme.ink : Theme.ink3; }
            Glyph { x: 7px + cht.preferred-width + 3px; y: (parent.height - 11px) / 2; data: Icons.chevron-right; size: 11px; monochrome: true; ink: Theme.ink3; }
            cha := TouchArea { mouse-cursor: pointer; clicked => { root.chip-clicked(); } }
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            horizontal-stretch: 0;
            vertical-alignment: center;
            text: root.value-text;
            font-size: Theme.fs(12);
            font-weight: 600;
            color: Theme.ink;
        }
    }
    FillSlider { value: root.value; moved(v) => { root.moved(v); } }
}

// AppMixer.qml's Level: a round badge, the name and what it plays, the
// percentage, and a slider.
component MixLevel inherits VerticalLayout {
    in property <string> title;
    in property <string> sub;
    in property <float> vol;
    in property <bool> muted;
    in property <string> pct;
    in property <bool> has-out;
    in property <string> out-label;
    in property <bool> has-eq;
    in property <bool> eq-on;
    callback badge-clicked();
    callback out-clicked();
    callback eq-clicked();
    callback moved(float);
    spacing: 7px;
    HorizontalLayout {
        height: 30px;
        spacing: 8px;
        Rectangle {
            horizontal-stretch: 0;
            width: 30px;
            height: 30px;
            border-radius: 15px;
            background: root.muted ? Theme.div : (ba.has-hover ? Theme.sel : Theme.hover);
            Glyph { x: 7.5px; y: 7.5px; data: root.muted ? Icons.volume-x : Icons.volume; size: 15px; monochrome: true; ink: Theme.ink2; }
            ba := TouchArea { mouse-cursor: pointer; clicked => { root.badge-clicked(); } }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text { text: root.title; overflow: elide; font-size: Theme.fs(12); font-weight: 600; color: Theme.ink; }
            if root.sub != "": Text { text: root.sub; overflow: elide; font-size: Theme.fs(10.5); color: Theme.ink3; }
        }
        // Where it plays: the next output, on a click.
        if root.has-out: VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            Rectangle {
                height: 22px;
                width: min(110px, ol.preferred-width + 30px);
                border-radius: 11px;
                background: oa.has-hover ? Theme.sel : transparent;
                border-width: 1px;
                border-color: Theme.rule;
                Glyph { x: 7px; y: 5px; data: Icons.volume; size: 12px; monochrome: true; ink: Theme.ink2; }
                ol := Text { x: 23px; width: parent.width - 31px; y: (parent.height - self.height) / 2; overflow: elide; text: root.out-label; font-size: Theme.fs(10.5); font-weight: 600; color: Theme.ink2; }
                oa := TouchArea { mouse-cursor: pointer; clicked => { root.out-clicked(); } }
            }
        }
        if root.has-eq: VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            Rectangle {
                height: 22px;
                width: eqt.preferred-width + 16px;
                border-radius: 11px;
                background: root.eq-on ? Theme.accent : (ea.has-hover ? Theme.sel : transparent);
                border-width: root.eq-on ? 0px : 1px;
                border-color: Theme.rule;
                eqt := Text { x: 8px; y: (parent.height - self.height) / 2; text: "EQ"; font-size: Theme.fs(10.5); font-weight: 600; color: root.eq-on ? Theme.ink-on-accent : Theme.ink3; }
                ea := TouchArea { mouse-cursor: pointer; clicked => { root.eq-clicked(); } }
            }
        }
        Text {
            horizontal-stretch: 0;
            width: 38px;
            vertical-alignment: center;
            horizontal-alignment: right;
            text: root.pct;
            font-size: Theme.fs(11.5);
            font-weight: 600;
            color: root.muted ? Theme.ink3 : Theme.ink;
        }
    }
    FillSlider { trough: 16px; opacity: root.muted ? 0.55 : 1; value: root.vol; moved(v) => { root.moved(v); } }
}

component ControlCenter inherits PanelSurface {
    // "" the tiles and sliders; "wifi" or "bluetooth" a list.
    in property <string> pane;
    in property <bool> wifi-on;
    in property <string> wifi-sub;
    in property <[WifiRow]> networks;
    // The network whose password is being asked for ("" for none), and
    // what went wrong last.
    in property <string> asking;
    in-out property <string> secret;
    in property <string> wifi-note;
    in property <bool> bt-on;
    in property <string> bt-sub;
    in property <[BtRow]> devices;
    // A device asking to pair: its name and the code ("" for none).
    in property <string> pair-name;
    in property <string> pair-code;
    callback show-pane(string);
    callback wifi(bool);
    callback bt(bool);
    callback join(string);
    callback join-secret(string, string);
    callback disconnect();
    callback forget(string);
    callback device(string);
    callback pair-answer(bool);
    in property <string> user;
    in property <string> session;
    in property <string> theme-mode;
    in property <[Tile]> tiles;
    in property <float> volume;
    in property <bool> muted;
    in property <bool> has-brightness;
    in property <float> brightness;
    in property <string> brightness-label;
    in property <bool> has-mic;
    in property <float> mic;
    in property <bool> mic-muted;
    in property <[MixRow]> mixer;
    in property <string> mixer-device;
    in property <string> mixer-sub;
    in property <string> mixer-chip;
    callback mix-set(int, float);
    callback mix-mute(int);
    callback mix-out(int);
    callback mix-eq(int);
    callback open-sound-settings();
    callback open-pane-settings(string);
    callback cycle-theme();
    callback tile(string);
    callback set-volume(float);
    callback toggle-mute();
    callback set-brightness(float);
    callback set-mic(float);
    callback toggle-mic();
    property <length> tile-w: (root.width - 24px - 12px) / 3;
    // One layout over the panes, so the panel takes the shown one's height.
    VerticalLayout {
    if root.pane == "mixer": VerticalLayout {
        // AppMixer.qml: back, the title, the output's level, then each app's.
        HorizontalLayout {
            height: 50px;
            padding-left: 10px;
            padding-right: 16px;
            spacing: 10px;
            Rectangle {
                y: 10px;
                width: 30px;
                height: 30px;
                horizontal-stretch: 0;
                border-radius: Theme.r-sm;
                background: mbk.has-hover ? Theme.hover : transparent;
                Glyph { x: 7.5px; y: 7.5px; data: Icons.chevron-left; size: 15px; monochrome: true; ink: Theme.ink2; }
                mbk := TouchArea { mouse-cursor: pointer; clicked => { root.show-pane(""); } }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text { text: "Volume mixer"; font-size: Theme.fs(13); font-weight: 600; color: Theme.ink; }
                Text { text: root.mixer-sub; overflow: elide; font-size: Theme.fs(11); color: Theme.ink3; }
            }
        }
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 4px;
            padding-bottom: 8px;
            spacing: 14px;
            MixLevel {
                title: root.mixer-device;
                sub: "";
                vol: root.volume;
                muted: root.muted;
                pct: root.muted ? "muted" : round(root.volume * 100) + "%";
                badge-clicked => { root.toggle-mute(); }
                moved(v) => { root.set-volume(v); }
            }
            if root.mixer.length > 0: Rectangle { height: 1px; background: Theme.rule; }
            Flickable {
                height: min(300px, mix-list.preferred-height);
                content-height: mix-list.preferred-height;
                mix-list := VerticalLayout {
                    spacing: 14px;
                    for m in root.mixer: MixLevel {
                        title: m.title;
                        sub: m.sub;
                        vol: m.vol;
                        muted: m.muted;
                        pct: m.pct;
                        has-out: m.has-out;
                        out-label: m.out-label;
                        has-eq: m.has-eq;
                        eq-on: m.eq-on;
                        badge-clicked => { root.mix-mute(m.index); }
                        out-clicked => { root.mix-out(m.index); }
                        eq-clicked => { root.mix-eq(m.index); }
                        moved(v) => { root.mix-set(m.index, v); }
                    }
                }
            }
            if root.mixer.length == 0: Text {
                wrap: word-wrap;
                text: "Apps show here while they play sound, each with its own level.";
                font-size: Theme.fs(11.5);
                color: Theme.ink3;
            }
        }
        Rectangle {
            height: 44px;
            Rectangle {
                x: parent.width - self.width - 12px;
                y: 9px;
                width: sl.preferred-width + 20px;
                height: 26px;
                border-radius: Theme.r-sm;
                background: sla.has-hover ? Theme.sel : transparent;
                sl := Text { x: 10px; y: (parent.height - self.height) / 2; text: "Sound settings"; font-size: Theme.fs(11); font-weight: 600; color: sla.has-hover ? Theme.ink : Theme.ink3; }
                sla := TouchArea { mouse-cursor: pointer; clicked => { root.open-sound-settings(); } }
            }
        }
    }
    if root.pane == "wifi": RadioPane {
        heading: "Wi-Fi";
        sub: root.wifi-sub;
        on: root.wifi-on;
        back => { root.show-pane(""); }
        toggled(v) => { root.wifi(v); }
        more => { root.open-pane-settings("Network"); }
        Flickable {
            height: min(list.preferred-height, 300px);
            content-height: list.preferred-height;
            list := VerticalLayout {
                padding: 6px;
                spacing: 2px;
                if !root.wifi-on: Text {
                    height: 56px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: "Wi-Fi is off";
                    font-size: Theme.fs(12);
                    color: Theme.ink3;
                }
                if root.wifi-on && root.networks.length == 0: Text {
                    height: 56px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: "Looking for networks…";
                    font-size: Theme.fs(12);
                    color: Theme.ink3;
                }
                for n in root.networks: VerticalLayout {
                    Rectangle {
                        height: 40px;
                        border-radius: Theme.r-sm;
                        background: n.active ? Theme.sel : (nt.has-hover ? Theme.hover : transparent);
                        nt := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { if (!n.active) { root.join(n.ssid); } }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right && n.saved) { root.forget(n.ssid); }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: 10px;
                            Bars { y: 13px; bars: n.bars; ink: n.active ? Theme.accent : Theme.ink2; }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 1px;
                                Text { text: n.ssid; overflow: elide; font-size: Theme.fs(12.5); font-weight: n.active ? 600 : 500; color: Theme.ink; }
                                Text {
                                    text: n.busy ? "connecting…" : n.active ? "connected" : n.saved ? "saved" : n.secure ? "secured" : "open";
                                    font-size: Theme.fs(10.5);
                                    font-weight: 400;
                                    color: n.active ? Theme.accent : Theme.ink3;
                                }
                            }
                            if n.secure: Glyph { y: 12px; data: Icons.lock; size: 14px; monochrome: true; ink: Theme.ink3; }
                            if n.active: Rectangle {
                                y: 7px;
                                height: 26px;
                                width: dl.preferred-width + 18px;
                                border-radius: Theme.r-sm;
                                background: dt.has-hover ? Theme.accent : Theme.hover;
                                dl := Text {
                                    x: 9px; y: (parent.height - self.height) / 2;
                                    text: "Disconnect";
                                    font-size: Theme.fs(11.5);
                                    font-weight: 600;
                                    color: dt.has-hover ? Theme.ink-on-accent : Theme.ink;
                                }
                                dt := TouchArea { mouse-cursor: pointer; clicked => { root.disconnect(); } }
                            }
                        }
                    }
                    // The password, under the network that asked for it.
                    if root.asking == n.ssid: HorizontalLayout {
                        padding: 6px;
                        padding-left: 36px;
                        spacing: 6px;
                        Rectangle {
                            height: 32px;
                            border-radius: Theme.r-sm;
                            background: Theme.hover;
                            border-width: pw.has-focus ? 2px : 1px;
                            border-color: pw.has-focus ? Theme.accent : Theme.edge;
                            FocusScope {
                                x: 10px;
                                width: parent.width - 20px;
                                pw := TextInput {
                                    height: 32px;
                                    vertical-alignment: center;
                                    input-type: InputType.password;
                                    text <=> root.secret;
                                    font-size: Theme.fs(12.5);
                                    color: Theme.ink;
                                    accepted => { root.join-secret(n.ssid, root.secret); }
                                    init => { self.focus(); }
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 0;
                            height: 32px;
                            width: jl.preferred-width + 22px;
                            border-radius: Theme.r-sm;
                            background: Theme.accent;
                            jl := Text {
                                x: 11px; y: (parent.height - self.height) / 2;
                                text: "Join";
                                font-size: Theme.fs(12);
                                font-weight: 600;
                                color: Theme.ink-on-accent;
                            }
                            TouchArea { mouse-cursor: pointer; clicked => { root.join-secret(n.ssid, root.secret); } }
                        }
                    }
                }
                if root.wifi-note != "": Text {
                    wrap: word-wrap;
                    text: root.wifi-note;
                    font-size: Theme.fs(11.5);
                    color: Theme.accent;
                }
            }
        }
    }
    if root.pane == "bluetooth": RadioPane {
        heading: "Bluetooth";
        sub: root.bt-sub;
        on: root.bt-on;
        back => { root.show-pane(""); }
        toggled(v) => { root.bt(v); }
        more => { root.open-pane-settings("Bluetooth"); }
        if root.pair-name != "": Rectangle {
            height: pv.preferred-height;
            background: Theme.hover;
            pv := VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    wrap: word-wrap;
                    text: root.pair-code != "" ? "Pair with " + root.pair-name + "? Check it shows " + root.pair-code + "." : "Pair with " + root.pair-name + "?";
                    font-size: Theme.fs(12.5);
                    color: Theme.ink;
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;
                    Rectangle {
                        height: 28px; width: rl.preferred-width + 20px; border-radius: Theme.r-sm;
                        background: Theme.sel;
                        rl := Text { x: 10px; y: (parent.height - self.height) / 2; text: "Cancel"; font-size: Theme.fs(12); font-weight: 600; color: Theme.ink; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.pair-answer(false); } }
                    }
                    Rectangle {
                        height: 28px; width: al.preferred-width + 20px; border-radius: Theme.r-sm;
                        background: Theme.accent;
                        al := Text { x: 10px; y: (parent.height - self.height) / 2; text: "Pair"; font-size: Theme.fs(12); font-weight: 600; color: Theme.ink-on-accent; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.pair-answer(true); } }
                    }
                }
            }
        }
        Flickable {
            height: min(blist.preferred-height, 300px);
            content-height: blist.preferred-height;
            blist := VerticalLayout {
                padding: 6px;
                spacing: 2px;
                if !root.bt-on: Text {
                    height: 56px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: "Bluetooth is off";
                    font-size: Theme.fs(12);
                    color: Theme.ink3;
                }
                if root.bt-on && root.devices.length == 0: Text {
                    height: 56px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: "Looking for devices…";
                    font-size: Theme.fs(12);
                    color: Theme.ink3;
                }
                for d in root.devices: Rectangle {
                    height: 40px;
                    border-radius: Theme.r-sm;
                    background: d.connected ? Theme.sel : (dt2.has-hover ? Theme.hover : transparent);
                    dt2 := TouchArea { mouse-cursor: pointer; clicked => { root.device(d.mac); } }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        Glyph {
                            y: 11px;
                            data: d.kind == "audio" ? Icons.headphones : d.kind == "input" ? Icons.keyboard : d.kind == "phone" ? Icons.bluetooth : Icons.bluetooth;
                            size: 17px;
                            monochrome: true;
                            ink: d.connected ? Theme.accent : Theme.ink2;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 1px;
                            Text { text: d.name; overflow: elide; font-size: Theme.fs(12.5); font-weight: d.connected ? 600 : 500; color: Theme.ink; }
                            Text {
                                text: d.busy ? "working…" : d.connected ? "connected" : d.paired ? "paired · click to connect" : "click to pair";
                                font-size: Theme.fs(10.5);
                                font-weight: 400;
                                color: d.connected ? Theme.accent : Theme.ink3;
                            }
                        }
                        if d.battery >= 0: Text {
                            horizontal-stretch: 0;
                            vertical-alignment: center;
                            text: d.battery + "%";
                            font-size: Theme.fs(11.5);
                            font-weight: 600;
                            color: Theme.ink2;
                        }
                    }
                }
            }
        }
    }
    if root.pane == "": VerticalLayout {
        HorizontalLayout {
            height: 62px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;
            Rectangle {
                y: 14px;
                width: 34px;
                height: 34px;
                border-radius: Theme.r-sm;
                background: Theme.accent;
                Glyph { x: 8px; y: 8px; data: Icons.user; size: 18px; monochrome: true; ink: Theme.ink-on-accent; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text { text: root.user; font-size: Theme.fs(13); font-weight: 600; color: Theme.ink; }
                Text { text: root.session; font-size: Theme.fs(11); font-weight: 400; color: Theme.ink3; }
            }
            Rectangle {
                y: 16px;
                height: 30px;
                width: chip.preferred-width + 24px;
                horizontal-stretch: 0;
                border-radius: 9px;
                background: ct.has-hover ? Theme.sel : Theme.hover;
                chip := HorizontalLayout {
                    x: 12px;
                    width: self.preferred-width;
                    spacing: 8px;
                    Glyph {
                        y: (30px - self.height) / 2;
                        data: root.theme-mode == "auto" ? Icons.sun-moon : (Theme.dark ? Icons.moon : Icons.sun);
                        size: 13px;
                    }
                    Text {
                        vertical-alignment: center;
                        text: root.theme-mode == "auto" ? "Auto" : (Theme.dark ? "Dark" : "Light");
                        font-size: Theme.fs(12);
                        font-weight: 600;
                        color: Theme.ink;
                    }
                }
                ct := TouchArea { mouse-cursor: pointer; clicked => { root.cycle-theme(); } }
            }
        }
        Rectangle {
            height: ceil(root.tiles.length / 3) * 94px + 6px;
            for t[i] in root.tiles: CcTile {
                x: 12px + mod(i, 3) * (root.tile-w + 6px);
                y: floor(i / 3) * 94px;
                width: root.tile-w;
                tile: t;
                activated => { root.tile(t.kind); }
                more => { root.show-pane(t.kind == "bluetooth" ? "bluetooth" : "wifi"); }
            }
        }
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 4px;
            padding-bottom: 16px;
            spacing: 14px;
            CcSlider {
                icon: root.muted || root.volume <= 0.001 ? Icons.volume-x : root.volume < 0.5 ? Icons.volume-low : Icons.volume;
                label: "Volume";
                chip: root.mixer-chip;
                chip-clicked => { root.show-pane("mixer"); }
                value-text: root.muted ? "muted" : round(root.volume * 100) + "%";
                value: root.volume;
                moved(v) => { root.set-volume(v); }
                icon-clicked => { root.toggle-mute(); }
            }
            if root.has-brightness: CcSlider {
                icon: Icons.sun;
                label: "Brightness";
                value-text: root.brightness-label;
                value: root.brightness;
                moved(v) => { root.set-brightness(v); }
            }
            if root.has-mic: CcSlider {
                icon: root.mic-muted ? Icons.mic-off : Icons.mic;
                label: "Microphone";
                value-text: root.mic-muted ? "muted" : round(root.mic * 100) + "%";
                value: root.mic;
                moved(v) => { root.set-mic(v); }
                icon-clicked => { root.toggle-mic(); }
            }
        }
    }
    }
}

// ── notifications (NotificationCenter.qml) ───────────────────────────────
export component NoteCard inherits Rectangle {
    in property <Note> note;
    in property <bool> toast;
    callback dismiss(int);
    callback act(int, string);
    border-radius: Theme.r-cap;
    background: toast ? Theme.panel : (h.has-hover ? Theme.sel : Theme.hover);
    border-width: toast ? 1px : 0px;
    border-color: Theme.edge;
    height: col.preferred-height;
    h := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.act(root.note.id, "default"); }
    }
    col := VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: Theme.r-sm;
                background: root.note.has-icon ? transparent : Theme.hover;
                clip: true;
                if root.note.has-icon: Image { width: 32px; height: 32px; source: root.note.icon; image-fit: contain; }
                if !root.note.has-icon: Glyph { x: 8px; y: 8px; data: Icons.bell; size: 16px; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        horizontal-stretch: 1;
                        text: root.note.app;
                        overflow: elide;
                        font-size: Theme.fs(11);
                        font-weight: 600;
                        color: root.note.urgent ? Theme.accent : Theme.ink3;
                    }
                    Text {
                        horizontal-stretch: 0;
                        text: root.note.time;
                        font-size: Theme.fs(11);
                        font-weight: 400;
                        color: Theme.ink3;
                    }
                }
                Text {
                    text: root.note.summary;
                    wrap: word-wrap;
                    font-size: Theme.fs(13);
                    font-weight: 600;
                    color: Theme.ink;
                }
                if root.note.body != "": Text {
                    text: root.note.body;
                    wrap: word-wrap;
                    max-height: 4 * Theme.fs(12) * 1.35;
                    overflow: elide;
                    font-size: Theme.fs(12);
                    font-weight: 400;
                    color: Theme.ink2;
                }
            }
            IconButton {
                y: 0;
                horizontal-stretch: 0;
                size: 22px;
                icon-size: 12px;
                icon: Icons.x;
                ink: Theme.ink2;
                activated => { root.dismiss(root.note.id); }
            }
        }
        if root.note.actions.length > 0: HorizontalLayout {
            padding-left: 42px;
            spacing: 6px;
            alignment: start;
            for a in root.note.actions: Rectangle {
                height: 26px;
                width: al.preferred-width + 20px;
                border-radius: Theme.r-sm;
                background: at.has-hover ? Theme.accent : Theme.sel;
                al := Text {
                    x: 10px;
                    y: (parent.height - self.height) / 2;
                    text: a.label;
                    font-size: Theme.fs(12);
                    font-weight: 600;
                    color: at.has-hover ? Theme.ink-on-accent : Theme.ink;
                }
                at := TouchArea { mouse-cursor: pointer; clicked => { root.act(root.note.id, a.key); } }
            }
        }
    }
}

component NotificationCenter inherits PanelSurface {
    in property <[Note]> notes;
    in property <bool> quiet;
    // History: kept by the daemon (nhist) when it is on.
    in property <bool> history-on;
    in property <[HistEntry]> hist;
    in property <int> hist-total;
    in-out property <string> view: "now";
    in-out property <string> hist-query;
    property <bool> in-history: root.view == "history" && root.history-on;
    property <bool> confirm-clear;
    callback dismiss(int);
    callback act(int, string);
    callback clear();
    callback toggle-dnd();
    callback open-settings();
    callback hist-search(string);
    callback hist-forget(int);
    callback hist-clear();
    callback view-changed(string);
    public function focus-search() { hq.focus(); }
    VerticalLayout {
        // NotificationCenter.qml: the tabs, then the buttons on the right.
        Rectangle {
            height: 52px;
            HorizontalLayout {
                x: 16px;
                height: parent.height;
                spacing: 14px;
                alignment: start;
                for tab in root.history-on ? ["now", "history"] : ["now"]: Text {
                    vertical-alignment: center;
                    text: tab == "now" ? "Notifications" : "History";
                    font-size: Theme.fs(13);
                    font-weight: 600;
                    color: (root.in-history ? "history" : "now") == tab || !root.history-on ? Theme.ink : (tt.has-hover ? Theme.ink2 : Theme.ink3);
                    tt := TouchArea { enabled: root.history-on; mouse-cursor: pointer; clicked => { root.view = tab; root.confirm-clear = false; root.view-changed(tab); } }
                }
            }
            HorizontalLayout {
                x: parent.width - self.width - 12px;
                y: 0;
                height: parent.height;
                alignment: end;
                spacing: 6px;
                Rectangle {
                    y: 12px;
                    height: 28px;
                    width: dnd.preferred-width + 20px;
                    horizontal-stretch: 0;
                    border-radius: 9px;
                    background: root.quiet ? Theme.accent : (dta.has-hover ? Theme.sel : Theme.hover);
                    dnd := HorizontalLayout {
                        x: 10px;
                        y: 0;
                        height: parent.height;
                        spacing: 7px;
                        VerticalLayout { alignment: center; Glyph { data: Icons.moon; size: 13px; monochrome: true; ink: root.quiet ? Theme.ink-on-accent : Theme.ink2; } }
                        Text { vertical-alignment: center; text: "Do not disturb"; font-size: Theme.fs(11); font-weight: 600; color: root.quiet ? Theme.ink-on-accent : Theme.ink2; }
                    }
                    dta := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-dnd(); } }
                }
                Rectangle {
                    y: 12px;
                    width: 28px;
                    height: 28px;
                    horizontal-stretch: 0;
                    border-radius: 9px;
                    background: gta.has-hover ? Theme.sel : Theme.hover;
                    Glyph { x: 7px; y: 7px; data: Icons.settings; size: 14px; monochrome: true; ink: Theme.ink2; }
                    gta := TouchArea { mouse-cursor: pointer; clicked => { root.open-settings(); } }
                }
                if (root.in-history ? root.hist-total > 0 : root.notes.length > 0): Rectangle {
                    y: 12px;
                    height: 28px;
                    width: cl.preferred-width + 20px;
                    horizontal-stretch: 0;
                    border-radius: 9px;
                    background: root.confirm-clear ? #d93a2b : (ctl.has-hover ? Theme.sel : Theme.hover);
                    cl := Text {
                        x: 10px;
                        y: (parent.height - self.height) / 2;
                        text: root.confirm-clear ? "Forget all " + root.hist-total + "?" : "Clear";
                        font-size: Theme.fs(11);
                        font-weight: 600;
                        color: root.confirm-clear ? white : Theme.ink2;
                    }
                    ctl := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (!root.in-history) { root.clear(); }
                            else if (!root.confirm-clear) { root.confirm-clear = true; }
                            else { root.confirm-clear = false; root.hist-clear(); }
                        }
                    }
                }
            }
        }
        // Now.
        if !root.in-history && root.notes.length == 0: Rectangle {
            height: 74px + 14px;
            Rectangle {
                x: 12px;
                width: parent.width - 24px;
                height: 74px;
                border-radius: Theme.r-cap;
                background: Theme.hover;
                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: root.quiet ? "Do not disturb — banners are quiet" : "No notifications";
                    font-size: Theme.fs(12);
                    color: Theme.ink3;
                }
            }
        }
        if !root.in-history && root.notes.length > 0: Flickable {
            height: min(list.preferred-height + 14px, 508px);
            content-height: list.preferred-height;
            list := VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-bottom: 14px;
                spacing: 6px;
                for n in root.notes: NoteCard {
                    note: n;
                    dismiss(id) => { root.dismiss(id); }
                    act(id, k) => { root.act(id, k); }
                }
            }
        }
        // History: a search box, then what was kept, by day.
        Rectangle {
            height: root.in-history ? 32px + 10px : 0px;
            visible: root.in-history;
            Rectangle {
                x: 12px;
                width: parent.width - 24px;
                height: 32px;
                border-radius: Theme.r-sm;
                background: Theme.sel;
                border-width: 1px;
                border-color: hq.has-focus ? Theme.accent : Theme.edge;
                Glyph { x: 10px; y: (parent.height - self.height) / 2; data: Icons.search; size: 14px; monochrome: true; ink: hq.has-focus ? Theme.accent : Theme.ink3; }
                FocusScope {
                    x: 32px;
                    width: parent.width - 42px;
                    hq := TextInput {
                        height: parent.height;
                        vertical-alignment: center;
                        text <=> root.hist-query;
                        font-size: Theme.fs(12);
                        color: Theme.ink;
                        selection-background-color: Theme.accent;
                        selection-foreground-color: Theme.ink-on-accent;
                        single-line: true;
                        edited => { root.hist-search(self.text); }
                    }
                    if root.hist-query == "": Text { y: (parent.height - self.height) / 2; text: "Search " + root.hist-total + " kept"; font-size: Theme.fs(12); color: Theme.ink3; }
                }
            }
        }
        if root.in-history && root.hist.length == 0: Rectangle {
            height: 74px + 14px;
            Rectangle {
                x: 12px;
                width: parent.width - 24px;
                height: 74px;
                border-radius: Theme.r-cap;
                background: Theme.hover;
                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: root.hist-query != "" ? "Nothing matches" : "Nothing kept yet";
                    font-size: Theme.fs(12);
                    color: Theme.ink3;
                }
            }
        }
        if root.in-history && root.hist.length > 0: Flickable {
            height: min(hlist.preferred-height + 14px, 460px);
            content-height: hlist.preferred-height;
            hlist := VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-bottom: 14px;
                spacing: 4px;
                for e[i] in root.hist: VerticalLayout {
                    spacing: 4px;
                    if e.show-day: Text {
                        text: e.day.to-uppercase();
                        font-size: Theme.fs(11);
                        font-weight: 600;
                        letter-spacing: 0.8px;
                        color: Theme.ink3;
                    }
                    Rectangle {
                        height: col.preferred-height + 18px;
                        border-radius: Theme.r-cap;
                        background: ea.has-hover ? Theme.sel : Theme.hover;
                        ea := TouchArea {}
                        if e.urgent: Rectangle { x: 6px; y: 6px; width: 2px; height: parent.height - 12px; border-radius: 1px; background: Theme.accent; }
                        Rectangle {
                            x: 12px;
                            y: 9px;
                            width: 26px;
                            height: 26px;
                            border-radius: 8px;
                            background: Theme.sel;
                            Glyph { x: 6.5px; y: 6.5px; data: Icons.bell; size: 13px; }
                        }
                        col := VerticalLayout {
                            x: 48px;
                            y: 9px;
                            width: parent.width - 48px - 34px;
                            spacing: 3px;
                            Text { text: e.head; overflow: elide; font-size: Theme.fs(11); color: Theme.ink3; }
                            if e.summary != "": Text { text: e.summary; overflow: elide; font-size: Theme.fs(12.5); font-weight: 600; color: Theme.ink; }
                            if e.body != "": Text { text: e.body; wrap: word-wrap; overflow: elide; max-height: 34px; font-size: Theme.fs(12); color: Theme.ink2; }
                        }
                        if ea.has-hover: Rectangle {
                            x: parent.width - 30px;
                            y: 8px;
                            width: 22px;
                            height: 22px;
                            border-radius: 7px;
                            background: fa.has-hover ? Theme.sel : transparent;
                            Glyph { x: 4.5px; y: 4.5px; data: Icons.x; size: 13px; monochrome: true; ink: Theme.ink3; }
                            fa := TouchArea { mouse-cursor: pointer; clicked => { root.hist-forget(e.id); } }
                        }
                    }
                }
            }
        }
    }
}

// ── what's playing (MediaPanel.qml, in short) ────────────────────────────
component MediaPanel inherits PanelSurface {
    in property <MediaInfo> media;
    callback prev();
    callback toggle();
    callback next();
    callback seek(float);
    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 72px;
                height: 72px;
                border-radius: Theme.r-sm;
                clip: true;
                background: Theme.hover;
                if root.media.has-art: Image { width: 72px; height: 72px; source: root.media.art; image-fit: cover; }
                if !root.media.has-art: Glyph { x: 22px; y: 22px; data: Icons.music; size: 28px; }
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                Text { text: root.media.title; overflow: elide; font-size: Theme.fs(14); font-weight: 600; color: Theme.ink; }
                Text { text: root.media.artist; overflow: elide; font-size: Theme.fs(12); color: Theme.ink2; }
                Text { text: root.media.player; overflow: elide; font-size: Theme.fs(11); font-weight: 400; color: Theme.ink3; }
            }
        }
        if root.media.has-length: VerticalLayout {
            spacing: 4px;
            Rectangle {
                height: 6px;
                border-radius: 3px;
                background: Theme.sel;
                Rectangle {
                    x: 0;
                    width: parent.width * root.media.progress;
                    border-radius: 3px;
                    background: Theme.accent;
                }
                TouchArea {
                    y: -6px;
                    height: 18px;
                    enabled: root.media.can-seek;
                    mouse-cursor: pointer;
                    clicked => { root.seek(self.mouse-x / self.width); }
                }
            }
            HorizontalLayout {
                Text { text: root.media.position; font-size: Theme.fs(11); font-weight: 400; color: Theme.ink3; }
                Text { horizontal-alignment: right; text: root.media.length; font-size: Theme.fs(11); font-weight: 400; color: Theme.ink3; }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 10px;
            IconButton { size: 34px; icon-size: 16px; icon: Icons.skip-back; enabled: root.media.can-prev; activated => { root.prev(); } }
            IconButton {
                size: 40px; icon-size: 18px; accent: true;
                icon: root.media.playing ? Icons.pause : Icons.play;
                enabled: root.media.can-toggle;
                activated => { root.toggle(); }
            }
            IconButton { size: 34px; icon-size: 16px; icon: Icons.skip-forward; enabled: root.media.can-next; activated => { root.next(); } }
        }
    }
}

// ── USB drives (DrivesPanel.qml) ─────────────────────────────────────────
component DrivesPanel inherits PanelSurface {
    in property <[DriveRow]> drives;
    callback open-mount(string);
    callback mount(string);
    callback eject(string);
    VerticalLayout {
        padding: 6px;
        padding-top: 12px;
        Caps { x: 8px; text: "DRIVES"; height: 24px; vertical-alignment: center; }
        for d in root.drives: Rectangle {
            height: 48px;
            border-radius: Theme.r-sm;
            background: dt.has-hover ? Theme.hover : transparent;
            dt := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (d.mounted) { root.open-mount(d.mount); } else { root.mount(d.part); }
                }
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;
                spacing: 10px;
                Glyph { y: 14px; data: Icons.drive; size: 18px; }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: d.name; overflow: elide; font-size: Theme.fs(12.5); font-weight: 600; color: Theme.ink; }
                    Text { text: d.detail; overflow: elide; font-size: Theme.fs(11); font-weight: 400; color: Theme.ink3; }
                }
                Rectangle {
                    y: 11px;
                    height: 26px;
                    width: el.preferred-width + 20px;
                    horizontal-stretch: 0;
                    border-radius: Theme.r-sm;
                    background: et.has-hover ? Theme.accent : Theme.sel;
                    el := Text {
                        x: 10px; y: (parent.height - self.height) / 2;
                        text: "Eject";
                        font-size: Theme.fs(12); font-weight: 600;
                        color: et.has-hover ? Theme.ink-on-accent : Theme.ink;
                    }
                    et := TouchArea { mouse-cursor: pointer; clicked => { root.eject(d.drive); } }
                }
            }
        }
    }
}

// ── timers, updates, privacy: a heading and rows ──────────────────────────
component TimersPanel inherits PanelSurface {
    in property <[TimerRow]> timers;
    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        Caps { text: "TIMERS"; }
        for t in root.timers: HorizontalLayout {
            height: 34px;
            spacing: 10px;
            Glyph { y: 8px; data: t.pomodoro ? Icons.pomodoro : Icons.timer; size: 18px; }
            Text { vertical-alignment: center; text: t.label; overflow: elide; font-size: Theme.fs(12.5); color: Theme.ink; }
            Text {
                horizontal-stretch: 0;
                vertical-alignment: center;
                text: t.left;
                font-size: Theme.fs(13);
                font-weight: 600;
                color: t.running ? Theme.ink : Theme.ink3;
            }
        }
    }
}

component UpdatesPanel inherits PanelSurface {
    in property <int> count;
    in property <[string]> packages;
    callback run();
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            Caps { vertical-alignment: center; text: "UPDATES"; }
            Text { horizontal-alignment: right; vertical-alignment: center; text: root.count + " waiting"; font-size: Theme.fs(11); color: Theme.ink3; }
        }
        VerticalLayout {
            spacing: 2px;
            for p in root.packages: Text { text: p; overflow: elide; font-size: Theme.fs(12); font-weight: 400; color: Theme.ink2; }
            if root.count > root.packages.length: Text {
                text: "and " + (root.count - root.packages.length) + " more";
                font-size: Theme.fs(12);
                color: Theme.ink3;
            }
        }
        Rectangle {
            height: 32px;
            border-radius: Theme.r-sm;
            background: ut.has-hover ? Theme.accent : Theme.sel;
            Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: "Install in a terminal";
                font-size: Theme.fs(12.5);
                font-weight: 600;
                color: ut.has-hover ? Theme.ink-on-accent : Theme.ink;
            }
            ut := TouchArea { mouse-cursor: pointer; clicked => { root.run(); } }
        }
    }
}

component PrivacyPanel inherits PanelSurface {
    in property <[PrivacyRow]> rows;
    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        Caps { text: "IN USE"; }
        for r in root.rows: HorizontalLayout {
            height: 30px;
            spacing: 10px;
            Rectangle {
                y: 4px;
                width: 22px; height: 22px; border-radius: 11px;
                background: Theme.accent;
                Glyph {
                    x: 4px; y: 4px; size: 14px; monochrome: true; ink: Theme.ink-on-accent;
                    data: r.kind == "mic" ? Icons.mic : r.kind == "camera" ? Icons.camera : Icons.monitor;
                }
            }
            Text {
                vertical-alignment: center;
                text: (r.kind == "mic" ? "Microphone" : r.kind == "camera" ? "Camera" : "Screen") + " · " + r.name;
                overflow: elide;
                font-size: Theme.fs(12.5);
                color: Theme.ink;
            }
        }
    }
}

// ── a tray item's menu (TrayMenu.qml) ────────────────────────────────────
component TrayMenu inherits PanelSurface {
    seam: false;
    in property <string> heading;
    in property <[MenuEntry]> entries;
    in property <bool> nested;
    in property <bool> toggles;
    callback pick(int, bool);
    callback back();
    VerticalLayout {
        padding: 6px;
        if root.nested: MenuRow { label: root.heading; icon: Icons.chevron-left; has-icon: true; activated => { root.back(); } }
        if root.nested: Rectangle { height: 5px; Rule { y: 2px; } }
        for e in root.entries: Rectangle {
            height: e.separator ? 9px : 29px;
            if e.separator: Rule { y: 4px; }
            if !e.separator: MenuRow {
                width: parent.width;
                label: e.label;
                enabled: e.enabled;
                hint: e.submenu ? "›" : "";
                // Every row keeps the check's place when any row can have
                // one, so the labels line up.
                has-icon: root.toggles;
                icon: e.toggle > 0 && e.checked ? Icons.check : {};
                activated => { root.pick(e.id, e.submenu); }
            }
        }
    }
}

export struct IconCell { name: string, glyph: GlyphData }

// Every glyph the shell has, to put one on a dock tile (IconPicker.qml).
component IconPicker inherits PanelSurface {
    in property <string> title;
    in property <string> current;
    in property <[IconCell]> cells;
    in-out property <string> query;
    callback edited(string);
    callback pick(string);
    public function focus-field() { field.focus(); }
    property <int> columns: 8;
    property <length> cell: 46px;
    property <length> grid-h: min(6 * root.cell, max(root.cell, ceil(root.cells.length / root.columns) * root.cell));
    preferred-width: root.columns * root.cell + 28px;
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        Text {
            height: 18px;
            text: root.title;
            overflow: elide;
            font-size: Theme.fs(13);
            font-weight: 600;
            color: Theme.ink;
        }
        Rectangle {
            height: 32px;
            border-radius: Theme.r-sm;
            background: Theme.sel;
            border-width: 1px;
            border-color: field.has-focus ? Theme.accent : Theme.edge;
            Glyph { x: 10px; y: (parent.height - self.height) / 2; data: Icons.search; size: 14px; monochrome: true; ink: field.has-focus ? Theme.accent : Theme.ink3; }
            FocusScope {
                x: 32px;
                width: parent.width - 42px;
                capture-key-pressed(e) => {
                    if (e.text == Key.Return && root.cells.length > 0) { root.pick(root.cells[0].name); return accept; }
                    reject
                }
                field := TextInput {
                    height: parent.height;
                    vertical-alignment: center;
                    text <=> root.query;
                    font-size: Theme.fs(12);
                    color: Theme.ink;
                    selection-background-color: Theme.accent;
                    selection-foreground-color: Theme.ink-on-accent;
                    single-line: true;
                    edited => { root.edited(self.text); }
                }
                if root.query == "": Text {
                    y: (parent.height - self.height) / 2;
                    text: "Search icons";
                    font-size: Theme.fs(12);
                    color: Theme.ink3;
                }
            }
        }
        Flickable {
            height: root.grid-h;
            content-height: ceil(root.cells.length / root.columns) * root.cell;
            interactive: self.content-height > self.height;
            for c[i] in root.cells: Rectangle {
                x: mod(i, root.columns) * root.cell;
                y: floor(i / root.columns) * root.cell;
                width: root.cell;
                height: root.cell;
                border-radius: Theme.r-sm;
                background: c.name == root.current ? Theme.sel : (ta.has-hover ? Theme.hover : transparent);
                if c.name == root.current: Rectangle { border-radius: Theme.r-sm; border-width: 1px; border-color: Theme.accent; }
                Glyph { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; data: c.glyph; size: 22px; ink: Theme.ink2; }
                ta := TouchArea { mouse-cursor: pointer; clicked => { root.pick(c.name); } }
            }
        }
        if root.cells.length == 0: Text {
            height: 30px;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: "No icon called that";
            font-size: Theme.fs(12);
            color: Theme.ink3;
        }
    }
}

export struct AppMenuRow { key: string, label: string, glyph: GlyphData, rule: bool, danger: bool }

// The dock's menu for a tile (AppMenu.qml with Apps.menuFor's rows).
component AppMenu inherits PanelSurface {
    in property <string> heading;
    in property <[AppMenuRow]> rows;
    callback pick(string);
    VerticalLayout {
        padding: 6px;
        for r in root.rows: VerticalLayout {
            if r.rule: Rectangle { height: 5px; Rule { y: 2px; } }
            MenuRow {
                label: r.label;
                icon: r.glyph;
                has-icon: true;
                danger: r.danger;
                row-height: 36px;
                activated => { root.pick(r.key); }
            }
        }
    }
}

export component Panels inherits Window {
    // Which is open: power, window, calendar, control, notifications,
    // media, drives, timers, updates, privacy, tray; "" while closing.
    in property <string> which;
    in property <length> anchor;
    in property <length> top: 50px;
    in property <float> sx: 1;
    in property <float> sy: 1;
    in property <length> lift;
    in property <float> glass: 1;
    in property <float> inner: 1;
    callback dismiss();

    // power
    in property <string> user;
    in property <string> uptime;
    in property <string> hyprland;
    callback power(string);
    // window
    callback window-act(string);
    callback window-snap(int);
    // calendar
    in property <string> month;
    in property <[DayCell]> cells;
    in property <bool> month-away;
    callback month-step(int);
    callback month-reset();
    // control center
    in property <string> session;
    in property <string> theme-mode;
    // the control center's Wi-Fi and Bluetooth lists
    in property <string> cc-pane;
    in property <bool> wifi-on;
    in property <string> wifi-sub;
    in property <[WifiRow]> networks;
    in property <string> asking;
    in-out property <string> secret;
    in property <string> wifi-note;
    in property <bool> bt-on;
    in property <string> bt-sub;
    in property <[BtRow]> devices;
    in property <string> pair-name;
    in property <string> pair-code;
    in property <[MixRow]> mixer;
    in property <string> mixer-device;
    in property <string> mixer-sub;
    in property <string> mixer-chip;
    callback mix-set(int, float);
    callback mix-mute(int);
    callback mix-out(int);
    callback mix-eq(int);
    callback open-sound-settings();
    callback open-pane-settings(string);
    callback show-pane(string);
    callback wifi(bool);
    callback bt(bool);
    callback join(string);
    callback join-secret(string, string);
    callback disconnect();
    callback forget(string);
    callback device(string);
    callback pair-answer(bool);
    in property <[Tile]> tiles;
    in property <float> volume;
    in property <bool> muted;
    in property <bool> has-brightness;
    in property <float> brightness;
    in property <string> brightness-label;
    in property <bool> has-mic;
    in property <float> mic;
    in property <bool> mic-muted;
    callback cycle-theme();
    callback tile(string);
    callback set-volume(float);
    callback toggle-mute();
    callback set-brightness(float);
    callback set-mic(float);
    callback toggle-mic();
    // notifications
    in property <[Note]> notes;
    in property <bool> quiet;
    callback note-dismiss(int);
    callback note-act(int, string);
    callback notes-clear();
    callback toggle-dnd();
    callback open-notif-settings();
    // notification history
    in property <bool> history-on;
    in property <[HistEntry]> hist;
    in property <int> hist-total;
    in-out property <string> hist-query;
    in-out property <string> nc-view: "now";
    callback hist-search(string);
    callback hist-forget(int);
    callback hist-clear();
    callback nc-view-changed(string);
    public function focus-history() { nc.focus-search(); }
    // media
    in property <MediaInfo> media;
    callback media-prev();
    callback media-toggle();
    callback media-next();
    callback media-seek(float);
    // drives, timers, updates, privacy
    in property <[DriveRow]> drives;
    callback drive-open(string);
    callback drive-mount(string);
    callback drive-eject(string);
    in property <[TimerRow]> timers;
    in property <int> update-count;
    in property <[string]> update-names;
    callback run-updates();
    in property <[PrivacyRow]> privacy;
    // tray menu
    in property <string> menu-heading;
    in property <[MenuEntry]> menu;
    in property <bool> menu-nested;
    in property <bool> menu-toggles;
    callback menu-pick(int, bool);
    callback menu-back();
    // the dock's menu
    in property <string> app-menu-heading;
    in property <[AppMenuRow]> app-menu;
    in property <length> dock-gap: 80px;
    in property <length> dock-left: -1px;
    in property <length> dock-point: -1px;
    callback app-menu-pick(string);
    // the icon picker
    in property <string> icon-title;
    in property <string> icon-current;
    in property <[IconCell]> icon-cells;
    in-out property <string> icon-query;
    callback icon-edited(string);
    callback icon-pick(string);
    public function focus-icons() { icons.focus-field(); }

    background: transparent;
    default-font-family: Theme.font;
    default-font-weight: 500;
    default-font-size: Theme.fs(12);

    // The click-away catcher.
    TouchArea {
        clicked => { root.dismiss(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) { root.dismiss(); }
        }
    }

    Drop {
        shown: root.which == "power"; anchor: root.anchor; top: root.top; screen-width: root.width; sx: root.sx; sy: root.sy; lift: root.lift; glass: root.glass; inner: root.inner; panel-width: 248px;
        PowerMenu { user: root.user; uptime: root.uptime; hyprland: root.hyprland; act(a) => { root.power(a); } }
    }
    Drop {
        shown: root.which == "window"; seam: false; anchor: root.anchor; top: root.top; screen-width: root.width; sx: root.sx; sy: root.sy; lift: root.lift; glass: root.glass; inner: root.inner; panel-width: 262px;
        WindowMenu { act(a) => { root.window-act(a); } snap(i) => { root.window-snap(i); } }
    }
    Drop {
        shown: root.which == "calendar"; anchor: root.anchor; top: root.top; screen-width: root.width; sx: root.sx; sy: root.sy; lift: root.lift; glass: root.glass; inner: root.inner; panel-width: 320px;
        CalendarPanel {
            month: root.month; cells: root.cells; away: root.month-away;
            step(d) => { root.month-step(d); }
            reset => { root.month-reset(); }
        }
    }
    Drop {
        shown: root.which == "control"; anchor: root.anchor; top: root.top; screen-width: root.width; sx: root.sx; sy: root.sy; lift: root.lift; glass: root.glass; inner: root.inner; panel-width: 384px;
        ControlCenter {
            user: root.user; session: root.session; theme-mode: root.theme-mode; tiles: root.tiles;
            volume: root.volume; muted: root.muted;
            has-brightness: root.has-brightness; brightness: root.brightness; brightness-label: root.brightness-label;
            has-mic: root.has-mic; mic: root.mic; mic-muted: root.mic-muted;
            cycle-theme => { root.cycle-theme(); }
            tile(k) => { root.tile(k); }
            pane: root.cc-pane;
            wifi-on: root.wifi-on; wifi-sub: root.wifi-sub; networks: root.networks;
            asking: root.asking; secret <=> root.secret; wifi-note: root.wifi-note;
            bt-on: root.bt-on; bt-sub: root.bt-sub; devices: root.devices;
            pair-name: root.pair-name; pair-code: root.pair-code;
            show-pane(p) => { root.show-pane(p); }
            mixer: root.mixer; mixer-device: root.mixer-device; mixer-sub: root.mixer-sub; mixer-chip: root.mixer-chip;
            mix-set(i, v) => { root.mix-set(i, v); }
            mix-mute(i) => { root.mix-mute(i); }
            mix-out(i) => { root.mix-out(i); }
            mix-eq(i) => { root.mix-eq(i); }
            open-sound-settings => { root.open-sound-settings(); }
            open-pane-settings(p) => { root.open-pane-settings(p); }
            wifi(v) => { root.wifi(v); }
            bt(v) => { root.bt(v); }
            join(n) => { root.join(n); }
            join-secret(n, s) => { root.join-secret(n, s); }
            disconnect => { root.disconnect(); }
            forget(n) => { root.forget(n); }
            device(m) => { root.device(m); }
            pair-answer(a) => { root.pair-answer(a); }
            set-volume(v) => { root.set-volume(v); }
            toggle-mute => { root.toggle-mute(); }
            set-brightness(v) => { root.set-brightness(v); }
            set-mic(v) => { root.set-mic(v); }
            toggle-mic => { root.toggle-mic(); }
        }
    }
    Drop {
        shown: root.which == "notifications"; anchor: root.anchor; top: root.top; screen-width: root.width; sx: root.sx; sy: root.sy; lift: root.lift; glass: root.glass; inner: root.inner; panel-width: 396px;
        nc := NotificationCenter {
            notes: root.notes; quiet: root.quiet;
            history-on: root.history-on; hist: root.hist; hist-total: root.hist-total; hist-query <=> root.hist-query; view <=> root.nc-view;
            hist-search(q) => { root.hist-search(q); }
            hist-forget(id) => { root.hist-forget(id); }
            hist-clear => { root.hist-clear(); }
            view-changed(v) => { root.nc-view-changed(v); }
            dismiss(id) => { root.note-dismiss(id); }
            act(id, k) => { root.note-act(id, k); }
            clear => { root.notes-clear(); }
            toggle-dnd => { root.toggle-dnd(); }
            open-settings => { root.open-notif-settings(); }
        }
    }
    Drop {
        shown: root.which == "media"; anchor: root.anchor; top: root.top; screen-width: root.width; sx: root.sx; sy: root.sy; lift: root.lift; glass: root.glass; inner: root.inner; panel-width: 340px;
        MediaPanel {
            media: root.media;
            prev => { root.media-prev(); }
            toggle => { root.media-toggle(); }
            next => { root.media-next(); }
            seek(f) => { root.media-seek(f); }
        }
    }
    Drop {
        shown: root.which == "drives"; anchor: root.anchor; top: root.top; screen-width: root.width; sx: root.sx; sy: root.sy; lift: root.lift; glass: root.glass; inner: root.inner; panel-width: 300px;
        DrivesPanel {
            drives: root.drives;
            open-mount(m) => { root.drive-open(m); }
            mount(p) => { root.drive-mount(p); }
            eject(d) => { root.drive-eject(d); }
        }
    }
    Drop {
        shown: root.which == "timers"; anchor: root.anchor; top: root.top; screen-width: root.width; sx: root.sx; sy: root.sy; lift: root.lift; glass: root.glass; inner: root.inner; panel-width: 280px;
        TimersPanel { timers: root.timers; }
    }
    Drop {
        shown: root.which == "updates"; anchor: root.anchor; top: root.top; screen-width: root.width; sx: root.sx; sy: root.sy; lift: root.lift; glass: root.glass; inner: root.inner; panel-width: 300px;
        UpdatesPanel { count: root.update-count; packages: root.update-names; run => { root.run-updates(); } }
    }
    Drop {
        shown: root.which == "privacy"; anchor: root.anchor; top: root.top; screen-width: root.width; sx: root.sx; sy: root.sy; lift: root.lift; glass: root.glass; inner: root.inner; panel-width: 280px;
        PrivacyPanel { rows: root.privacy; }
    }
    Drop {
        shown: root.which == "appmenu"; seam: false; from-bottom: true; bottom: root.dock-gap; screen-height: root.height; left-edge: root.dock-left; point-y: root.dock-point;
        anchor: root.anchor; top: root.top; screen-width: root.width; sx: root.sx; sy: root.sy; lift: root.lift; glass: root.glass; inner: root.inner;
        panel-width: 230px;
        AppMenu { heading: root.app-menu-heading; rows: root.app-menu; pick(k) => { root.app-menu-pick(k); } }
    }
    Drop {
        shown: root.which == "iconpick"; seam: false; from-bottom: true; bottom: root.dock-gap; screen-height: root.height; left-edge: root.dock-left; point-y: root.dock-point;
        anchor: root.anchor; top: root.top; screen-width: root.width; sx: root.sx; sy: root.sy; lift: root.lift; glass: root.glass; inner: root.inner;
        panel-width: 396px;
        icons := IconPicker {
            title: root.icon-title; current: root.icon-current; cells: root.icon-cells; query <=> root.icon-query;
            edited(q) => { root.icon-edited(q); }
            pick(n) => { root.icon-pick(n); }
        }
    }
    Drop {
        shown: root.which == "tray"; seam: false; anchor: root.anchor; top: root.top; screen-width: root.width; sx: root.sx; sy: root.sy; lift: root.lift; glass: root.glass; inner: root.inner; panel-width: 240px;
        TrayMenu {
            heading: root.menu-heading; entries: root.menu; nested: root.menu-nested; toggles: root.menu-toggles;
            pick(id, sub) => { root.menu-pick(id, sub); }
            back => { root.menu-back(); }
        }
    }
}
