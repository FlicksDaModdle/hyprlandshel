import { Icons, GlyphData } from "icons.slint";
import { Theme } from "theme.slint";
import { Glyph } from "glyph.slint";
import { BarButton, IconButton } from "widgets.slint";
import { Workspace, MediaInfo, TrayItem, AppTop, BarModule, EditSlot } from "types.slint";

// modules/bar/Workspaces.qml: a recessed capsule of pills. The focused one
// (or the one under the pointer, or an urgent one) opens out to show its
// number; the rest are a dot when they hold windows, a ring when empty.
component Workspaces inherits Rectangle {
    in property <[Workspace]> slots;
    callback go(int);
    callback step(int);
    property <int> hovered-id: -1;
    height: Theme.w(22) + Theme.w(1) * 2;
    width: group.preferred-width + Theme.w(3) * 2;
    border-radius: Theme.r-cap;
    background: Theme.hover;
    border-width: 1px;
    border-color: Theme.rule;

    TouchArea {
        scroll-event(e) => { root.step(e.delta-y > 0 ? -1 : 1); accept }
    }

    group := HorizontalLayout {
        x: (parent.width - self.preferred-width) / 2;
        y: (parent.height - Theme.w(22)) / 2;
        width: self.preferred-width;
        height: Theme.w(22);
        spacing: 3px;
        for s in root.slots: Rectangle {
            property <bool> hovered: root.hovered-id == s.id;
            property <bool> expanded: s.focused || self.hovered || s.urgent;
            width: Theme.w(self.expanded ? 26 : 16);
            height: Theme.w(22);
            animate width { duration: 310ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1.15); }
            border-radius: min(Theme.r-cap, self.height / 2);
            background: s.focused ? Theme.accent : (self.hovered ? Theme.sel : transparent);
            animate background { duration: 200ms; }

            Text {
                visible: parent.expanded;
                opacity: parent.expanded ? 1 : 0;
                animate opacity { duration: 140ms; }
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: s.id;
                font-size: Theme.fs(Theme.w(11) / 1px);
                font-weight: 700;
                letter-spacing: 0.2px;
                color: s.focused ? Theme.ink-on-accent : (s.urgent ? Theme.accent : Theme.ink2);
            }
            Rectangle {
                visible: !parent.expanded;
                width: Theme.w(s.occupied ? 7 : 5);
                animate width { duration: 220ms; }
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 2.5px;
                background: s.occupied ? Theme.ink2 : transparent;
                border-width: s.occupied ? 0 : 1.5px;
                border-color: Theme.div;
            }
            TouchArea {
                mouse-cursor: pointer;
                changed has-hover => {
                    if (self.has-hover) { root.hovered-id = s.id; }
                    else if (root.hovered-id == s.id) { root.hovered-id = -1; }
                }
                clicked => { root.go(s.id); }
            }
        }
    }
}

// modules/bar/MediaPill.qml: what's playing, centred on the bar. Gives up
// its text, then itself, rather than run under either side.
component MediaPill inherits Rectangle {
    in property <MediaInfo> media;
    in property <length> room: 400px;
    in property <int> eq-tick;
    callback prev();
    callback toggle();
    callback next();
    callback seek(float);
    in property <bool> open;
    callback opened(length);
    property <length> text-room: max(0px, min(Theme.u(168), root.room - Theme.u(151)));
    property <bool> show-text: self.text-room >= Theme.u(70);
    property <length> min-pill: Theme.u(148);
    visible: media.available && root.room >= self.min-pill;
    height: Theme.u(30);
    width: content.preferred-width + Theme.u(8);
    border-radius: Theme.r-cap;
    background: hover.has-hover || root.open ? Theme.hover : transparent;

    // The whole pill is the media panel's button; the controls on top of
    // it take their own clicks.
    hover := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.opened(root.absolute-position.x + root.width / 2); }
    }

    content := HorizontalLayout {
        x: Theme.u(4);
        width: self.preferred-width;
        spacing: Theme.u(9);
        alignment: start;

        // Album art, or the music glyph on a tile when there's none.
        Rectangle {
            y: (root.height - self.height) / 2;
            width: Theme.u(22);
            height: Theme.u(22);
            border-radius: Theme.r-sm;
            clip: true;
            background: Theme.hover;
            if root.media.has-art: Image {
                width: parent.width;
                height: parent.height;
                source: root.media.art;
                image-fit: cover;
            }
            if !root.media.has-art: Glyph {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                data: Icons.music;
                size: Theme.u(13);
            }
        }

        if root.show-text: VerticalLayout {
            width: root.text-room;
            alignment: center;
            spacing: Theme.u(3);
            Text {
                text: root.media.title;
                overflow: elide;
                font-size: Theme.fs(Theme.u(11.5) / 1px);
                font-weight: 600;
                color: Theme.ink;
            }
            if root.media.artist != "": Text {
                text: root.media.artist;
                overflow: elide;
                font-size: Theme.fs(Theme.u(10) / 1px);
                font-weight: 500;
                color: Theme.ink3;
            }
        }

        // The little equaliser: four bars rising and falling while it plays.
        HorizontalLayout {
            y: (root.height - Theme.u(12)) / 2;
            height: Theme.u(12);
            spacing: Theme.u(2);
            alignment: center;
            for i in 4: Rectangle {
                property <float> period: 2 * (380 + i * 65);
                property <float> t: root.eq-tick * 83 - i * 90;
                property <float> phase: (mod(mod(self.t, self.period) + self.period, self.period)) / self.period;
                property <float> level: root.media.playing ? 0.28 + 0.72 * (0.5 - 0.5 * cos(self.phase * 360deg)) : 0.28;
                width: Theme.u(2);
                Rectangle {
                    y: parent.height - self.height;
                    width: parent.width;
                    height: max(1px, round(Theme.u(12) * parent.level / 1px) * 1px);
                    border-radius: self.width / 2;
                    background: i == 1 ? Theme.accent : Theme.ink3;
                }
            }
        }

        Rectangle {
            y: (root.height - self.height) / 2;
            width: 1px;
            height: Theme.u(16);
            background: Theme.div;
        }

        HorizontalLayout {
            spacing: Theme.u(1);
            alignment: center;
            IconButton {
                y: (root.height - self.height) / 2;
                size: Theme.u(22); icon-size: Theme.u(13);
                icon: Icons.skip-back; enabled: root.media.can-prev;
                activated => { root.prev(); }
            }
            IconButton {
                y: (root.height - self.height) / 2;
                size: Theme.u(24); icon-size: Theme.u(13);
                icon: root.media.playing ? Icons.pause : Icons.play; accent: true; enabled: root.media.can-toggle;
                activated => { root.toggle(); }
            }
            IconButton {
                y: (root.height - self.height) / 2;
                size: Theme.u(22); icon-size: Theme.u(13);
                icon: Icons.skip-forward; enabled: root.media.can-next;
                activated => { root.next(); }
            }
        }
    }

    // The seek line, under the pill along the bar's bottom edge; click or
    // drag along it, and it seeks where it is let go.
    property <float> drag-at;
    if root.media.has-length: Rectangle {
        x: Theme.u(4);
        width: root.width - Theme.u(8);
        y: root.height + Theme.u(5) - 2px;
        height: 2px;
        border-radius: 1px;
        background: Theme.div;
        Rectangle {
            x: 0;
            width: round(parent.width * (seek.pressed ? root.drag-at : root.media.progress) / 1px) * 1px;
            height: parent.height;
            border-radius: 1px;
            background: Theme.accent;
        }
        seek := TouchArea {
            y: -Theme.u(5);
            height: parent.height + Theme.u(5);
            enabled: root.media.can-seek;
            mouse-cursor: pointer;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) { root.drag-at = clamp(self.mouse-x / self.width, 0, 1); }
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) { root.seek(root.drag-at); }
            }
            moved => { if (self.pressed) { root.drag-at = clamp(self.mouse-x / self.width, 0, 1); } }
        }
    }
}

// modules/bar/Bar.qml.
// The status area (Bar.qml's right end; in taskbar mode, TaskbarTray.qml at the taskbar's): tray,
// recording / privacy / timer / updates / mail / drives, network and sound, clock, notifications, power.
export component BarRight inherits HorizontalLayout {
    in property <string> time;
    in property <string> date;
    in property <string> net-label;
    in property <string> net-icon: "wifi";
    in property <string> volume-label;
    in property <string> volume-icon: "volume";
    in property <int> battery: -1;
    in property <bool> charging;
    in property <int> notifications;
    in property <bool> quiet;
    in property <string> open-panel;
    in property <[TrayItem]> tray;
    in property <bool> show-tray: true;
    in property <bool> tray-open;
    in property <bool> mic-in-use;
    in property <bool> camera-in-use;
    in property <bool> screen-shared;
    in property <bool> has-timer;
    in property <string> timer-text;
    in property <bool> timer-running;
    in property <bool> timer-pomodoro;
    in property <int> updates;
    in property <bool> show-updates;
    in property <int> mail-unread: -1;
    in property <bool> has-drives;
    callback volume-step(int);
    callback toggle-panel(string, length);
    callback toggle-dnd();
    callback open-mail();
    callback tray-toggle();
    callback tray-activate(string, length);
    callback tray-secondary(string);
    callback tray-menu(string, length);
    callback tray-scroll(string, int);
    // The modules, in order, as the bar's layout has them (barmods.rs), and a
    // plugin's clicks.
    in property <[BarModule]> modules;
    callback plugin-click(string, length);
    callback plugin-secondary(string);
    callback plugin-scroll(string, int);
    callback module-width(string, length);
    spacing: 2px;
    alignment: end;

    // Each module in the order the bar's layout gives (barmods.rs); only the ones that are there.
    for m in root.modules: HorizontalLayout {
        changed width => { root.module-width(m.id, self.width); }
            // The tray (TrayRow.qml): a chevron, the items when open, a divider.
        if m.id == "tray" && (root.show-tray && root.tray.length > 0): HorizontalLayout {
            spacing: 2px;
            Rectangle {
                y: (root.height - 26px) / 2;
                width: 22px;
                height: 26px;
                border-radius: Theme.r-cap;
                background: chev.has-hover ? Theme.hover : transparent;
                Glyph {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    data: root.tray-open ? Icons.chevron-right : Icons.chevron-left;
                    size: Theme.u(Theme.bar-icon);
               
                    ink: root.tray-open ? Theme.ink2 : Theme.ink;
                }
                chev := TouchArea { mouse-cursor: pointer; clicked => { root.tray-toggle(); } }
            }
            if root.tray-open: HorizontalLayout {
                spacing: 2px;
                for item in root.tray: Rectangle {
                    y: (root.height - 26px) / 2;
                    width: 26px;
                    height: 26px;
                    border-radius: Theme.r-cap;
                    background: ta.has-hover ? Theme.hover : transparent;
                    opacity: item.passive ? 0.55 : 1;
                    if item.has-icon: Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 15px;
                        height: 15px;
                        source: item.icon;
                        image-fit: contain;
                    }
                    if !item.has-icon: Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: item.letter;
                        font-size: Theme.fs(11);
                        font-weight: 700;
                        color: Theme.ink2;
                    }
                    ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.tray-activate(item.key, parent.absolute-position.x + parent.width / 2); }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                                root.tray-menu(item.key, parent.absolute-position.x + parent.width / 2);
                            }
                            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.middle) {
                                root.tray-secondary(item.key);
                            }
                        }
                        scroll-event(e) => { root.tray-scroll(item.key, e.delta-y > 0 ? 1 : -1); accept }
                    }
                }
            }
            Rectangle {
                width: 13px;
                Rectangle {
                    x: 6px;
                    y: (root.height - 18px) / 2;
                    width: 1px;
                    height: 18px;
                    background: Theme.div;
                }
            }
        }

        // Privacy: who has the microphone, the camera, the screen.
        if m.id == "privacy" && (root.mic-in-use || root.camera-in-use || root.screen-shared): BarButton {
            y: (root.height - self.height) / 2;
            gap: 3px;
            open: root.open-panel == "privacy";
            activated(x) => { root.toggle-panel("privacy", x); }
            if root.mic-in-use: Rectangle {
                y: (26px - self.height) / 2;
                width: Theme.u(Theme.bar-icon) + 8px; height: self.width; border-radius: self.width / 2;
                background: Theme.accent;
                Glyph { x: 4px; y: 4px; data: Icons.mic; size: Theme.u(Theme.bar-icon) - 2px; monochrome: true; ink: Theme.ink-on-accent; }
            }
            if root.camera-in-use: Rectangle {
                y: (26px - self.height) / 2;
                width: Theme.u(Theme.bar-icon) + 8px; height: self.width; border-radius: self.width / 2;
                background: Theme.accent;
                Glyph { x: 4px; y: 4px; data: Icons.camera; size: Theme.u(Theme.bar-icon) - 2px; monochrome: true; ink: Theme.ink-on-accent; }
            }
            if root.screen-shared: Rectangle {
                y: (26px - self.height) / 2;
                width: Theme.u(Theme.bar-icon) + 8px; height: self.width; border-radius: self.width / 2;
                background: Theme.accent;
                Glyph { x: 4px; y: 4px; data: Icons.monitor; size: Theme.u(Theme.bar-icon) - 2px; monochrome: true; ink: Theme.ink-on-accent; }
            }
        }

        // Timers: the soonest countdown.
        if m.id == "timers" && (root.has-timer): BarButton {
            y: (root.height - self.height) / 2;
            gap: 6px;
            open: root.open-panel == "timers";
            activated(x) => { root.toggle-panel("timers", x); }
            Glyph {
                y: (26px - self.height) / 2;
                data: root.timer-pomodoro ? Icons.pomodoro : Icons.timer;
                size: Theme.u(Theme.bar-icon);
            }
            Text {
                vertical-alignment: center;
                text: root.timer-text;
                font-weight: 600;
                color: root.timer-running ? Theme.ink : Theme.ink3;
            }
        }

        // Updates waiting.
        if m.id == "updates" && (root.show-updates && root.updates > 0): BarButton {
            y: (root.height - self.height) / 2;
            gap: 5px;
            open: root.open-panel == "updates";
            activated(x) => { root.toggle-panel("updates", x); }
            Glyph { y: (26px - self.height) / 2; data: Icons.package; size: Theme.u(Theme.bar-icon); }
            Text { vertical-alignment: center; text: root.updates; font-weight: 600; color: Theme.ink; }
        }

        // Mail, while it runs: unread count.
        if m.id == "mail" && (root.mail-unread >= 0): BarButton {
            y: (root.height - self.height) / 2;
            gap: 5px;
            activated => { root.open-mail(); }
            Glyph {
                y: (26px - self.height) / 2;
                data: Icons.mail;
                size: Theme.u(Theme.bar-icon);
                accent: root.mail-unread > 0 ? Theme.accent : Theme.ink;
            }
            if root.mail-unread > 0: Text {
                vertical-alignment: center;
                text: root.mail-unread > 99 ? "99+" : root.mail-unread;
                font-weight: 600;
                color: Theme.ink;
            }
        }

        // USB drives plugged in.
        if m.id == "drives" && (root.has-drives): BarButton {
            y: (root.height - self.height) / 2;
            open: root.open-panel == "drives";
            activated(x) => { root.toggle-panel("drives", x); }
            Glyph { y: (26px - self.height) / 2; data: Icons.drive; size: Theme.u(Theme.bar-icon); }
        }

        // Notifications
        if m.id == "notifications": BarButton {
            y: (root.height - self.height) / 2;
            open: root.open-panel == "notifications";
            activated(x) => { root.toggle-panel("notifications", x); }
            secondary => { root.toggle-dnd(); }
            gap: 7px;
            Glyph {
                y: (26px - self.height) / 2;
                data: root.quiet ? Icons.bell-off : Icons.bell;
                size: Theme.u(Theme.bar-icon);
           
                ink: root.quiet ? Theme.ink3 : Theme.ink;
            }
            if Theme.badges && root.notifications > 0: Rectangle {
                y: (26px - self.height) / 2;
                width: max(17px, badge.preferred-width + 10px);
                height: 17px;
                border-radius: 9px;
                background: Theme.accent;
                badge := Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: root.notifications;
                    font-size: Theme.fs(Theme.u(Theme.bar-badge) / 1px);
                    font-weight: 700;
                    color: Theme.ink-on-accent;
                }
            }
        }

        // Status capsule → control center
        if m.id == "status": BarButton {
            y: (root.height - self.height) / 2;
            gap: 13px;
            pad: 12px;
            open: root.open-panel == "control";
            activated(x) => { root.toggle-panel("control", x); }
            scrolled(d) => { root.volume-step(d); }

            HorizontalLayout {
                spacing: 6px;
                Glyph {
                    y: (26px - self.height) / 2;
                    data: root.net-icon == "wifi-off" ? Icons.wifi-off : Icons.wifi;
                    size: Theme.u(Theme.bar-icon);
               
                }
                if root.net-label != "": Text {
                    vertical-alignment: center;
                    text: root.net-label;
                    color: Theme.ink2;
                    overflow: elide;
                    max-width: 120px;
                }
            }

            if root.volume-label != "": HorizontalLayout {
                spacing: 6px;
                Glyph {
                    y: (26px - self.height) / 2;
                    data: root.volume-icon == "volume-x" ? Icons.volume-x : root.volume-icon == "volume-low" ? Icons.volume-low : Icons.volume;
                    size: Theme.u(Theme.bar-icon);
               
                }
                Text {
                    vertical-alignment: center;
                    text: root.volume-label;
                    font-weight: 600;
                    color: Theme.ink2;
                }
            }

            if root.battery >= 0: HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    y: (26px - 16px) / 2;
                    width: 16px;
                    height: 16px;
                    Glyph {
                        size: Theme.u(Theme.bar-icon);
                        data: root.charging ? Icons.battery-charging : Icons.battery;
                    }
                    // The real level inside the outline.
                    if !root.charging: Rectangle {
                        x: 2.8px;
                        y: 6.2px;
                        height: 3.6px;
                        width: max(1px, 9px * root.battery / 100);
                        border-radius: 1px;
                        background: root.battery <= 15 ? Theme.accent : Theme.ink;
                    }
                }
                Text {
                    vertical-alignment: center;
                    text: root.battery + "%";
                    font-weight: 600;
                    color: Theme.ink2;
                }
            }
        }

        // Clock → calendar
        if m.id == "clock": BarButton {
            y: (root.height - self.height) / 2;
            gap: 10px;
            pad: 12px;
            open: root.open-panel == "calendar";
            activated(x) => { root.toggle-panel("calendar", x); }
            Text {
                vertical-alignment: center;
                text: root.time;
                font-size: Theme.fs(Theme.u(Theme.bar-clock) / 1px);
                font-weight: 600;
                color: Theme.ink;
            }
            Text {
                vertical-alignment: center;
                text: root.date;
                color: Theme.ink2;
            }
        }

        // Power menu
        if m.id == "power": BarButton {
            y: (root.height - self.height) / 2;
            pad: 5px;
            open: root.open-panel == "power";
            accent-when-open: true;
            activated(x) => { root.toggle-panel("power", x); }
            Glyph {
                y: (26px - self.height) / 2;
                data: Icons.power;
                size: Theme.u(Theme.bar-icon);
                monochrome: (root.open-panel == "power");
                ink: root.open-panel == "power" ? Theme.ink-on-accent : Theme.ink;
            }
        }
        // A plugin's module (plugins.rs): an icon and a short text, from a script.
        if m.kind == "plugin": BarButton {
            y: (root.height - self.height) / 2;
            gap: 6px;
            activated(x) => { root.plugin-click(m.id, x); }
            secondary => { root.plugin-secondary(m.id); }
            scrolled(d) => { root.plugin-scroll(m.id, d); }
            if m.has-icon: Glyph { y: (26px - self.height) / 2; data: m.icon; size: Theme.u(Theme.bar-icon); accent: m.tint == 4 ? Theme.accent : Theme.ink; }
            if m.text != "": Text {
                vertical-alignment: center;
                text: m.text;
                font-weight: 600;
                color: m.tint == 3 ? #ff5c57 : m.tint == 2 ? #f0b429 : m.tint == 1 ? #4cc38a : m.tint == 4 ? Theme.accent : Theme.ink;
            }
        }
    }

}

export component Bar inherits Window {
    in property <[Workspace]> workspaces;
    in property <string> app-class;
    in property <bool> has-client;
    in property <string> window-title;
    // The focused app's own menus (File, Edit…), when it publishes them, and
    // the one whose menu is open.
    in property <[AppTop]> app-menus;
    // Editing the layout where it is: the modules on the bar get an outline you
    // drag; the shell (barmods.rs) says where each is and where a drop goes.
    in property <bool> editing;
    in property <[EditSlot]> edit-slots;
    in property <length> edit-hint: -1px;
    in property <bool> edit-removing;
    in property <bool> edit-ghost-on;
    in property <length> edit-ghost-x;
    in property <length> edit-ghost-w;
    in property <string> edit-ghost-label;
    callback bar-menu(length);
    // 0 pressed, 1 moved, 2 released: where, in the bar.
    callback edit-pointer(int, length, length);
    // A module's width, as laid out (so the shell knows where each sits).
    callback module-width(string, length);
    // The modules of each side in order (barmods.rs), and a plugin's clicks.
    in property <[BarModule]> left-modules;
    in property <[BarModule]> right-modules;
    callback plugin-click(string, length);
    callback plugin-secondary(string);
    callback plugin-scroll(string, int);
    // -1 is the app's own menu (from its name); -100 none.
    in property <int> app-menu-open: -100;
    callback app-menu(int, string, length);
    // The app's own menu, from its name (Hide, Quit, Settings…).
    callback app-name-menu(length);
    in property <MediaInfo> media;
    in property <int> eq-tick;
    in property <string> time;
    in property <string> date;
    in property <string> net-label;
    in property <string> net-icon: "wifi";
    in property <string> volume-label;
    in property <string> volume-icon: "volume";
    in property <int> battery: -1;
    in property <bool> charging;
    in property <int> notifications;
    in property <bool> quiet;
    // Which panel is open from this bar ("" for none), for the tint.
    in property <string> open-panel;
    // The tray.
    in property <[TrayItem]> tray;
    in property <bool> show-tray: true;
    in property <bool> tray-open;
    // Indicators that come and go.
    in property <bool> mic-in-use;
    in property <bool> camera-in-use;
    in property <bool> screen-shared;
    in property <bool> has-timer;
    in property <string> timer-text;
    in property <bool> timer-running;
    in property <bool> timer-pomodoro;
    in property <int> updates;
    in property <bool> show-updates;
    in property <int> mail-unread: -1;
    in property <bool> has-drives;

    // Right-click on the bar itself: its settings.
    callback settings();
    callback workspace-go(int);
    callback workspace-step(int);
    callback volume-step(int);
    callback media-prev();
    callback media-toggle();
    callback media-next();
    callback media-seek(float);
    // A panel to open under x (or close, if it is the one open).
    callback toggle-panel(string, length);
    callback toggle-dnd();
    callback open-mail();
    callback tray-toggle();
    callback tray-activate(string, length);
    callback tray-secondary(string);
    callback tray-menu(string, length);
    callback tray-scroll(string, int);

    // Auto-hide (Bar.qml): everything slides up inside the surface, which
    // stays put; -height and a little more is away.
    in property <length> slide;

    background: transparent;
    default-font-family: Theme.font;
    default-font-weight: 500;
    default-font-size: Theme.bar-fs();

    property <length> left-end: left.x + left.preferred-width;
    property <length> middle-room: max(0px, (media-pill.visible ? media-pill.x : right.x) - root.left-end - 22px);

    strip := Rectangle {
    y: root.slide;
    width: root.width;
    height: root.height;
    visible: root.slide > -root.height;

    // ── surface ──────────────────────────────────────────────────────────
    Rectangle {
        background: Theme.panel;
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.edge;
        }
        // The bar's own right-click (what is on it answers its own): Settings, on the bar's page.
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) { root.bar-menu(self.mouse-x); }
            }
        }
    }

    // ══ left cluster ═════════════════════════════════════════════════════
    left := HorizontalLayout {
        x: 10px;
        width: self.preferred-width;
        spacing: 10px;
        alignment: start;
        // Each module in the order the bar's layout gives (barmods.rs).
        for m in root.left-modules: HorizontalLayout {
            spacing: 10px;
            changed width => { root.module-width(m.id, self.width); }
            if m.id == "workspaces": HorizontalLayout {
                spacing: 10px;
            Workspaces {
                y: (root.height - self.height) / 2;
                slots: root.workspaces;
                go(id) => { root.workspace-go(id); }
                step(d) => { root.workspace-step(d); }
            }

            // Divider
            Rectangle {
                width: 15px;
                Rectangle {
                    x: 7px;
                    y: (root.height - 18px) / 2;
                    width: 1px;
                    height: 18px;
                    background: Theme.div;
                }
            }
            }
            if m.id == "app": HorizontalLayout {
            // The focused app, with the accent underline.
            Rectangle {
                y: (root.height - 26px) / 2;
                height: 26px;
                width: app-name.preferred-width + 20px;
                border-radius: Theme.r-sm;
                background: root.app-menu-open == -1 ? Theme.sel : app-touch.has-hover && root.has-client ? Theme.hover : transparent;
                app-touch := TouchArea {
                    enabled: root.has-client;
                    mouse-cursor: pointer;
                    clicked => { root.app-name-menu(parent.absolute-position.x + parent.width / 2); }
                }
                app-name := Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2 - 1px;
                    text: root.app-class != "" ? root.app-class : "Desktop";
                    font-size: Theme.fs(Theme.u(Theme.bar-app) / 1px);
                    font-weight: 700;
                    letter-spacing: 0.16px;
                    color: Theme.ink;
                }
                if root.has-client: Rectangle {
                    x: 10px;
                    width: parent.width - 20px;
                    y: parent.height - 3px - 2px;
                    height: 2px;
                    border-radius: 1px;
                    background: Theme.accent;
                }
            }
            }
            if m.id == "window": HorizontalLayout {
            // "Window": the window actions menu (WindowMenuButton.qml).
            Rectangle {
                y: (root.height - 26px) / 2;
                height: 26px;
                width: menu-label.preferred-width + 20px;
                opacity: root.has-client ? 1 : 0.45;
                border-radius: Theme.r-sm;
                background: root.open-panel == "window" ? Theme.sel : menu-touch.has-hover && root.has-client ? Theme.hover : transparent;
                menu-label := Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: "Window";
                    font-size: Theme.fs(Theme.bar-menu);
                    color: Theme.ink;
                }
                menu-touch := TouchArea {
                    enabled: root.has-client;
                    mouse-cursor: pointer;
                    clicked => { root.toggle-panel("window", parent.absolute-position.x + parent.width / 2); }
                }
            }
            }
            if m.id == "appmenus": HorizontalLayout {
                spacing: 10px;
            // The app's own menus, as a Mac's menu bar has them.
            for t in root.app-menus: Rectangle {
                y: (root.height - 26px) / 2;
                height: 26px;
                width: top-label.preferred-width + 20px;
                border-radius: Theme.r-sm;
                opacity: t.enabled ? 1 : 0.45;
                background: root.app-menu-open == t.id ? Theme.sel : top-touch.has-hover && t.enabled ? Theme.hover : transparent;
                top-label := Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: t.label;
                    font-size: Theme.fs(Theme.bar-menu);
                    color: Theme.ink;
                }
                top-touch := TouchArea {
                    enabled: t.enabled;
                    mouse-cursor: pointer;
                    clicked => { root.app-menu(t.id, t.label, parent.absolute-position.x + parent.width / 2); }
                }
            }
            }
            // A plugin's module (plugins.rs).
            if m.kind == "plugin": BarButton {
                y: (root.height - self.height) / 2;
                gap: 6px;
                activated(x) => { root.plugin-click(m.id, x); }
                secondary => { root.plugin-secondary(m.id); }
                scrolled(d) => { root.plugin-scroll(m.id, d); }
                if m.has-icon: Glyph { y: (26px - self.height) / 2; data: m.icon; size: Theme.u(Theme.bar-icon); accent: m.tint == 4 ? Theme.accent : Theme.ink; }
                if m.text != "": Text {
                    vertical-alignment: center;
                    text: m.text;
                    font-weight: 600;
                    color: m.tint == 3 ? #ff5c57 : m.tint == 2 ? #f0b429 : m.tint == 1 ? #4cc38a : m.tint == 4 ? Theme.accent : Theme.ink;
                }
            }
        }
    }

    // ══ the middle ═══════════════════════════════════════════════════════

    if root.window-title != "": Text {
        x: root.left-end + 10px;
        y: (root.height - self.height) / 2;
        width: min(self.preferred-width, root.middle-room);
        text: root.window-title;
        overflow: elide;
        font-size: Theme.fs(Theme.u(Theme.bar-title) / 1px);
        font-weight: 400;
        color: Theme.ink3;
    }

    // ══ what is playing ══════════════════════════════════════════════════
    media-pill := MediaPill {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        media: root.media;
        eq-tick: root.eq-tick;
        room: root.width - 2 * max(root.left-end, right.preferred-width + 10px) - 16px;
        prev => { root.media-prev(); }
        toggle => { root.media-toggle(); }
        next => { root.media-next(); }
        seek(f) => { root.media-seek(f); }
        open: root.open-panel == "media";
        opened(x) => { root.toggle-panel("media", x); }
    }

    // ══ right cluster ════════════════════════════════════════════════════
    right := BarRight {
        x: root.width - self.preferred-width - 10px;
        width: self.preferred-width;
        height: root.height;
        time: root.time; date: root.date; net-label: root.net-label; net-icon: root.net-icon;
        volume-label: root.volume-label; volume-icon: root.volume-icon; battery: root.battery; charging: root.charging;
        notifications: root.notifications; quiet: root.quiet; open-panel: root.open-panel; tray: root.tray;
        show-tray: root.show-tray; tray-open: root.tray-open; mic-in-use: root.mic-in-use; camera-in-use: root.camera-in-use;
        screen-shared: root.screen-shared; has-timer: root.has-timer; timer-text: root.timer-text; timer-running: root.timer-running;
        timer-pomodoro: root.timer-pomodoro; updates: root.updates; show-updates: root.show-updates; mail-unread: root.mail-unread;
        has-drives: root.has-drives;
        modules: root.right-modules;
        plugin-click(id, x) => { root.plugin-click(id, x); }
        plugin-secondary(id) => { root.plugin-secondary(id); }
        plugin-scroll(id, d) => { root.plugin-scroll(id, d); }
        module-width(id, w) => { root.module-width(id, w); }
        volume-step(d) => { root.volume-step(d); }
        toggle-panel(n, x) => { root.toggle-panel(n, x); }
        toggle-dnd => { root.toggle-dnd(); }
        open-mail => { root.open-mail(); }
        tray-toggle => { root.tray-toggle(); }
        tray-activate(k, x) => { root.tray-activate(k, x); }
        tray-secondary(k) => { root.tray-secondary(k); }
        tray-menu(k, x) => { root.tray-menu(k, x); }
        tray-scroll(k, d) => { root.tray-scroll(k, d); }
    }

    // ══ editing the layout ═══════════════════════════════════════════════
    // Over the real bar, which stays as it is: an outline on each module,
    // dragged where it should go; a line where it would land. Everything here
    // eases in and out, and the dragged outline follows the pointer itself (it
    // doesn't wait for the shell to answer).
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        visible: self.opacity > 0.01;
        opacity: root.editing ? 1 : 0;
        animate opacity { duration: 200ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        property <length> gx;
        TouchArea {
            enabled: root.editing;
            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
            pointer-event(e) => {
                if e.button == PointerEventButton.left {
                    if e.kind == PointerEventKind.down { parent.gx = self.mouse-x; root.edit-pointer(0, self.mouse-x, self.mouse-y); }
                    if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel { root.edit-pointer(2, self.mouse-x, self.mouse-y); }
                }
            }
            moved => { if self.pressed { parent.gx = self.mouse-x; root.edit-pointer(1, self.mouse-x, self.mouse-y); } }
        }
        for sl in root.edit-slots: Rectangle {
            x: sl.x;
            y: root.editing ? 2px : 6px;
            width: sl.w;
            height: root.editing ? root.height - 4px : root.height - 12px;
            // The outline glides to where its module is now, and settles in as editing starts.
            animate x { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
            animate width { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
            animate y { duration: 240ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
            animate height { duration: 240ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
            border-radius: Theme.r-cap;
            border-width: 1.5px;
            border-color: Theme.accent;
            background: Theme.accent.transparentize(0.88);
            opacity: sl.dragging ? 0.3 : 1;
            animate opacity { duration: 140ms; }
            // × takes it off the bar (the shell reads a press here).
            Rectangle {
                x: -5px;
                y: -2px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.div;
                Rectangle { x: 4px; y: 7px; width: 8px; height: 2px; border-radius: 1px; background: Theme.ink; }
            }
        }
        // Where a drop would land: a line that slides between the places.
        Rectangle {
            x: root.edit-hint - 1.5px;
            y: 1px;
            width: 3px;
            height: root.height - 2px;
            border-radius: 1.5px;
            background: root.edit-removing ? #d64545 : Theme.accent;
            opacity: root.edit-hint >= 0px ? 1 : 0;
            animate x { duration: 110ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
            animate opacity { duration: 120ms; }
            animate background { duration: 120ms; }
        }
        // What is being dragged, at the pointer.
        Rectangle {
            x: parent.gx - self.width / 2;
            y: 3px;
            width: max(root.edit-ghost-w, 60px);
            height: root.height - 6px;
            border-radius: Theme.r-cap;
            background: root.edit-removing ? #d64545 : Theme.accent;
            opacity: root.edit-ghost-on ? 0.9 : 0;
            visible: self.opacity > 0.01;
            animate opacity { duration: 120ms; }
            animate background { duration: 120ms; }
            Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: root.edit-removing ? "Release to take it off" : root.edit-ghost-label;
                font-size: Theme.fs(11.5);
                font-weight: 600;
                color: Theme.ink-on-accent;
            }
        }
    }
    }
}
