// The dock (modules/dock/Dock.qml, DockTile.qml): a pill at the bottom
// middle of each screen. Start, the pinned apps, the running ones not
// pinned, show desktop; a pip under a tile for each window it has, the
// focused app tinted and named. Hides into the bottom edge when set to,
// or when a window is fullscreen, and comes back on the pointer.
import { Icons, GlyphData } from "icons.slint";
import { Theme } from "theme.slint";
import { Glyph } from "glyph.slint";

export struct DockTileData {
    // start, divider, pin, app, desktop
    kind: string,
    label: string,
    sub: string,
    glyph: GlyphData,
    windows: int,
    active: bool,
    // The accent fill: Start while the launcher is open.
    accent: bool,
    // The focused app's name beside its glyph (dockLabels).
    named: bool,
}

export struct PreviewWin { title: string, thumb: image, has-thumb: bool, current: bool }

// The card over a tile with windows (DockPreview.qml): a picture of each, its title, a close
// button; click to go to one, middle-click to close it.
component PreviewCard inherits Rectangle {
    in property <[PreviewWin]> wins;
    in property <GlyphData> glyph;
    in property <float> us: 1;
    in property <length> max-w;
    callback pick(int);
    callback close(int);
    callback hovered(bool);
    function u(px: float) -> length { return max(1, round(px * root.us)) * 1px; }
    property <length> pad: u(8);
    property <length> gap: u(6);
    property <length> title-h: u(28);
    property <int> n: max(1, root.wins.length);
    property <length> thumb-w: round(max(u(112), min(u(200), (root.max-w - root.pad * 2 - root.gap * (root.n - 1)) / root.n)) / 1px) * 1px;
    property <length> image-h: round(root.thumb-w * 0.6 / 1px) * 1px;
    width: min(root.max-w, root.n * root.thumb-w + (root.n - 1) * root.gap + root.pad * 2);
    height: root.pad * 2 + root.title-h + root.image-h + u(6);
    border-radius: Theme.r-cap;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.edge;
    TouchArea { changed has-hover => { root.hovered(self.has-hover); } }
    for w[i] in root.wins: cell := Rectangle {
        x: root.pad + i * (root.thumb-w + root.gap);
        y: root.pad;
        width: root.thumb-w;
        height: root.title-h + root.image-h + u(6);
        border-radius: Theme.r-sm;
        property <bool> hot: ct.has-hover || xt.has-hover;
        background: self.hot ? Theme.sel : (w.current ? Theme.hover : transparent);
        animate background { duration: 140ms; }
        border-width: w.current ? 1px : 0px;
        border-color: Theme.seam;
        ct := TouchArea {
            mouse-cursor: pointer;
            changed has-hover => { root.hovered(self.has-hover); }
            clicked => { root.pick(i); }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.middle) { root.close(i); }
            }
        }
        HorizontalLayout {
            x: u(7);
            width: parent.width - u(7) - u(20) - u(13);
            height: root.title-h;
            spacing: u(6);
            Glyph { y: (root.title-h - self.height) / 2; data: root.glyph; size: u(15); monochrome: true; ink: w.current ? Theme.ink : Theme.ink2; }
            Text {
                vertical-alignment: center;
                text: w.title;
                overflow: elide;
                font-size: Theme.fs(max(10, u(12) / 1px));
                font-weight: w.current ? 600 : 500;
                color: w.current ? Theme.ink : Theme.ink2;
            }
        }
        Rectangle {
            x: u(5);
            y: root.title-h;
            width: parent.width - u(10);
            height: root.image-h;
            border-radius: Theme.r-sm;
            clip: true;
            background: w.has-thumb ? transparent : Theme.hover;
            if !w.has-thumb: Glyph {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                data: root.glyph;
                size: min(parent.height * 0.42, u(40));
                ink: Theme.ink3;
            }
            if w.has-thumb: Image { width: parent.width; height: parent.height; source: w.thumb; image-fit: contain; }
        }
        // The close button, there while the window's tile is hovered.
        Rectangle {
            visible: cell.hot;
            x: parent.width - self.width - u(5);
            y: round((root.title-h - self.height) / 2 / 1px) * 1px;
            width: u(20);
            height: self.width;
            border-radius: Theme.r-sm;
            background: xt.has-hover ? Theme.accent : transparent;
            Glyph { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; data: Icons.x; size: u(13); monochrome: true; ink: xt.has-hover ? Theme.ink-on-accent : Theme.ink2; }
            xt := TouchArea { mouse-cursor: pointer; clicked => { root.close(i); } }
        }
    }
}

component DockTile inherits Rectangle {
    in property <DockTileData> data;
    in property <length> tile;
    in property <length> icon;
    in property <length> label-size;
    // On the left edge: the name comes out to the right instead of above.
    in property <bool> left;
    callback activated(length);
    callback secondary(length);
    callback middle();
    // The pointer on it or off, and where it is across (for the preview card).
    callback hover(bool, length);
    property <bool> hovered: t.has-hover;
    // The name's width, measured where it isn't drawn.
    measure := Text {
        visible: false;
        width: 0;
        text: root.data.label;
        font-size: Theme.fs(root.label-size / 1px);
        font-weight: 600;
    }
    width: data.named ? round((tile + measure.preferred-width + 21px) / 1px) * 1px : tile;
    animate width { duration: 330ms; easing: cubic-bezier(0.25, 1.3, 0.4, 1); }
    height: tile;
    border-radius: Theme.r-cap;
    background: data.accent ? Theme.accent : data.active ? Theme.sel : t.has-hover ? Theme.hover : transparent;
    animate background { duration: 160ms; }
    border-width: data.active && !data.accent ? 1px : 0px;
    border-color: Theme.seam;

    HorizontalLayout {
        x: (parent.width - self.preferred-width) / 2;
        width: self.preferred-width;
        spacing: 9px;
        Glyph {
            // A little bigger under the pointer, smaller while pressed.
            property <length> s: t.pressed ? root.icon * 0.86 : (root.hovered && !root.data.named ? root.icon * 1.12 : root.icon);
            y: (root.tile - self.height) / 2;
            size: round(self.s / 1px) * 1px;
            animate size { duration: 200ms; easing: cubic-bezier(0.3, 1.4, 0.5, 1); }
            data: root.data.glyph;
            ink: root.data.accent ? Theme.ink-on-accent : Theme.ink;
            accent: root.data.accent ? Theme.ink-on-accent : Theme.accent;
        }
        // Only there while named: a hidden element still takes its room.
        if root.data.named: Text {
            vertical-alignment: center;
            text: root.data.label;
            font-size: Theme.fs(root.label-size / 1px);
            font-weight: 600;
            color: Theme.ink;
        }
    }

    // A pip per window, three at most; the focused app's first is long.
    if root.data.windows > 0: HorizontalLayout {
        x: (parent.width - self.preferred-width) / 2;
        width: self.preferred-width;
        y: parent.height - 3px - 2.5px;
        height: 2.5px;
        spacing: 2px;
        for i in min(root.data.windows, 3): Rectangle {
            width: root.data.active && i == 0 ? 14px : 6px;
            animate width { duration: 260ms; }
            border-radius: 1.25px;
            background: root.data.active ? Theme.accent : Theme.ink3;
        }
    }

    // Its name and how many windows, above it (outside the tile, which
    // doesn't clip), unless its name already shows.
    in property <length> lift: 5px;
    if t.has-hover && !root.data.named: Rectangle {
        x: root.left ? root.width + 12px + root.lift : (root.width - self.width) / 2;
        y: root.left ? (root.height - self.height) / 2 : -self.height - 12px - root.lift;
        height: 30px;
        width: tip.preferred-width + 22px;
        border-radius: Theme.r-sm;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.edge;
        tip := HorizontalLayout {
            x: 11px;
            width: self.preferred-width;
            spacing: 9px;
            Text {
                vertical-alignment: center;
                text: root.data.label;
                font-size: Theme.fs(root.label-size / 1px - 1);
                font-weight: 600;
                color: Theme.ink;
            }
            if root.data.sub != "": Text {
                vertical-alignment: center;
                text: root.data.sub;
                font-size: Theme.fs(root.label-size / 1px - 2);
                color: Theme.ink3;
            }
        }
    }

    t := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => { root.hover(self.has-hover, root.left ? root.absolute-position.y + root.height / 2 : root.absolute-position.x + root.width / 2); }
        clicked => { root.activated(root.left ? root.absolute-position.y + root.height / 2 : root.absolute-position.x + root.width / 2); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                root.secondary(root.left ? root.absolute-position.y + root.height / 2 : root.absolute-position.x + root.width / 2);
            }
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.middle) { root.middle(); }
        }
    }
}

export component Dock inherits Window {
    in property <[DockTileData]> tiles;
    in property <length> tile: 42px;
    in property <length> icon-size: 21px;
    in property <length> pad-h: 7px;
    in property <length> pad-v: 5px;
    in property <length> gap: 3px;
    in property <length> label-size: 12px;
    // On the left edge rather than the bottom.
    in property <bool> left;
    // The launcher is out and on top of this pill (it grew out of it): the glass steps aside
    // at once, the tiles fade, so there is only ever one pane.
    in property <bool> covered;
    // Where the pill's near edge is (the reveal spring, from app.rs): its top at
    // the bottom, its left on the left.
    in property <length> pos;
    out property <length> pill-width: pill.width;
    out property <length> pill-height: pill.height;
    out property <length> pill-x: pill.x;
    out property <length> pill-y: pill.y;
    callback activate(int, length);
    callback secondary(int, length);
    callback middle(int);
    callback hovered(bool);
    callback tile-hover(int, bool, length);
    // The preview card over a tile: its windows, whether it shows, which app's glyph, where
    // its tile is across, the shell's scale.
    in property <[PreviewWin]> preview;
    in property <bool> preview-open;
    in property <GlyphData> preview-glyph;
    in property <length> preview-anchor;
    in property <float> us: 1;
    out property <length> card-x: card.x;
    out property <length> card-y: card.y;
    out property <length> card-w: card.width;
    out property <length> card-h: card.height;
    callback preview-pick(int);
    callback preview-close(int);
    callback preview-hover(bool);

    background: transparent;
    default-font-family: Theme.font;
    default-font-weight: 500;

    // The strip along the bottom edge that brings a hidden dock back.
    TouchArea {
        x: 0;
        y: root.left ? 0 : root.height - 3px;
        width: root.left ? 3px : root.width;
        height: root.left ? root.height : 3px;
        changed has-hover => { root.hovered(self.has-hover); }
    }

    pill := Rectangle {
        x: root.left ? root.pos : round((root.width - self.width) / 2 / 1px) * 1px;
        y: root.left ? round((root.height - self.height) / 2 / 1px) * 1px : root.pos;
        width: root.left ? root.tile + root.pad-h * 2 : row.preferred-width + root.pad-h * 2;
        height: root.left ? col.preferred-height + root.pad-v * 2 : root.tile + root.pad-v * 2;
        border-radius: Theme.r-cap;
        background: root.covered ? transparent : Theme.panel;
        border-width: root.covered ? 0px : 1px;
        border-color: Theme.edge;

        hover := TouchArea {
            changed has-hover => { root.hovered(self.has-hover); }
            row := HorizontalLayout {
                visible: !root.left && self.opacity > 0.01;
                opacity: root.covered ? 0 : 1;
                animate opacity { duration: root.covered ? 140ms : 240ms; }
                x: root.pad-h;
                y: root.pad-v;
                width: self.preferred-width;
                height: root.tile;
                spacing: root.gap;
                for d[i] in root.tiles: Rectangle {
                    width: d.kind == "divider" ? 7px : tile.width;
                    if d.kind == "divider": Rectangle {
                        x: 3px;
                        y: (root.tile - 26px) / 2;
                        width: 1px;
                        height: 26px;
                        background: Theme.div;
                    }
                    tile := DockTile {
                        visible: d.kind != "divider";
                        data: d;
                        tile: root.tile;
                        icon: root.icon-size;
                        label-size: root.label-size;
                        activated(x) => { root.activate(i, x); }
                        secondary(x) => { root.secondary(i, x); }
                        middle => { root.middle(i); }
                        hover(on, x) => { root.tile-hover(i, on, x); }
                        lift: root.pad-v;
                    }
                }
            }
            col := VerticalLayout {
                visible: root.left && self.opacity > 0.01;
                opacity: root.covered ? 0 : 1;
                animate opacity { duration: root.covered ? 140ms : 240ms; }
                x: root.pad-h;
                y: root.pad-v;
                width: root.tile;
                spacing: root.gap;
                for d[i] in root.tiles: Rectangle {
                    height: d.kind == "divider" ? 7px : root.tile;
                    if d.kind == "divider": Rectangle {
                        x: (root.tile - 26px) / 2;
                        y: 3px;
                        width: 26px;
                        height: 1px;
                        background: Theme.div;
                    }
                    if d.kind != "divider": DockTile {
                        left: true;
                        data: d;
                        tile: root.tile;
                        icon: root.icon-size;
                        label-size: root.label-size;
                        activated(y) => { root.activate(i, y); }
                        secondary(y) => { root.secondary(i, y); }
                        middle => { root.middle(i); }
                        hover(on, x) => { root.tile-hover(i, on, x); }
                        lift: root.pad-h;
                    }
                }
            }
        }
    }

    // The preview card, centred over its tile and kept a margin inside the screen.
    card := PreviewCard {
        wins: root.preview;
        glyph: root.preview-glyph;
        us: root.us;
        max-w: root.width - max(1, round(24 * root.us)) * 1px;
        x: round(max(max(1, round(12 * root.us)) * 1px, min(root.width - self.width - max(1, round(12 * root.us)) * 1px, root.preview-anchor - self.width / 2)) / 1px) * 1px;
        y: round((pill.y - self.height - max(1, round(10 * root.us)) * 1px) / 1px) * 1px;
        visible: self.opacity > 0.01;
        opacity: root.preview-open ? 1 : 0;
        animate opacity { duration: root.preview-open ? 200ms : 0ms; }
        pick(i) => { root.preview-pick(i); }
        close(i) => { root.preview-close(i); }
        hovered(on) => { root.preview-hover(on); }
    }
}
