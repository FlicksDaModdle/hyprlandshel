[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse and manage files
Exec=@CMAKE_INSTALL_FULL_BINDIR@/hyprshell-files %U
Icon=system-file-manager
Terminal=false
Categories=Utility;FileTools;FileManager;
MimeType=inode/directory;
StartupNotify=true
StartupWMClass=hyprshell-files
